Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"StripZeros", "=", 
    RowBox[{"FunctionCompile", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"Typed", "[", 
         RowBox[{"list", ",", " ", 
          RowBox[{"\"\<PackedArray\>\"", "::[", 
           RowBox[{"\"\<MachineInteger\>\"", ",", " ", "1"}], "]"}]}], "]"}], 
        ",", 
        RowBox[{"Module", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", " ", 
            RowBox[{"j", "=", 
             RowBox[{"Length", "[", "list", "]"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"list", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "==", "0"}], "&&", 
              RowBox[{"i", "<", "j"}]}], ",", " ", 
             RowBox[{"i", "++"}]}], "]"}], ";", "\[IndentingNewLine]", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "<", "j"}], ",", 
             RowBox[{"While", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"list", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "==", "0"}], ",", " ", 
               RowBox[{"j", "--"}]}], "]"}]}], "]"}], ";", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "==", "j"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{"0", ",", " ", "0"}], "]"}], ",", 
             RowBox[{"list", "[", 
              RowBox[{"[", 
               RowBox[{"i", ";;", "j"}], "]"}], "]"}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "]"}]}], "]"}], ",", " ", 
      RowBox[{"CompilerOptions", "->", 
       RowBox[{"{", 
