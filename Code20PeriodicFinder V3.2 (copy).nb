Cell[BoxData[{
 RowBox[{
  RowBox[{"AnalyzeRule", "[", 
   RowBox[{"{", 
    RowBox[{"n_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"k_", ",", " ", "1"}], "}"}], ",", " ", "r_"}], "}"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"AnalyzeRule", "[", 
    RowBox[{"{", 
     RowBox[{"n", ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "1"}], "}"}], ",", " ", "r"}], "}"}], "]"}], "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rule", "=", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "1"}], "}"}], ",", " ", "r"}], "}"}]}], ",", 
       RowBox[{"minimumtolerablegap", "=", 
        RowBox[{
         RowBox[{"2", "r"}], "+", "1"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Tuples", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Range", "[", "k", "]"}], "-", "1"}], ",", " ", 
            RowBox[{
             RowBox[{"2", "r"}], "+", "2", "-", "minimumtolerablegap"}]}], 
           "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"PointApplyRule", "[", 
             RowBox[{"rule", ",", " ", 
              RowBox[{"PadLeft", "[", 
               RowBox[{"#", ",", " ", 
                RowBox[{
                 RowBox[{"2", "r"}], "+", "1"}]}], "]"}]}], "]"}], "==", 
            "0"}], "&"}]}], "]"}], ",", " ", 
        RowBox[{"minimumtolerablegap", "--"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Rule\>\"", "->", "rule"}], ",", " ", 
        RowBox[{"\"\<Colors\>\"", "->", "k"}], ",", " ", 
        RowBox[{"\"\<Totalistic\>\"", "->", "True"}], ",", " ", 
        RowBox[{"\"\<Radius\>\"", "->", "r"}], ",", " ", 
        RowBox[{"\"\<MinimumTolerableGap\>\"", "->", 
         "minimumtolerablegap"}]}], "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AnalyzeRule", "[", 
   RowBox[{"{", 
    RowBox[{"n_", ",", " ", "k_", ",", " ", "r_"}], "}"}], "]"}], ":=", 
