Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DetectPeriod", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "DetectPeriodSub", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DetectPeriod", "[", 
   RowBox[{"rule_", ",", " ", "n_Integer", ",", " ", "args___"}], "]"}], ":=", 
  RowBox[{"DetectPeriod", "[", 
   RowBox[{"rule", ",", " ", 
    RowBox[{"IntegerDigits", "[", 
     RowBox[{"n", ",", " ", 
      RowBox[{
       RowBox[{"AnalyzeRule", "[", "rule", "]"}], "[", "\"\<Colors\>\"", 
       "]"}]}], "]"}], ",", " ", "args"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DetectPeriod", "[", 
     RowBox[{"rule_", ",", " ", "list_List", ",", " ", 
      RowBox[{"steps_", ":", "200"}], ",", " ", 
      RowBox[{"maxdepth_", ":", "20"}]}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ra", "=", 
        RowBox[{"AnalyzeRule", "[", "rule", "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"res", "=", 
        RowBox[{"DetectPeriodSub", "[", 
         RowBox[{
         "ra", ",", " ", "list", ",", " ", "steps", ",", " ", "maxdepth"}], 
         "]"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Rule\>\"", "->", "rule"}], ",", 
            RowBox[{"\"\<Canonical\>\"", "->", 
             RowBox[{"FromDigits", "[", 
              RowBox[{"list", ",", " ", 
               RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<Original\>\"", "->", 
             RowBox[{"FromDigits", "[", 
              RowBox[{"list", ",", " ", 
               RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<IsGliderGun\>\"", "->", "False"}], ",", " ", 
            RowBox[{"\"\<MaxDepth\>\"", "->", 
             RowBox[{"maxdepth", "-", "#LowestDepth"}]}], ",", " ", 
            RowBox[{"\"\<MaxSteps\>\"", "->", 
             RowBox[{"steps", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "^", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", "maxdepth", "-", "#LowestDepth"}], 
                  ")"}]}], "-", "1"}], ")"}]}]}]}], "|>"}], ",", " ", "#"}], 
         "]"}], "&"}], "/@", "res"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DetectPeriodSub", "[", 
   RowBox[{
   "ra_", ",", " ", "list_", ",", " ", "steps_", ",", " ", "ogmaxdepth_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "carun", ",", " ", "frd", ",", " ", "separatesolutions", ",", " ", 
