Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"ComposeRuleTwice", "[", 
   RowBox[{"n_Integer", ",", "r_Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "neighborhoods", ",", "outputs"}], "}"}], ",", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"CellularAutomaton", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"n", ",", "2", ",", "r"}], "}"}], ",", "#", ",", "1"}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", 
          RowBox[{"r", "+", "1"}]}], "]"}], "]"}], "&"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"neighborhoods", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", "r"}], "+", "1"}], ")"}]}], "-", "1"}]}], 
         "]"}], ",", "2", ",", 
        RowBox[{
         RowBox[{"4", " ", "r"}], "+", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"outputs", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{
        RowBox[{"g", "/@", "neighborhoods"}], "/.", " ", 
        RowBox[{
         RowBox[{"g", "[", "x_", "]"}], ":>", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "mid", "}"}], ",", 
           RowBox[{
            RowBox[{"mid", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"f", "[", 
                RowBox[{"x", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", ";;", 
                   RowBox[{"k", "+", 
                    RowBox[{"2", " ", "r"}]}]}], "]"}], "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "1", ",", 
                 RowBox[{
                  RowBox[{"2", " ", "r"}], "+", "1"}]}], "}"}]}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"f", "[", "mid", "]"}]}]}], "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FromDigits", "[", 
      RowBox[{"outputs", ",", "2"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.991322377271634*^9, 3.991322377271694*^9}},
 CellLabel->
  "In[246]:=",ExpressionUUID->"fb087abc-033e-438a-bb23-eed2ad450a16"],

