Cell[BoxData[
 RowBox[{
  RowBox[{"AdditiveRuleQ", "[", 
   RowBox[{"n_Integer", ",", "r_Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k", ",", "vars", ",", "table", ",", "anf"}], "}"}], ",", 
    RowBox[{
     RowBox[{"k", "=", 
      RowBox[{
       RowBox[{"2", " ", "r"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"Array", "[", 
       RowBox[{"x", ",", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"table", "=", 
      RowBox[{"Reverse", "@", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{"n", ",", "2", ",", 
         RowBox[{"2", "^", "k"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"anf", "=", 
      RowBox[{"BooleanConvert", "[", 
       RowBox[{
        RowBox[{"BooleanFunction", "[", 
         RowBox[{"table", ",", "vars"}], "]"}], ",", "\"\<ANF\>\""}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"FreeQ", "[", 
       RowBox[{"anf", ",", 
        RowBox[{"_And", "?", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"BooleanVariables", "[", "#", "]"}], "]"}], ">", "1"}], 
           "&"}], ")"}]}]}], "]"}], "&&", 
      RowBox[{"!", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"anf", "/.", " ", 
         RowBox[{"Thread", "[", 
          RowBox[{"vars", "->", "0"}], "]"}]}], "]"}]}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.991322003414102*^9, 3.9913220184181433`*^9}, 
   3.9913221792099*^9, {3.991322235921932*^9, 3.9913222441128683`*^9}, {
