 RowBox[{
  RowBox[{"BitCount", "[", "n_", "]"}], ":=", 
  RowBox[{"Total", "[", 
   RowBox[{"IntegerDigits", "[", 
    RowBox[{"n", ",", " ", "2"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.991322154036284*^9, 3.991322163034522*^9}},
