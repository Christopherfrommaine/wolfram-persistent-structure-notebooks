Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CAClass3Or4", "[", 
    RowBox[{"rule_Integer", ",", " ", "r_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", "100"}], ",", " ", "res"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"res", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"CellularAutomaton", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rule", ",", " ", "2", ",", " ", "r"}], "}"}], ",", " ", 
            
            RowBox[{"{", 
             RowBox[{
              RowBox[{"RandomInteger", "[", 
               RowBox[{"1", ",", " ", "100"}], "]"}], ",", " ", "0"}], "}"}], 
            ",", " ", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"{", "100", "}"}], "}"}], "}"}]}], "]"}], "]"}], ",", 
         " ", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Unitize", "[", "res", "]"}], "]"}], "<", 
         RowBox[{"0.2", "n"}]}], ",", " ", "4", ",", " ", "3"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CAClassSingle", "[", 
    RowBox[{"rule_Integer", ",", " ", "r_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"res", ",", " ", "bcall", ",", " ", "bclast"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"res", "=", 
       RowBox[{"CellularAutomaton", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rule", ",", " ", "2", ",", " ", "r"}], "}"}], ",", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"1", ",", " ", "100"}], "]"}], ",", " ", "100"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"bcall", "=", 
       RowBox[{"ByteCount", "[", 
        RowBox[{"Compress", "[", "res", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bclast", "=", 
       RowBox[{"ByteCount", "[", 
        RowBox[{"Compress", "[", 
         RowBox[{"Last", "[", "res", "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"Union", "[", 
           RowBox[{"Last", "[", "res", "]"}], "]"}], "]"}], "==", "1"}], ",", 
        " ", "1", ",", " ", 
        RowBox[{
         RowBox[{"bclast", "<", "100"}], " ", "||", " ", 
         RowBox[{"bcall", "<", "1000"}]}], ",", " ", "2", ",", " ", "True", ",",
         " ", 
        RowBox[{"CAClass3Or4", "[", 
         RowBox[{"rule", ",", " ", "r"}], "]"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CAClass", "[", 
   RowBox[{"rule_Integer", ",", " ", "r_Integer"}], "]"}], ":=", 
  RowBox[{"First", "[", 
   RowBox[{"Commonest", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"CAClassSingle", "[", 
       RowBox[{"rule", ",", " ", "r"}], "]"}], ",", " ", "10"}], "]"}], "]"}],
    "]"}]}]}], "Input",
