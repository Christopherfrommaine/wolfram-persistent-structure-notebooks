Cell[BoxData[
 RowBox[{
  RowBox[{"StripZeros", "=", 
   RowBox[{"FunctionCompile", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"Typed", "[", 
        RowBox[{"list", ",", " ", 
         RowBox[{"\"\<PackedArray\>\"", "::[", 
          RowBox[{"\"\<MachineInteger\>\"", ",", " ", "1"}], "]"}]}], "]"}], ",", 
       RowBox[{"Module", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"i", "=", "1"}], ",", " ", 
           RowBox[{"j", "=", 
            RowBox[{"Length", "[", "list", "]"}]}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", "AllZeros", " ", "*)"}], "\[IndentingNewLine]", 
           
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i0", "=", 
                RowBox[{"Length", "[", "list", "]"}]}], "}"}], ",", " ", 
              RowBox[{
               RowBox[{"While", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"i0", ">", "0"}], "&&", 
                  RowBox[{
                   RowBox[{"list", "[", 
                    RowBox[{"[", "i0", "]"}], "]"}], "==", "0"}]}], ",", " ", 
                 
                 RowBox[{
                  RowBox[{"i0", "--"}], ";"}]}], "]"}], ";", " ", 
               RowBox[{"i0", "==", "0"}]}]}], "]"}], ",", 
            "\[IndentingNewLine]", " ", 
            RowBox[{"Return", "[", 
             RowBox[{"Table", "[", 
              RowBox[{"0", ",", " ", 
               RowBox[{"{", 
                RowBox[{"iter", ",", " ", "0"}], "}"}]}], "]"}], "]"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"list", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "==", "0"}], ",", " ", 
            RowBox[{"i", "++"}]}], "]"}], ";", "\[IndentingNewLine]", " ", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"list", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "==", "0"}], ",", " ", 
            RowBox[{"j", "--"}]}], "]"}], ";", " ", "\[IndentingNewLine]", 
          RowBox[{"list", "[", 
           RowBox[{"[", 
            RowBox[{"i", ";;", "j"}], "]"}], "]"}]}]}], "\[IndentingNewLine]",
         "]"}]}], "]"}], ",", " ", 
     RowBox[{"CompilerOptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<LLVMOptimization\>\"", "->", 
         RowBox[{"\"\<ClangOptimization\>\"", "[", "3", "]"}]}], ",", " ", 
        RowBox[{"\"\<AbortHandling\>\"", "->", "False"}], ",", " ", 
        RowBox[{"\"\<OptimizationLevel\>\"", "->", "3"}], ",", 
        RowBox[{"\"\<InvocationMode\>\"", "->", "\"\<Standalone\>\""}]}], 
       "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9893163955759897`*^9, 3.989316491357252*^9}, 
   3.98931654146574*^9, {3.989316607384946*^9, 3.989316608624855*^9}, {
