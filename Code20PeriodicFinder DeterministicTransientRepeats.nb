Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"StripZeros", "=", 
    RowBox[{"FunctionCompile", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"Typed", "[", 
         RowBox[{"list", ",", " ", 
          RowBox[{"\"\<PackedArray\>\"", "::[", 
           RowBox[{"\"\<MachineInteger\>\"", ",", " ", "1"}], "]"}]}], "]"}], 
        ",", 
        RowBox[{"Module", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", " ", 
            RowBox[{"j", "=", 
             RowBox[{"Length", "[", "list", "]"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Max", "[", "list", "]"}], "==", "0"}], ",", " ", 
             RowBox[{"Return", "[", 
              RowBox[{"Table", "[", 
               RowBox[{"0", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"iter", ",", " ", "0"}], "}"}]}], "]"}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"list", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "==", "0"}], ",", " ", 
             RowBox[{"i", "++"}]}], "]"}], ";", "\[IndentingNewLine]", " ", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"list", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "==", "0"}], ",", " ", 
             RowBox[{"j", "--"}]}], "]"}], ";", " ", "\[IndentingNewLine]", 
           RowBox[{"list", "[", 
            RowBox[{"[", 
             RowBox[{"i", ";;", "j"}], "]"}], "]"}]}]}], 
         "\[IndentingNewLine]", "]"}]}], "]"}], ",", " ", 
      RowBox[{"CompilerOptions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<LLVMOptimization\>\"", "->", 
          RowBox[{"\"\<ClangOptimization\>\"", "[", "3", "]"}]}], ",", " ", 
         RowBox[{"\"\<AbortHandling\>\"", "->", "False"}], ",", " ", 
         RowBox[{"\"\<OptimizationLevel\>\"", "->", "3"}], ",", 
         RowBox[{"\"\<InvocationMode\>\"", "->", "\"\<Standalone\>\""}]}], 
        "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RepeatedTiming", "[", 
   RowBox[{"StripZeros", "[", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "100"}], "]"}], "]"}], 
   "]"}], "//", "First"}], "\[IndentingNewLine]", 
 RowBox[{"StripZeros", "[", 
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",", "0"}], 
   "}"}], "]"}]}], "Input",
