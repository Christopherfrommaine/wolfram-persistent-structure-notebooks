          RowBox[{"list", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", 
          RowBox[{"{", "0", "}"}]}], "]"}], "]"}]}], ";;"}], "]"}], "]"}]}], 
