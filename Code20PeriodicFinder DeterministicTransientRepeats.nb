 RowBox[{
  RowBox[{
   RowBox[{"FindRepeatDeterministic", "[", "list_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"list", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"First", "[", 
