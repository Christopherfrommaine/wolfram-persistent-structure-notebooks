Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"StripZeros", "=", 
    RowBox[{"FunctionCompile", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"Typed", "[", 
         RowBox[{"list", ",", " ", 
          RowBox[{"\"\<PackedArray\>\"", "::[", 
           RowBox[{"\"\<MachineInteger\>\"", ",", " ", "1"}], "]"}]}], "]"}], 
        ",", 
        RowBox[{"Module", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", " ", 
            RowBox[{"j", "=", 
             RowBox[{"Length", "[", "list", "]"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", "\[IndentingNewLine]", 
            RowBox[{"(*", " ", "AllZeros", " ", "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"i0", "=", 
                 RowBox[{"Length", "[", "list", "]"}]}], "}"}], ",", " ", 
