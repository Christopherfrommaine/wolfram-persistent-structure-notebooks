Cell[CellGroupData[{

Cell["Large Solution Search:", "Subsubsection",
 CellChangeTimes->{{3.989328140445866*^9, 
  3.989328147434326*^9}},ExpressionUUID->"f474fa91-02ed-44ff-b98c-\
403b51e271fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Find", " ", "all", " ", "solutions", " ", "with", " ", "periods", " ", 
    "that", " ", 
    RowBox[{"aren", "'"}], "t", " ", "easy", " ", "to", " ", "find"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"numtosearch", "=", "100000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"initwidth", "=", "500"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"easysolutionperiods", "=", 
     RowBox[{"{", 
      RowBox[{
      "0", ",", " ", "1", ",", " ", "2", ",", " ", "4", ",", " ", "9", ",", 
       " ", "22", ",", " ", "38"}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"include", " ", "9", " ", "and", " ", "22"}], ",", " ", 
     RowBox[{
     "then", " ", "4", " ", "and", " ", "38", " ", "for", " ", "longer", " ", 
      "searches"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"easysolutionperiods", "=", 
     RowBox[{"Dispatch", "[", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "->", "True"}], "&"}], "/@", "easysolutionperiods"}], ",",
         " ", 
        RowBox[{"_", "->", "False"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"found", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"DetectPeriod", "[", "#", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "\"\<Period\>\""}], "]"}], "]"}], ",",
              " ", 
             RowBox[{"elem", "|->", 
              RowBox[{"elem", "/.", "easysolutionperiods"}]}]}], "]"}], ",", 
           "Nothing", ",", "#"}], "]"}], "&"}], "[", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "initwidth"}], 
         "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "numtosearch"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{"ArrayPlot", "[", 
        RowBox[{"RunCode20", "[", 
         RowBox[{"sol", ",", " ", "200"}], "]"}], "]"}], ",", " ", 
       RowBox[{"ClickToCopy", "[", 
        RowBox[{
         RowBox[{"Values", "@", 
          RowBox[{"DetectPeriod", "[", "sol", "]"}]}], ",", " ", "sol"}], 
        "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"sol", ",", " ", 
       RowBox[{"found", "[", 
        RowBox[{"[", 
         RowBox[{";;", 
          RowBox[{"UpTo", "[", "25", "]"}]}], "]"}], "]"}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.989322090768921*^9, 3.9893222669809017`*^9}, {
   3.9893223045699472`*^9, 3.9893223561832733`*^9}, {3.9893224158992643`*^9, 
   3.989322554604259*^9}, {3.989322639362658*^9, 3.989322642842307*^9}, {
   3.989322714540052*^9, 3.9893227160705843`*^9}, {3.989323252275297*^9, 
   3.989323362510886*^9}, {3.989323419242432*^9, 3.989323453896641*^9}, {
   3.989323561206406*^9, 3.989323680479265*^9}, {3.989324242224462*^9, 
   3.989324268426196*^9}, {3.98932436371282*^9, 3.989324381847447*^9}, {
   3.9893258641787786`*^9, 3.9893258785265636`*^9}, {3.989325944250449*^9, 
   3.989325960178616*^9}, {3.9893261222225513`*^9, 3.989326126464662*^9}, {
   3.989326173898294*^9, 3.989326331846246*^9}, {3.98932694043052*^9, 
   3.989326946221637*^9}, {3.989327202809483*^9, 3.989327207935835*^9}, {
   3.989327404025803*^9, 3.989327415825041*^9}, {3.989327453170083*^9, 
   3.989327547670916*^9}, {3.9893279271016893`*^9, 3.989328054699819*^9}, {
