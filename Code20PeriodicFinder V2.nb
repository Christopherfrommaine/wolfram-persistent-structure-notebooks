6d641fca9595"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"found", "=", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Join", "@@", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"DetectPeriod", "[", 
          RowBox[{"IntegerDigits", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"2", "i"}], "+", "1"}], ",", " ", "2"}], "]"}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1000000"}], "}"}]}], "]"}]}], ")"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "\"\<Canonical\>\""}], "]"}], "]"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Labeled", "[", 
    RowBox[{
     RowBox[{"ArrayPlot", "[", 
      RowBox[{"RunCode20", "[", 
       RowBox[{"sol", ",", " ", "200"}], "]"}], "]"}], ",", " ", 
     RowBox[{"ClickToCopy", "[", 
      RowBox[{
       RowBox[{"Values", "@", 
        RowBox[{"DetectPeriod", "[", "sol", "]"}]}], ",", " ", "sol"}], 
      "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"sol", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"IntegerDigits", "[", 
        RowBox[{"#", ",", " ", "2"}], "]"}], "&"}], "/@", 
      RowBox[{"found", "[", 
       RowBox[{"[", 
        RowBox[{";;", 
         RowBox[{"UpTo", "[", "25", "]"}]}], "]"}], "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
