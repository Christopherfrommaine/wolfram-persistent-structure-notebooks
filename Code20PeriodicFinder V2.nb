                    RowBox[{"list", "[", 
                    RowBox[{"[", "i0", "]"}], "]"}], "==", "0"}]}], ",", " ", 
                  
                  RowBox[{
                   RowBox[{"i0", "--"}], ";"}]}], "]"}], ";", " ", 
                RowBox[{"i0", "==", "0"}]}]}], "]"}], ",", 
             "\[IndentingNewLine]", " ", 
             RowBox[{"Return", "[", 
              RowBox[{"Table", "[", 
               RowBox[{"0", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"iter", ",", " ", "0"}], "}"}]}], "]"}], "]"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"list", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "==", "0"}], ",", " ", 
             RowBox[{"i", "++"}]}], "]"}], ";", "\[IndentingNewLine]", " ", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"list", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "==", "0"}], ",", " ", 
             RowBox[{"j", "--"}]}], "]"}], ";", " ", "\[IndentingNewLine]", 
