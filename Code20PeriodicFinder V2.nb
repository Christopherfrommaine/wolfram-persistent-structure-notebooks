Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Find", " ", "all", " ", "solutions", " ", "with", " ", "periods", " ", 
    "that", " ", 
    RowBox[{"aren", "'"}], "t", " ", "easy", " ", "to", " ", "find"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"numtosearch", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"initwidth", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"easysolutionperiods", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"include", " ", "9", " ", "and", " ", "22"}], ",", " ", 
     RowBox[{
     "then", " ", "4", " ", "and", " ", "38", " ", "for", " ", "longer", " ", 
      "searches"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"easysolutionperiods", "=", 
     RowBox[{"Dispatch", "[", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "->", "True"}], "&"}], "/@", "easysolutionperiods"}], ",",
         " ", 
        RowBox[{"_", "->", "False"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"found", "=", 
     RowBox[{
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"DetectPeriod", "[", 
                RowBox[{"#", ",", " ", "50"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "\"\<Period\>\""}], "]"}], "]"}], ",",
               " ", 
              RowBox[{"elem", "|->", 
               RowBox[{"elem", "/.", "easysolutionperiods"}]}]}], "]"}], ",", 
            "Nothing", ",", "#"}], "]"}], "&"}], "[", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "initwidth"}], 
          "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "numtosearch"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{";;", 
        RowBox[{"UpTo", "[", "100", "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{"ArrayPlot", "[", 
        RowBox[{"RunCode20", "[", 
         RowBox[{"sol", ",", " ", "200"}], "]"}], "]"}], ",", " ", 
       RowBox[{"ClickToCopy", "[", 
        RowBox[{
         RowBox[{"Values", "@", 
          RowBox[{"DetectPeriod", "[", "sol", "]"}]}], ",", " ", "sol"}], 
        "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"sol", ",", " ", "found"}], "}"}]}], "]"}]}]}]], "Input",
