   3.98932061464333*^9}, {3.989321743967486*^9, 3.989321821462945*^9}, {
   3.9893219231889887`*^9, 3.989321969888431*^9}, 3.989322167228003*^9, {
   3.9893226634968157`*^9, 3.9893226988601227`*^9}, {3.98932277704346*^9, 
   3.989322801047298*^9}, {3.9893228410513687`*^9, 3.9893228483283*^9}, {
