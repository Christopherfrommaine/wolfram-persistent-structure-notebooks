         RowBox[{"{", 
          RowBox[{"i", "=", 
           RowBox[{"Length", "[", "list", "]"}]}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"i", ">", "0"}], "&&", 
             RowBox[{
              RowBox[{"list", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "==", "0"}]}], ",", " ", 
            RowBox[{
             RowBox[{"i", "--"}], ";"}]}], "]"}], ";", " ", 
          RowBox[{"i", "==", "0"}]}]}], "]"}]}], "]"}], ",", " ", 
