Cell[BoxData[
 RowBox[{
  RowBox[{"InspectCode", "[", 
   RowBox[{"code_", ",", " ", 
    RowBox[{"num_", ":", "1000"}]}], "]"}], ":=", 
  RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PrintTemporary", "[", 
     RowBox[{"\"\<Inspecting \>\"", ",", " ", "code"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"res", "[", "code", "]"}], "=", 
     RowBox[{"DedupSame", "[", 
      RowBox[{"Join", "@@", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"TimeConstrained", "[", 
          RowBox[{
           RowBox[{"DetectPeriod", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"code", ",", " ", 
               RowBox[{"{", 
                RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", "2"}], "}"}], ",",
              " ", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{"3", "^", "100"}], "]"}]}], "]"}], ",", " ", "2", ",", 
           " ", 
           RowBox[{"{", "}"}]}], "]"}], ",", " ", "num"}], "]"}]}], "]"}]}], ";",
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Code \>\"", "<>", 
       RowBox[{"ToString", "[", "code", "]"}], "<>", "\"\<:\>\""}], ",", 
      RowBox[{"AArrayPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"code", ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", "2"}], "}"}], ",", 
        " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"3", "^", "100"}], "]"}]}], "]"}], ",", 
      RowBox[{"Row", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Labeled", "[", 
           RowBox[{
            RowBox[{"AArrayPlot", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"code", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", "2"}], "}"}], 
              ",", " ", "#"}], "]"}], ",", " ", 
            RowBox[{"ClickToCopy", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"{", 
               RowBox[{"code", ",", " ", "#"}], "}"}]}], "]"}]}], "]"}], 
          "&"}], "/@", 
         RowBox[{
          RowBox[{"res", "[", "code", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "\"\<Canonical\>\""}], "]"}], "]"}]}], ",",
         " ", "\"\<   \>\""}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.990615552565699*^9, 3.990615601736312*^9}, 
   3.990615686784563*^9, {3.990615772838847*^9, 3.990615874439094*^9}, {
