Cell[CellGroupData[{

Cell["Inspecting Particular", "Subsubsection",
 CellChangeTimes->{{3.99061554956949*^9, 3.990615549780251*^9}, 
   3.990615686197322*^9, {3.990615911353468*^9, 3.990615913312496*^9}, {
   3.990617215285059*^9, 
   3.9906172290366497`*^9}},ExpressionUUID->"584780f3-90db-4a79-afd6-\
0c9b96216a19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"InspectCode", "[", "code_", "]"}], ":=", 
  RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PrintTemporary", "[", 
     RowBox[{"\"\<Inspecting \>\"", ",", " ", "code"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"res", "[", "code", "]"}], "=", 
     RowBox[{"DedupSame", "[", 
      RowBox[{"Join", "@@", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"TimeConstrained", "[", 
          RowBox[{
           RowBox[{"DetectPeriod", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"code", ",", " ", 
               RowBox[{"{", 
                RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", "1"}], "}"}], ",",
              " ", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{"3", "^", "100"}], "]"}]}], "]"}], ",", " ", "2", ",", 
           " ", 
           RowBox[{"{", "}"}]}], "]"}], ",", " ", "10000"}], "]"}]}], "]"}]}],
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Code \>\"", "<>", 
       RowBox[{"ToString", "[", "code", "]"}], "<>", "\"\<:\>\""}], ",", 
      RowBox[{"AArrayPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"code", ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", "1"}], "}"}], ",", 
        " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"3", "^", "100"}], "]"}]}], "]"}], ",", 
      RowBox[{"Row", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Labeled", "[", 
           RowBox[{
            RowBox[{"AArrayPlot", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"code", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", "1"}], "}"}], 
              ",", " ", "#"}], "]"}], ",", " ", 
            RowBox[{"ClickToCopy", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"{", 
               RowBox[{"code", ",", " ", "#"}], "}"}]}], "]"}]}], "]"}], 
          "&"}], "/@", 
         RowBox[{
          RowBox[{"res", "[", "code", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "\"\<Original\>\""}], "]"}], "]"}]}], ",",
         " ", "\"\<   \>\""}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.990615552565699*^9, 3.990615601736312*^9}, 
   3.990615686784563*^9, {3.990615772838847*^9, 3.990615874439094*^9}, {
   3.9906159419070997`*^9, 3.9906159531547213`*^9}, {3.990615997150196*^9, 
