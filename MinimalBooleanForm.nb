Cell[BoxData[
 RowBox[{
  RowBox[{"Thing", "[", "depth_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"depth", "==", "0"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "[", "1", "]"}], ",", 
      RowBox[{"a", "[", "2", "]"}], ",", " ", 
      RowBox[{"a", "[", "3", "]"}], ",", 
      RowBox[{"a", "[", "4", "]"}], ",", " ", 
      RowBox[{"a", "[", "5", "]"}], ",", " ", "False", ",", " ", "True"}], 
     "}"}], ",", 
    RowBox[{"ParallelMap", "[", 
     RowBox[{"FullSimplify", ",", 
      RowBox[{"Union", "[", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"res", "=", 
           RowBox[{"Thing", "[", 
            RowBox[{"depth", "-", "1"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"res", ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Not", "[", "result", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"result", ",", " ", "res"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Join", "@@", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"And", "[", 
               RowBox[{
                RowBox[{"res", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
                RowBox[{"res", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", 
                RowBox[{"Length", "[", "res", "]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"j", ",", " ", 
                RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}]}], ",", " ", 
           RowBox[{"Join", "@@", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Or", "[", 
               RowBox[{
                RowBox[{"res", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
                RowBox[{"res", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", 
                RowBox[{"Length", "[", "res", "]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"j", ",", " ", 
                RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}]}], ",", " ", 
           RowBox[{"Join", "@@", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Xor", "[", 
               RowBox[{
                RowBox[{"res", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
                RowBox[{"res", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", 
                RowBox[{"Length", "[", "res", "]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"j", ",", " ", 
                RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], "]"}],
        "]"}]}], "]"}]}], "]"}]}]], "Input",
