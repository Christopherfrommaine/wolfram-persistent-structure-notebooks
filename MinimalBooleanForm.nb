Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"#1", "&&", "#2"}], ")"}], "\[Xor]", 
    RowBox[{"(", 
     RowBox[{"#1", "&&", "#3"}], ")"}], "\[Xor]", 
    RowBox[{"(", 
     RowBox[{"#1", "&&", "#4"}], ")"}], "\[Xor]", 
    RowBox[{"(", 
     RowBox[{"#1", "&&", "#5"}], ")"}]}], ")"}], "||", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"!", "#1"}], "&&", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"#3", "&&", "#2"}], ")"}], "\[Xor]", 
      RowBox[{"(", 
       RowBox[{"#4", "&&", "#2"}], ")"}], "\[Xor]", 
      RowBox[{"(", 
       RowBox[{"#4", "&&", "#3"}], ")"}], "\[Xor]", 
      RowBox[{"(", 
       RowBox[{"#4", "&&", "#5"}], ")"}], "\[Xor]", 
      RowBox[{"(", 
       RowBox[{"#5", "&&", "#2"}], ")"}], "\[Xor]", 
      RowBox[{"(", 
       RowBox[{"#5", "&&", "#3"}], ")"}], "\[Xor]", 
