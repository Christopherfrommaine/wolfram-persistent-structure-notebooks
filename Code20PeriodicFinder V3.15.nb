             RowBox[{"carun", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "]"}], "+", "mtg"}]}], 
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mask", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"carunpadded", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"i", ";;", 
             RowBox[{"(", 
              RowBox[{"i", "-", "mtg", "-", "1"}], ")"}]}]}], "]"}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "mtg"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mc", "=", 
       RowBox[{"Last", "[", 
        RowBox[{"MorphologicalComponents", "[", 
         RowBox[{
          RowBox[{"Image", "[", "mask", "]"}], ",", " ", 
          RowBox[{"CornerNeighbors", "->", "False"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"colors", "=", 
       RowBox[{"Union", "[", "mc", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Unitize", "[", 
              RowBox[{"c", "-", 
               RowBox[{"mc", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ";;"}], "]"}], "]"}]}], "]"}]}], ")"}], "*", 
           RowBox[{"carun", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"c", ",", " ", "colors"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"Not", "@*", "AllZeros"}]}], "]"}]}]}], "\[IndentingNewLine]",
     "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"SplitSeparateSolutions", "[", 
