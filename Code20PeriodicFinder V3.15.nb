Cell[BoxData[{
 RowBox[{
  RowBox[{"VisualizeDetectPeriod", "[", 
   RowBox[{"rule_", ",", " ", "init_", ",", " ", 
    RowBox[{"stepsog_", ":", "None"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"results", ",", " ", "steps"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"results", "=", 
      RowBox[{"DetectPeriod", "[", 
       RowBox[{"code1329rule", ",", " ", "init"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"steps", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"stepsog", "===", "None"}], ",", " ", 
        RowBox[{"Min", "[", 
         RowBox[{"1000", ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"results", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "\"\<MaxSteps\>\""}], "]"}], "]"}], 
           "]"}]}], "]"}], ",", " ", "stepsog"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Row", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ClickToCopy", "[", 
         RowBox[{
          RowBox[{"AArrayPlot", "[", 
           RowBox[{
           "code1329rule", ",", " ", "init", ",", " ", "steps", ",", " ", 
            "False"}], "]"}], ",", " ", "results"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Row", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"ClickToCopy", "[", 
            RowBox[{
             RowBox[{"Labeled", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"AArrayPlot", "[", 
                RowBox[{"code1329rule", ",", "#Canonical", ",", " ", 
                 RowBox[{
                  RowBox[{"2", "*", "#Period"}], "/.", 
                  RowBox[{"(", 
                   RowBox[{"0", "->", 
                    RowBox[{"2", "*", "steps"}]}], ")"}]}], ",", " ", 
                 RowBox[{"#Period", "!=", "0"}]}], "]"}], 
               "\[IndentingNewLine]", ",", " ", 
               RowBox[{"#Period", "/.", 
                RowBox[{"(", 
                 RowBox[{"0", "->", "\"\<None\>\""}], ")"}]}]}], "]"}], ",", 
             " ", "#Canonical"}], "]"}], "&"}], "\[IndentingNewLine]", "/@", 
          "results"}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
       "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MultiVisualizeDetectPeriod", "[", 
   RowBox[{"rule_", ",", " ", "inits_", ",", " ", "args___"}], "]"}], ":=", 
  RowBox[{"Column", "[", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"VisualizeDetectPeriod", "[", 
      RowBox[{"rule", ",", " ", "init", ",", " ", "args"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"init", ",", " ", "inits"}], "}"}]}], "]"}], "]"}]}]}], "Input",\

