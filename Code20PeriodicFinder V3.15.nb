Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "SplitSeparateSolutions", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SplitSeparateSolutions", "[", 
    RowBox[{"carun_", ",", " ", "mtg_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mask", ",", " ", "mc", ",", " ", "colors", ",", " ", "carunpadded"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"carunpadded", "=", 
       RowBox[{"PadLeft", "[", 
        RowBox[{"carun", ",", " ", 
