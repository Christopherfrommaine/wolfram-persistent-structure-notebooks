Cell[CellGroupData[{

Cell["Unit Tests", "Section",
 CellChangeTimes->{{3.9898331240170517`*^9, 
  3.989833125433806*^9}},ExpressionUUID->"7b95286a-901d-41ba-9342-\
5144a1fdede5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DetectPeriodTests", "[", 
   RowBox[{"testInputs_", ",", " ", 
    RowBox[{"printPassing_", ":", "True"}]}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "rule", ",", " ", "init", ",", " ", "eval", ",", " ", "err", ",", 
          " ", "d", ",", " ", "timing", ",", " ", "res"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "===", "Null"}], ",", " ", 
           RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"rule", "=", 
          RowBox[{"i", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", " ", 
         RowBox[{"init", "=", 
          RowBox[{"i", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
         RowBox[{"eval", "=", 
          RowBox[{"i", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"timing", "=", 
          RowBox[{"First", "[", 
           RowBox[{"AbsoluteTiming", "[", 
            RowBox[{"err", "=", 
             RowBox[{"Quiet", "@", 
              RowBox[{"Check", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"d", "=", 
                  RowBox[{"DetectPeriod", "[", 
                   RowBox[{"rule", ",", " ", "init"}], "]"}]}], ";", " ", 
                 RowBox[{"res", "=", 
                  RowBox[{"eval", "[", "d", "]"}]}], ";", " ", "False"}], ",",
                 " ", "True"}], "]"}]}]}], "]"}], "]"}]}], ";", " ", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
