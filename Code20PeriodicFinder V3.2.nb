             RowBox[{"rule", ",", " ", 
              RowBox[{"PadLeft", "[", 
               RowBox[{"#", ",", " ", 
                RowBox[{
                 RowBox[{"2", "r"}], "+", "1"}]}], "]"}]}], "]"}], "==", 
            "0"}], "&"}]}], "]"}], ",", " ", 
        RowBox[{"minimumtolerablegap", "--"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Rule\>\"", "->", "rule"}], ",", " ", 
        RowBox[{"\"\<Colors\>\"", "->", "k"}], ",", " ", 
        RowBox[{"\"\<Totalistic\>\"", "->", "True"}], ",", " ", 
