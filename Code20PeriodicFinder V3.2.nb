Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DedupSamePass1", "[", 
    RowBox[{"associations_", ",", " ", 
     RowBox[{"parameter_", ":", "\"\<Canonical\>\""}]}], "]"}], ":=", 
   RowBox[{"Union", "[", 
    RowBox[{"associations", ",", 
     RowBox[{"SameTest", "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", "parameter", "]"}], "==", 
         RowBox[{"#2", "[", "parameter", "]"}]}], "&"}], ")"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DedupSamePass2", "[", 
    RowBox[{"associations_", ",", " ", 
     RowBox[{"steps_Integer", ":", "300"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"found", "=", 
        RowBox[{"CreateDataStructure", "[", "\"\<HashSet\>\"", "]"}]}], ",", 
       " ", 
       RowBox[{"out", "=", 
        RowBox[{"{", "}"}]}], ",", " ", "carun", ",", " ", "ra"}], "}"}], ",",
      " ", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"carun", "=", 
          RowBox[{"RunCA", "[", 
           RowBox[{
            RowBox[{"soln", "[", "\"\<Rule\>\"", "]"}], ",", " ", 
            RowBox[{"soln", "[", "\"\<Canonical\>\"", "]"}], ",", " ", 
            "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"carun", "=", 
          RowBox[{"StripZeros", "/@", "carun"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"carun", "=", 
          RowBox[{"Union", "[", "carun", "]"}]}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"ra", "=", 
          RowBox[{"AnalyzeRule", "[", 
           RowBox[{"soln", "[", "\"\<Rule\>\"", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{"carun", ",", " ", 
             RowBox[{
              RowBox[{"found", "[", 
               RowBox[{"\"\<Insert\>\"", ",", " ", 
                RowBox[{"FromDigits", "[", 
                 RowBox[{
                  RowBox[{"StripZeros", "[", "#", "]"}], ",", " ", 
                  RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}]}], 
               "]"}], "&"}]}], "]"}], ",", " ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"out", ",", " ", "soln"}], "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"soln", ",", " ", "associations"}], "}"}]}], "]"}], ";", " ",
       "out"}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DedupSame", "[", 
   RowBox[{"associations_", ",", " ", 
    RowBox[{"parameter_String", ":", "\"\<Canonical\>\""}], ",", " ", 
    RowBox[{"steps_Integer", ":", "300"}]}], "]"}], ":=", 
  RowBox[{"SortBy", "[", 
   RowBox[{
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{"DedupSamePass2", "[", 
       RowBox[{
        RowBox[{"DedupSamePass1", "[", 
         RowBox[{"associations", ",", " ", "parameter"}], "]"}], ",", " ", 
        "steps"}], "]"}], ",", " ", 
      RowBox[{"#Canonical", "&"}]}], "]"}], ",", " ", 
    RowBox[{"#Period", "&"}]}], "]"}]}]}], "Input",
 InitializationCell->True,
