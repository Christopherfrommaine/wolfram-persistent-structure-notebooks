e5476376f391"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DetectPeriod", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "DetectPeriodSub", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DetectPeriod", "[", 
   RowBox[{"rule_", ",", " ", "n_Integer", ",", " ", "args___"}], "]"}], ":=", 
  RowBox[{"DetectPeriod", "[", 
   RowBox[{"rule", ",", " ", 
    RowBox[{"IntegerDigits", "[", 
     RowBox[{"n", ",", " ", 
      RowBox[{
       RowBox[{"AnalyzeRule", "[", "rule", "]"}], "[", "\"\<Colors\>\"", 
       "]"}]}], "]"}], ",", " ", "args"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DetectPeriod", "[", 
     RowBox[{"rule_", ",", " ", "list_List", ",", " ", 
      RowBox[{"steps_Integer", ":", "200"}], ",", " ", 
      RowBox[{"maxdepth_Integer", ":", "20"}]}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ra", "=", 
        RowBox[{"AnalyzeRule", "[", "rule", "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"res", "=", 
        RowBox[{"DetectPeriodSub", "[", 
         RowBox[{
         "ra", ",", " ", "list", ",", " ", "steps", ",", " ", "maxdepth"}], 
         "]"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Rule\>\"", "->", "rule"}], ",", 
            RowBox[{"\"\<Canonical\>\"", "->", 
             RowBox[{"FromDigits", "[", 
              RowBox[{"list", ",", " ", 
               RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<Original\>\"", "->", 
             RowBox[{"FromDigits", "[", 
              RowBox[{"list", ",", " ", 
               RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<IsGliderGun\>\"", "->", "False"}], ",", " ", 
            RowBox[{"\"\<MaxDepth\>\"", "->", 
             RowBox[{"maxdepth", "-", "#LowestDepth"}]}], ",", " ", 
            RowBox[{"\"\<MaxSteps\>\"", "->", 
             RowBox[{"steps", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "^", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", "maxdepth", "-", "#LowestDepth"}], 
                  ")"}]}], "-", "1"}], ")"}]}]}]}], "|>"}], ",", " ", "#"}], 
         "]"}], "&"}], "/@", "res"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DetectPeriodSub", "[", 
   RowBox[{
   "ra_", ",", " ", "list_", ",", " ", "steps_", ",", " ", "ogmaxdepth_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "carun", ",", " ", "frd", ",", " ", "separatesolutions", ",", " ", 
      "period", ",", " ", "canonical", ",", " ", "shift", ",", " ", 
      "maxdepth"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"maxdepth", "=", "ogmaxdepth"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"Assert", "[", 
            RowBox[{"maxdepth", ">=", "0"}], "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"carun", "=", 
            RowBox[{"RunCA", "[", 
             RowBox[{
              RowBox[{"ra", "[", "\"\<Rule\>\"", "]"}], ",", " ", "list", ",",
               " ", "steps"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"If", " ", "it", " ", "dies"}], ",", " ", "return"}], " ",
            "*)"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"AllZeros", "[", 
             RowBox[{"carun", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "]"}], ",", " ", 
            RowBox[{"Return", "[", 
             RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"Detect", " ", "Periodicity"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"frd", "=", 
           RowBox[{
           "FindRepeatDeterministicByStripZeros", "[", "carun", "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ByteCount", "[", "carun", "]"}], ">", "8000000"}], ",", 
            " ", 
            RowBox[{"maxdepth", "=", 
             RowBox[{"Min", "[", 
              RowBox[{"maxdepth", ",", " ", "2"}], "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"maxdepth", "<=", "1"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "frd", "]"}], "==", "0"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Return", "[", 
               RowBox[{"{", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Period\>\"", "->", "0"}], ",", " ", 
                  RowBox[{"\"\<IsGliderGun\>\"", "->", "True"}], ",", " ", 
                  RowBox[{"\"\<LowestDepth\>\"", "->", "maxdepth"}]}], "|>"}],
                 "}"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Return", "[", 
                RowBox[{"{", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<Period\>\"", "->", 
                    RowBox[{"Length", "[", "frd", "]"}]}], ",", 
                   RowBox[{"\"\<Canonical\>\"", "->", 
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"FromDigits", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}], 
                    "&"}], "/@", "frd"}], "]"}], ",", " ", 
                    RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"FromDigits", "[", 
                    RowBox[{
                    RowBox[{"Reverse", "[", "#", "]"}], ",", 
                    RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}], 
                    "&"}], "/@", "frd"}], "]"}]}], "]"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"x", " ", "\"\<LowestDepth\>\""}], "->", 
                    "maxdepth"}]}], "|>"}], "}"}], "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
           "If", " ", "unfinished", " ", "and", " ", "probably", " ", 
            "unseparated"}], ",", " ", 
           RowBox[{"recurse", " ", "with", " ", "more", " ", "steps"}]}], " ",
           "*)"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "frd", "]"}], "==", "0"}], ",", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"MaxGapLength", "[", 
                RowBox[{"carun", "[", 
                 RowBox[{"[", 
                  RowBox[{"-", "1"}], "]"}], "]"}], "]"}], ">", "15"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"separatesolutions", "=", 
                RowBox[{"SplitSeparateSolutions2", "[", 
                 RowBox[{"carun", ",", " ", 
                  RowBox[{"ra", "[", "\"\<Rule\>\"", "]"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Join", "@@", 
                RowBox[{"Table", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"DetectPeriodSub", "[", 
                   RowBox[{
                   "ra", ",", " ", "subsolution", ",", " ", "steps", ",", " ", 
                    RowBox[{"maxdepth", "-", "1"}]}], "]"}], ",", 
                  "\[IndentingNewLine]", " ", 
                  RowBox[{"{", 
                   RowBox[{"subsolution", ",", " ", "separatesolutions"}], 
                   "}"}]}], "\[IndentingNewLine]", "]"}]}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"DetectPeriodSub", "[", 
               RowBox[{"ra", ",", " ", 
                RowBox[{"carun", "[", 
                 RowBox[{"[", 
                  RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", 
                RowBox[{"2", " ", "*", " ", "steps"}], ",", " ", 
                RowBox[{"maxdepth", " ", "-", " ", "1"}]}], "]"}]}], 
             "\[IndentingNewLine]", "]"}], "]"}]}], "\[IndentingNewLine]", 
          "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Otherwise", ",", " ", 
           RowBox[{
           "run", " ", "again", " ", "for", " ", "pure", " ", 
            "periodicity"}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"carun", "=", 
          RowBox[{"RunCA", "[", 
           RowBox[{
            RowBox[{"ra", "[", "\"\<Rule\>\"", "]"}], ",", " ", 
            RowBox[{"carun", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", "steps"}], "]"}]}], 
         ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"If", " ", 
           RowBox[{"it", "'"}], "s", " ", "multiperiodic"}], ",", " ", 
          RowBox[{"split", " ", "solutions"}]}], " ", "*)"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"separatesolutions", "=", 
         RowBox[{"SplitSeparateSolutions2", "[", 
          RowBox[{
           RowBox[{"RunCA", "[", 
            RowBox[{
             RowBox[{"ra", "[", "\"\<Rule\>\"", "]"}], ",", " ", 
             RowBox[{"carun", "[", 
              RowBox[{"[", 
               RowBox[{"-", 
                RowBox[{"Length", "[", "frd", "]"}]}], "]"}], "]"}], ",", " ", 
             RowBox[{"2", "*", 
              RowBox[{"Length", "[", "frd", "]"}]}]}], "]"}], ",", " ", 
           RowBox[{"ra", "[", "\"\<Rule\>\"", "]"}]}], "]"}]}], ";"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"separatesolutions", "=", " ", 
         RowBox[{"SortBy", "[", 
          RowBox[{"separatesolutions", ",", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"FirstPosition", "[", 
              RowBox[{"#", ",", " ", "1", ",", " ", "0"}], "]"}], "]"}], 
            "&"}]}], "]"}]}], " ", "*)"}], ";"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Recurse", " ", "on", " ", "each", " ", "subsolution"}], ",", 
        " ", 
        RowBox[{"if", " ", "they", " ", "exist"}]}], " ", "*)"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "separatesolutions", "]"}], ">", "1"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"Join", "@@", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"DetectPeriodSub", "[", 
             RowBox[{
             "ra", ",", " ", "subsolution", ",", " ", "steps", ",", " ", 
              RowBox[{"maxdepth", "-", "1"}]}], "]"}], ",", 
            "\[IndentingNewLine]", " ", 
            RowBox[{"{", 
             RowBox[{"subsolution", ",", " ", "separatesolutions"}], "}"}]}], 
           "\[IndentingNewLine]", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
       "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Return", " ", "single"}], "-", 
       RowBox[{"solution", " ", "period"}]}], " ", "*)"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"period", "=", 
      RowBox[{"Length", "[", "frd", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"canonical", "=", 
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"FromDigits", "[", 
            RowBox[{"#", ",", 
             RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}], "&"}], "/@",
           "frd"}], "]"}], ",", " ", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"FromDigits", "[", 
            RowBox[{
             RowBox[{"Reverse", "[", "#", "]"}], ",", 
             RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}], "&"}], "/@",
           "frd"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"carun", "=", 
      RowBox[{"RunCA", "[", 
       RowBox[{
        RowBox[{"ra", "[", "\"\<Rule\>\"", "]"}], ",", 
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"canonical", ",", " ", 
          RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}], ",", " ", 
        "period"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"shift", "=", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}], ",", 
        RowBox[{
         RowBox[{"FromDigits", "[", 
          RowBox[{
           RowBox[{"First", "[", "carun", "]"}], ",", " ", 
           RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}], "/", 
         RowBox[{"FromDigits", "[", 
          RowBox[{
           RowBox[{"Last", "[", "carun", "]"}], ",", " ", 
           RowBox[{"ra", "[", "\"\<Colors\>\"", "]"}]}], "]"}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
