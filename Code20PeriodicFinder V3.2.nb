Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"FindRepeatDeterministicIndexByStripZerosCompiled", "=", 
    RowBox[{"FunctionCompile", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"Typed", "[", 
         RowBox[{"list", ",", 
          RowBox[{"\"\<PackedArray\>\"", "::[", 
           RowBox[{"\"\<MachineInteger\>\"", ",", " ", "2"}], "]"}]}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"StripZeros", "=", 
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"Typed", "[", 
               RowBox[{"list2", ",", " ", 
                RowBox[{"\"\<PackedArray\>\"", "::[", 
                 RowBox[{"\"\<MachineInteger\>\"", ",", " ", "1"}], "]"}]}], 
               "]"}], ",", 
              RowBox[{"Module", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"i", "=", "1"}], ",", " ", 
                  RowBox[{"j", "=", 
                   RowBox[{"Length", "[", "list2", "]"}]}]}], "}"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"While", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"list2", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "==", "0"}], "&&", 
                    RowBox[{"i", "<", "j"}]}], ",", " ", 
                   RowBox[{"i", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
                 " ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"i", "<", "j"}], ",", 
                   RowBox[{"While", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"list2", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "==", "0"}], ",", " ", 
                    RowBox[{"j", "--"}]}], "]"}]}], "]"}], ";", " ", 
                 "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"i", "==", "j"}], ",", 
                   RowBox[{"Table", "[", 
                    RowBox[{"0", ",", " ", "0"}], "]"}], ",", 
                   RowBox[{"list2", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ";;", "j"}], "]"}], "]"}]}], "]"}]}]}], 
               "]"}]}], "\[IndentingNewLine]", "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "=", 
               RowBox[{
                RowBox[{"Length", "[", "list", "]"}], "-", "1"}]}], ",", " ", 
              
              RowBox[{"last", "=", 
               RowBox[{"StripZeros", "[", 
                RowBox[{"list", "[", 
                 RowBox[{"[", 
                  RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}]}], "}"}], ",", 
            "\[IndentingNewLine]", " ", 
            RowBox[{
             RowBox[{"While", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"i", ">", "0"}], "&&", 
                RowBox[{
                 RowBox[{"StripZeros", "[", 
                  RowBox[{"list", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}], "!=", "last"}]}], ",",
                " ", 
               RowBox[{"i", "--"}]}], "]"}], ";", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"i", "==", "0"}], ",", " ", "0", ",", 
               RowBox[{"i", "+", "1"}]}], "]"}]}]}], "\[IndentingNewLine]", 
           "]"}]}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"CompilerOptions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<LLVMOptimization\>\"", "->", 
          RowBox[{"\"\<ClangOptimization\>\"", "[", "3", "]"}]}], ",", " ", 
         RowBox[{"\"\<AbortHandling\>\"", "->", "False"}], ",", " ", 
         RowBox[{"\"\<OptimizationLevel\>\"", "->", "3"}]}], "}"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FindRepeatDeterministicByStripZeros", "[", "list_List", "]"}], ":=", 
   RowBox[{"StripZeros", "/@", 
    RowBox[{"list", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{
       "FindRepeatDeterministicIndexByStripZerosCompiled", "[", "list", "]"}],
        ";;"}], "]"}], "]"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
