Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "SplitSeparateSolutions", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SplitSeparateSolutions", "[", 
    RowBox[{"carun_", ",", " ", "mtg_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mask", ",", " ", "mc", ",", " ", "colors", ",", " ", "carunpadded"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"AppendTo", "[", 
       RowBox[{"data", ",", " ", "carun"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"carunpadded", "=", 
       RowBox[{"PadLeft", "[", 
        RowBox[{"carun", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Length", "[", "carun", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"carun", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "]"}], "+", "mtg"}]}], 
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mask", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"carunpadded", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"i", ";;", 
