Cell[CellGroupData[{

Cell["Abstract", "Chapter",
 CellChangeTimes->{{3.9949292882801533`*^9, 
  3.9949292923750772`*^9}},ExpressionUUID->"74932574-4b6a-4b6f-b9e2-\
8a13e686d167"],

Cell["\<\
A cellular automaton is an arrangement of cells whose values update based on \
a set of local rules. A structure in such a system is persistent if and only \
if it never dies out (all cells become zero), but either repeats or grows \
forever.\
\>", "Text",
 CellChangeTimes->{{3.994932650484589*^9, 3.9949326857268887`*^9}, {
  3.994932843436901*^9, 
  3.994932913061303*^9}},ExpressionUUID->"1efd0f08-fcbf-47b7-b10c-\
0cd711650632"],

Cell["\<\
This project explores the behavior of persistent structures in \
one-dimensional cellular automata, how to efficiently search for such \
structures, and the possible applications of such systems to other processes \
including biological growth and evolution.\
\>", "Text",
 CellChangeTimes->{{3.994931441530942*^9, 3.994931506989772*^9}, {
  3.994932806682208*^9, 3.994932842325509*^9}, {3.994932920700617*^9, 
  3.994933021277619*^9}},ExpressionUUID->"3c841a28-9d92-4d19-b8ac-\
28e6fbce5466"],

