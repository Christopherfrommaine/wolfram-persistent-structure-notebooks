Cell["\<\
This can be largely explained by the fact that if one init is twice as long \
as another init, then it is likely to contain about twice as many places \
where a structure might form, and therefore the probability that it will \
persist is increased.\
\>", "Text",
 CellChangeTimes->{{3.994942631888205*^9, 3.9949426349187*^9}, {
  3.9949426720234222`*^9, 
  3.994942760170512*^9}},ExpressionUUID->"7b35d763-10f9-4147-9a4c-\
0fcad19820a0"],

Cell["\<\
Alternatively, here is the same plot for the code 1329 automata, which is \
much more fruitful in terms of persistent structures:\
\>", "Text",
 CellChangeTimes->{{3.9949427681022587`*^9, 3.994942779359397*^9}, {
  3.994942907868166*^9, 
  3.994942924084682*^9}},ExpressionUUID->"04f4aee4-a404-42fe-b8e6-\
4a55dd867158"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "IsPersistent", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IsPersistent", "[", "init_", "]"}], ":=", 
   RowBox[{"Unitize", "[", 
    RowBox[{"Total", "[", 
     RowBox[{"CellularAutomaton", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1329", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"init", ",", " ", "3"}], "]"}], ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"{", "5000", "}"}], "}"}], "}"}]}], "]"}], "]"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FrequencyOf", "[", 
    RowBox[{"func_", ",", " ", "min_", ",", " ", "max_", ",", " ", "n_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"Total", "[", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{"func", ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"min", ",", " ", "max"}], "}"}], ",", " ", "n"}], "]"}]}], 
       "]"}], "]"}], "]"}], "/", "n"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"res", "=", 
    RowBox[{"ProgressMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "^", "#"}], ",", " ", 
         RowBox[{"FrequencyOf", "[", 
          RowBox[{"IsPersistent", ",", " ", 
           RowBox[{"2", "^", "#"}], ",", " ", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"#", "+", "1"}], ")"}]}], ",", " ", "10000"}], "]"}]}], 
        "}"}], "&"}], ",", " ", 
      RowBox[{"Range", "[", "100", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLogLinearPlot", "[", 
  RowBox[{"res", ",", " ", 
   RowBox[{"Joined", "->", "True"}], ",", "  ", 
   RowBox[{"Filling", "->", "Axis"}]}], "]"}]}], "Input",
 CellChangeTimes->{
  3.9949415625006247`*^9, {3.994941594990362*^9, 3.99494165081695*^9}, {
   3.9949416830136023`*^9, 3.994941784392969*^9}, {3.994941893280087*^9, 
   3.994942019637635*^9}, {3.99494209435493*^9, 3.994942156784738*^9}, {
   3.9949424251739893`*^9, 3.9949424253959208`*^9}, {3.99494278576084*^9, 
   3.994942830323924*^9}},
 CellLabel->
  "In[192]:=",ExpressionUUID->"2f48fd26-1e6e-47ea-af0e-18ba46ef1c2c"],

