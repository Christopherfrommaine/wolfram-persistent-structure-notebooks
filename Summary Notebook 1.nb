Cell["Detection isn\[CloseCurlyQuote]t perfect, but still pretty good:", \
"Text",
 CellChangeTimes->{{3.994950487043606*^9, 
  3.994950496085476*^9}},ExpressionUUID->"23103d01-ae6a-4427-9825-\
bdbc56b2d933"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "IsUnbounded", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"IsUnbounded", "[", "rule_", "]"}], "[", "init_", "]"}], ":=", 
   RowBox[{"Boole", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"run", "=", 
        RowBox[{"RunCA", "[", 
         RowBox[{"rule", ",", " ", "init", ",", " ", "200"}], "]"}]}], "}"}], 
      ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Last", "[", "run", "]"}], "]"}], "!=", "0"}], "&&", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"FindRepeatDeterministicByStripZeros", "[", "run", "]"}], 
         "]"}], "==", "0"}]}]}], "]"}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FrequencyOf", "[", 
    RowBox[{"func_", ",", " ", "min_", ",", " ", "max_", ",", " ", "n_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"Total", "[", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{"func", ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"min", ",", " ", "max"}], "}"}], ",", " ", "n"}], "]"}]}], 
       "]"}], "]"}], "]"}], "/", "n"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"res", "=", 
    RowBox[{"ProgressMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "^", "#"}], ",", " ", 
         RowBox[{"FrequencyOf", "[", 
          RowBox[{
           RowBox[{"IsUnbounded", "[", 
            RowBox[{"{", 
             RowBox[{"20", ",", " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", "2"}], "}"}], 
            "]"}], ",", " ", 
           RowBox[{"2", "^", "#"}], ",", " ", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"#", "+", "1"}], ")"}]}], ",", " ", "1000"}], "]"}]}], 
        "}"}], "&"}], ",", " ", 
      RowBox[{"Range", "[", "100", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLogLinearPlot", "[", 
  RowBox[{"res", ",", " ", 
   RowBox[{"Joined", "->", "True"}], ",", "  ", 
   RowBox[{"Filling", "->", "Axis"}], ",", " ", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.994946549229536*^9, 3.994946658946033*^9}, {
