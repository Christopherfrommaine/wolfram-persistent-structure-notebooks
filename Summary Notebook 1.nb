Cell[CellGroupData[{

Cell["\<\
Periodicity Frequency (What periods are most often seen in repeating \
structures?)\
\>", "Subsection",
 CellChangeTimes->{{3.99494090471315*^9, 3.994940909385455*^9}, {
  3.994942658040018*^9, 
  3.994942658951626*^9}},ExpressionUUID->"7b23eb8e-cf39-4e0c-98e6-\
d19007a66c13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"dataset", "=", 
   RowBox[{"ProgressMap", "[", 
    RowBox[{
     RowBox[{"rule", "|->", 
      RowBox[{"TimeConstrained", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"DedupSame", "[", 
          RowBox[{"Catenate", "[", 
           RowBox[{"ParallelMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"DetectPeriod", "[", 
               RowBox[{"rule", ",", " ", "#"}], "]"}], "&"}], ",", 
             RowBox[{
              RowBox[{"GPUStructureSearch", "[", 
               RowBox[{"rule", ",", " ", "0", ",", " ", "1000000"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{";;", 
                RowBox[{"UpTo", "[", "1000", "]"}]}], "]"}], "]"}]}], "]"}], 
           "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "\"\<Period\>\""}], "]"}], "]"}], ",", " ",
         "60", ",", " ", 
        RowBox[{"{", "}"}]}], "]"}]}], ",", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"List", "ListIcon", 
         GridBox[{{
            RowBox[{
              TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["List", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Dimensions: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox[
               RowBox[{"{", 
                 RowBox[{"80", ",", "3"}], "}"}], "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Byte count: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox["15424", "IconizedItem"]}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
