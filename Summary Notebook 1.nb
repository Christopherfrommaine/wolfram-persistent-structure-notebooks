Cell[BoxData[{
 RowBox[{"Clear", "[", "ProgressMap", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f_", ",", " ", "l_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"stdout", "=", 
       RowBox[{"PrintTemporary", "[", "\"\<\>\"", "]"}]}], ",", " ", 
      RowBox[{"len", "=", 
       RowBox[{"Length", "[", "l", "]"}]}], ",", " ", 
      RowBox[{"begin", "=", 
       RowBox[{"TimeObject", "[", "]"}]}], ",", " ", "cur", ",", " ", "avg", ",",
       "eta", ",", " ", "tmp", ",", " ", 
      RowBox[{"cont", "=", "True"}], ",", " ", "out", ",", " ", 
      RowBox[{"i", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"out", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", "len"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{"cont", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"out", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "=", 
         RowBox[{"f", "[", 
          RowBox[{"l", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "stdout", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cur", "=", 
         RowBox[{"TimeObject", "[", "]"}]}], ";", 
        RowBox[{"avg", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"cur", "-", "begin"}], ")"}], "/", "i"}]}], ";", 
        RowBox[{"eta", "=", 
         RowBox[{"begin", "+", 
          RowBox[{"len", "*", "avg"}]}]}], ";", 
        RowBox[{"stdout", "=", 
         RowBox[{"PrintTemporary", "[", 
          RowBox[{
           RowBox[{"\"\<Step \>\"", "<>", 
            RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\</\>\"", "<>", 
            RowBox[{"ToString", "[", "len", "]"}], "<>", "\"\< (\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"N", "[", 
              RowBox[{"100", "*", 
               RowBox[{"i", "/", "len"}]}], "]"}], "]"}], 
            "<>", "\"\<% complete, Avg Time \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"QuantityMagnitude", "[", 
              RowBox[{"avg", ",", "\"\<Seconds\>\""}], "]"}], "]"}], 
            "<>", "\"\< seconds per elem, ETA \>\"", "<>", 
            RowBox[{"DateString", "[", 
             RowBox[{"eta", ",", " ", "\"\<DateTimeShort\>\""}], "]"}], 
            "<>", "\"\<) \>\""}], ",", " ", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Stop\>\"", ",", " ", 
             RowBox[{"cont", "=", "False"}]}], "]"}]}], "]"}]}], ";", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", ">=", "len"}], ",", " ", 
          RowBox[{"cont", "=", "False"}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"out", "[", 
      RowBox[{"[", 
       RowBox[{";;", "i"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f_", ",", " ", "l_Integer"}], "]"}], ":=", 
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f", ",", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", "l"}], "]"}]}], "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9964901173941717`*^9, 3.996490118305334*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"1572c5c2-5395-4887-a91a-ee2f46b2a720"],

