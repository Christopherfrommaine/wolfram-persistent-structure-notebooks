Cell[BoxData[{
 RowBox[{"Clear", "[", "ProgressMap", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f_", ",", " ", "l_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"stdout", "=", 
       RowBox[{"PrintTemporary", "[", "\"\<\>\"", "]"}]}], ",", " ", 
      RowBox[{"len", "=", 
       RowBox[{"Length", "[", "l", "]"}]}], ",", " ", 
      RowBox[{"begin", "=", 
       RowBox[{"TimeObject", "[", "]"}]}], ",", " ", "cur", ",", " ", "avg", ",",
       "eta", ",", " ", "tmp", ",", " ", 
      RowBox[{"cont", "=", "True"}], ",", " ", "out", ",", " ", 
      RowBox[{"i", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"out", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", "len"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{"cont", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"out", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "=", 
         RowBox[{"f", "[", 
          RowBox[{"l", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "stdout", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cur", "=", 
         RowBox[{"TimeObject", "[", "]"}]}], ";", 
        RowBox[{"avg", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"cur", "-", "begin"}], ")"}], "/", "i"}]}], ";", 
        RowBox[{"eta", "=", 
         RowBox[{"begin", "+", 
          RowBox[{"len", "*", "avg"}]}]}], ";", 
        RowBox[{"stdout", "=", 
         RowBox[{"PrintTemporary", "[", 
          RowBox[{
           RowBox[{"\"\<Step \>\"", "<>", 
            RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\</\>\"", "<>", 
            RowBox[{"ToString", "[", "len", "]"}], "<>", "\"\< (\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"N", "[", 
              RowBox[{"100", "*", 
               RowBox[{"i", "/", "len"}]}], "]"}], "]"}], 
            "<>", "\"\<% complete, Avg Time \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"QuantityMagnitude", "[", 
              RowBox[{"avg", ",", "\"\<Seconds\>\""}], "]"}], "]"}], 
            "<>", "\"\< seconds per elem, ETA \>\"", "<>", 
            RowBox[{"DateString", "[", 
             RowBox[{"eta", ",", " ", "\"\<DateTimeShort\>\""}], "]"}], 
            "<>", "\"\<) \>\""}], ",", " ", 
           RowBox[{"Button", "[", 
            RowBox[{"\"\<Stop\>\"", ",", " ", 
             RowBox[{"cont", "=", "False"}]}], "]"}]}], "]"}]}], ";", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", ">=", "len"}], ",", " ", 
          RowBox[{"cont", "=", "False"}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"out", "[", 
      RowBox[{"[", 
       RowBox[{";;", "i"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f_", ",", " ", "l_Integer"}], "]"}], ":=", 
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f", ",", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", "l"}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{
  3.995110222647133*^9},ExpressionUUID->"7ec8646d-ab07-4829-85d1-\
e25168f71dd0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"RunCA", "[", 
   RowBox[{"rule_", ",", "init_List", ",", "steps_"}], "]"}], ":=", 
  RowBox[{"CellularAutomaton", "[", 
   RowBox[{"rule", ",", 
    RowBox[{"{", 
     RowBox[{"init", ",", "0"}], "}"}], ",", "steps"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
