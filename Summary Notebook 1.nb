Cell["Why is that the case?????", "Text",
 CellChangeTimes->{{3.9950333634710407`*^9, 
  3.995033366444889*^9}},ExpressionUUID->"daccdd1a-3aed-40db-8096-\
58f421e3bd5e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "IsUnbounded", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"IsUnbounded", "[", "rule_", "]"}], "[", "init_", "]"}], ":=", 
   RowBox[{"Boole", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"run", "=", 
        RowBox[{"RunCA", "[", 
         RowBox[{"rule", ",", " ", "init", ",", " ", "2000"}], "]"}]}], "}"}],
       ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Last", "[", "run", "]"}], "]"}], "!=", "0"}], "&&", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"FindRepeatDeterministicByStripZeros", "[", "run", "]"}], 
         "]"}], "==", "0"}]}]}], "]"}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "IsPersistent", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"IsPersistent", "[", "rule_", "]"}], "[", "init_", "]"}], ":=", 
   RowBox[{"Unitize", "[", 
    RowBox[{"Total", "[", 
     RowBox[{"CellularAutomaton", "[", 
      RowBox[{"rule", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"init", ",", " ", "2"}], "]"}], ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"{", "1000", "}"}], "}"}], "}"}]}], "]"}], "]"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FrequencyOf", "[", 
    RowBox[{"func_", ",", " ", "min_", ",", " ", "max_", ",", " ", "n_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"Total", "[", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{"func", ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"min", ",", " ", "max"}], "}"}], ",", " ", "n"}], "]"}]}], 
       "]"}], "]"}], "]"}], "/", "n"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"res", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"ProgressMap", "[", 
     RowBox[{
      RowBox[{"size", "|->", 
       RowBox[{"With", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"rule", "=", 
            RowBox[{"{", 
             RowBox[{"1329", ",", " ", 
              RowBox[{"{", 
               RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", "1"}], "}"}]}], 
           ",", " ", 
           RowBox[{"n", "=", "10000"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"min", "=", 
            RowBox[{"2", "^", "size"}]}], ",", " ", 
           RowBox[{"max", "=", 
            RowBox[{"2", "^", 
             RowBox[{"(", 
              RowBox[{"size", "+", "1"}], ")"}]}]}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"unboundedFreq", "=", 
            RowBox[{"FrequencyOf", "[", 
             RowBox[{
              RowBox[{"IsUnbounded", "[", "rule", "]"}], ",", "min", ",", " ",
               "max", ",", " ", "n"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"persistentFreq", "=", 
            RowBox[{"FrequencyOf", "[", 
             RowBox[{
              RowBox[{"IsPersistent", "[", "rule", "]"}], ",", " ", "min", ",",
               " ", "max", ",", " ", "n"}], "]"}]}]}], "\[IndentingNewLine]", 
          "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
