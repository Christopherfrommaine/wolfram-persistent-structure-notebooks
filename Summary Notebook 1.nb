Cell[BoxData[
 RowBox[{
  RowBox[{"PointApplyRule", "[", 
   RowBox[{"rule_", ",", "init_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"CellularAutomaton", "[", 
    RowBox[{"rule", ",", "init", ",", "1"}], "]"}], "\[LeftDoubleBracket]", 
   RowBox[{"2", ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Length", "[", "init", "]"}], "+", "1"}], ")"}], "/", "2"}]}], 
   "\[RightDoubleBracket]"}]}]], "Input",
 CellChangeTimes->{{3.994932448874971*^9, 3.994932451729588*^9}},
