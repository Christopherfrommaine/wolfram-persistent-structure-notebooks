Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AnalyzeRule", "[", 
    RowBox[{"{", 
     RowBox[{"n_", ",", 
      RowBox[{"{", 
       RowBox[{"k_", ",", "1"}], "}"}], ",", "r_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"AnalyzeRule", "[", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], "]"}], "=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rule", "=", 
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"num", "=", 
        RowBox[{"FromDigits", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"PointApplyRule", "[", 
               RowBox[{"rule", ",", "#1"}], "]"}], "&"}], ")"}], "/@", 
            RowBox[{"Tuples", "[", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", 
                RowBox[{"k", "-", "1"}]}], "]"}], ",", 
              RowBox[{
               RowBox[{"2", " ", "r"}], "+", "1"}]}], "]"}]}], "]"}], ",", 
          "k"}], "]"}]}], "}"}], ",", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"AnalyzeRule", "[", 
         RowBox[{"{", 
          RowBox[{"num", ",", "k", ",", "r"}], "}"}], "]"}], ",", 
        RowBox[{"Association", "[", 
         RowBox[{
          RowBox[{"\"\<Rule\>\"", "->", "rule"}], ",", 
          RowBox[{"\"\<Totalistic\>\"", "->", "True"}]}], "]"}]}], "]"}]}], 
     "]"}]}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AnalyzeRule", "[", 
    RowBox[{"{", 
     RowBox[{"n_", ",", "k_", ",", "r_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"AnalyzeRule", "[", 
     RowBox[{"{", 
      RowBox[{"n", ",", "k", ",", "r"}], "}"}], "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rule", "=", 
        RowBox[{"{", 
         RowBox[{"n", ",", "k", ",", "r"}], "}"}]}], "}"}], ",", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"\"\<Rule\>\"", "->", "rule"}], ",", 
        RowBox[{"\"\<NormalRule\>\"", "->", "rule"}], ",", 
        RowBox[{"\"\<Colors\>\"", "->", "k"}], ",", 
        RowBox[{"\"\<Radius\>\"", "->", "r"}], ",", 
        RowBox[{"\"\<Totalistic\>\"", "->", "False"}], ",", 
        RowBox[{"\"\<Number\>\"", "->", "n"}], ",", 
        RowBox[{"\"\<Quiescent\>\"", "->", 
         RowBox[{"!", 
          RowBox[{"Positive", "[", 
           RowBox[{"PointApplyRule", "[", 
            RowBox[{"rule", ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{
                RowBox[{"2", " ", "r"}], "+", "1"}]}], "]"}]}], "]"}], 
           "]"}]}]}], ",", 
        RowBox[{"\"\<Symmetric\>\"", "->", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Tuples", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{"k", "-", "1"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"2", " ", "r"}], "+", "1"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"PointApplyRule", "[", 
              RowBox[{"rule", ",", "#1"}], "]"}], "==", 
             RowBox[{"PointApplyRule", "[", 
              RowBox[{"rule", ",", 
               RowBox[{"Reverse", "[", "#1", "]"}]}], "]"}]}], "&"}]}], 
          "]"}]}]}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"AnalyzeRule", "[", 
   RowBox[{"{", 
    RowBox[{"n_", ",", "k_"}], "}"}], "]"}], ":=", 
  RowBox[{"AnalyzeRule", "[", 
   RowBox[{"{", 
    RowBox[{"n", ",", "k", ",", "1"}], "}"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"AnalyzeRule", "[", 
   RowBox[{"{", "n_", "}"}], "]"}], ":=", 
  RowBox[{"AnalyzeRule", "[", 
   RowBox[{"{", 
    RowBox[{"n", ",", "2"}], "}"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AnalyzeRule", "[", "n_", "]"}], ":=", 
  RowBox[{"AnalyzeRule", "[", 
   RowBox[{"{", "n", "}"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.994932394727089*^9, 3.994932422820609*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"4c3b39c5-1c6d-45d1-b560-d8e0ccc04a3c"],

