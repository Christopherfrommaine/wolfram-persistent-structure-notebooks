Cell["Results", "Subsubsection",
 CellChangeTimes->{{3.99494456492284*^9, 
  3.994944565753388*^9}},ExpressionUUID->"65a880de-c58d-444d-a8e9-\
a401de4e30c2"],

Cell["\<\
This shows the frequency of persistent initial conditions as the initial \
conditions get larger for the code 20 cellular automata. Most small initial \
conditions die, but as they get larger, the tend to live more often.\
\>", "Text",
 CellChangeTimes->{{3.994942494221868*^9, 
  3.99494262673456*^9}},ExpressionUUID->"36a901c9-cbe0-4cd5-9ef7-\
53330d639eb3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "IsPersistent", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IsPersistent", "[", "init_", "]"}], ":=", 
   RowBox[{"Unitize", "[", 
    RowBox[{"Total", "[", 
     RowBox[{"CellularAutomaton", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"20", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"init", ",", " ", "2"}], "]"}], ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"{", "1000", "}"}], "}"}], "}"}]}], "]"}], "]"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FrequencyOf", "[", 
    RowBox[{"func_", ",", " ", "min_", ",", " ", "max_", ",", " ", "n_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"Total", "[", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{"func", ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"min", ",", " ", "max"}], "}"}], ",", " ", "n"}], "]"}]}], 
       "]"}], "]"}], "]"}], "/", "n"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"res", "=", 
    RowBox[{"ProgressMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "^", "#"}], ",", " ", 
         RowBox[{"FrequencyOf", "[", 
          RowBox[{"IsPersistent", ",", " ", 
           RowBox[{"2", "^", "#"}], ",", " ", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"#", "+", "1"}], ")"}]}], ",", " ", "10000"}], "]"}]}], 
        "}"}], "&"}], ",", " ", 
      RowBox[{"Range", "[", "100", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLogLinearPlot", "[", 
  RowBox[{"res", ",", " ", 
   RowBox[{"Joined", "->", "True"}], ",", "  ", 
   RowBox[{"Filling", "->", "Axis"}]}], "]"}]}], "Input",
