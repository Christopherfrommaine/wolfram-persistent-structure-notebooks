Cell[CellGroupData[{

Cell["\<\
Unbounded Growth Frequency (How many initial conditions exhibit unbounded \
growth?)\
\>", "Subsection",
 CellChangeTimes->{{3.9949408581236553`*^9, 3.994940866547159*^9}, {
  3.9949426512729588`*^9, 
  3.9949426521936407`*^9}},ExpressionUUID->"b5ba14cb-10c8-4a3e-bdae-\
73b985906679"],

Cell["For 1329:", "Text",
 CellChangeTimes->{{3.994944542206708*^9, 3.9949445467845793`*^9}, {
  3.99494654007382*^9, 3.994946547846663*^9}, {3.994947604988388*^9, 
  3.994947606449725*^9}},ExpressionUUID->"5ba883e9-dc90-4274-b8ad-\
6c05b3ec0307"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "IsUnbounded", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"IsUnbounded", "[", "rule_", "]"}], "[", "init_", "]"}], ":=", 
   RowBox[{"Boole", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"run", "=", 
        RowBox[{"RunCA", "[", 
         RowBox[{"rule", ",", " ", "init", ",", " ", "5000"}], "]"}]}], "}"}],
       ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Last", "[", "run", "]"}], "]"}], "!=", "0"}], "&&", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"FindRepeatDeterministicByStripZeros", "[", "run", "]"}], 
         "]"}], "==", "0"}]}]}], "]"}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FrequencyOf", "[", 
    RowBox[{"func_", ",", " ", "min_", ",", " ", "max_", ",", " ", "n_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"Total", "[", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{"func", ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"min", ",", " ", "max"}], "}"}], ",", " ", "n"}], "]"}]}], 
       "]"}], "]"}], "]"}], "/", "n"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"res", "=", 
    RowBox[{"ProgressMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "^", "#"}], ",", " ", 
         RowBox[{"FrequencyOf", "[", 
          RowBox[{
           RowBox[{"IsUnbounded", "[", 
            RowBox[{"{", 
             RowBox[{"1329", ",", " ", 
              RowBox[{"{", 
               RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", "1"}], "}"}], 
            "]"}], ",", " ", 
           RowBox[{"2", "^", "#"}], ",", " ", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"#", "+", "1"}], ")"}]}], ",", " ", "3000"}], "]"}]}], 
        "}"}], "&"}], ",", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", "1000", ",", " ", "10"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLogLinearPlot", "[", 
  RowBox[{"res", ",", " ", 
   RowBox[{"Joined", "->", "True"}], ",", "  ", 
   RowBox[{"Filling", "->", "Axis"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.994946549229536*^9, 3.994946658946033*^9}, {
   3.99494746105389*^9, 3.994947465162219*^9}, {3.9950273723546257`*^9, 
   3.995027389214089*^9}, {3.995029935459495*^9, 3.995029946937269*^9}, {
   3.995029999450262*^9, 3.99503001947488*^9}, 3.9950301663608437`*^9, {
   3.995030804512986*^9, 3.995030819081541*^9}, 3.9950308685298634`*^9, {
   3.995030904318982*^9, 3.995030908862249*^9}},
