Cell[BoxData[{
 RowBox[{"Clear", "[", "PlotDiscoveryFrequency", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PlotDiscoveryFrequency", "[", 
   RowBox[{"rule_", ",", " ", "max_Integer", ",", " ", 
    RowBox[{"dedup_", ":", "True"}], ",", " ", 
    RowBox[{"timeout_", ":", "120"}], ",", " ", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "ListLogLinearPlot", "]"}]}]}], "]"}], ":=", 
  RowBox[{"TimeConstrained", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"inits", "=", 
        RowBox[{"GPUStructureSearch", "[", 
         RowBox[{
         "rule", ",", " ", "0", ",", " ", "max", ",", " ", "timeout", ",", 
          " ", "True"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"inits", "=", 
        RowBox[{"inits", "[", 
         RowBox[{"[", 
          RowBox[{";;", 
           RowBox[{"UpTo", "[", "10000", "]"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"dedup", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ress", "=", 
           RowBox[{"DedupSame", "[", 
            RowBox[{"SortBy", "[", 
             RowBox[{
              RowBox[{"Join", "@@", 
               RowBox[{"ParallelMap", "[", 
