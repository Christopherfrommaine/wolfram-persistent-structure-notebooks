Cell[BoxData[
 RowBox[{
  RowBox[{"GeneticOptimize", "[", 
   RowBox[{"loss_", ",", " ", "n_", ",", " ", 
    RowBox[{"numpoints_", ":", "100"}], ",", " ", 
    RowBox[{"minpoints_", ":", "10"}], ",", " ", 
    RowBox[{"steps_", ":", "100"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"points", "=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"2", "^", "n"}]}], "}"}], ",", " ", "100"}], "]"}]}], ",", 
      " ", 
      RowBox[{"stdout", "=", 
       RowBox[{"PrintTemporary", "[", "\"\<\>\"", "]"}]}], ",", "minloss"}], 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"points", "=", 
         RowBox[{"ParallelSortBy", "[", 
          RowBox[{"points", ",", " ", "loss"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minloss", "=", 
         RowBox[{"loss", "[", 
          RowBox[{"points", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"points", "=", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"points", ",", 
            RowBox[{"Join", "@@", 
             RowBox[{"ParallelTable", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"RandomFlip", "[", 
                  RowBox[{"point", ",", " ", "n"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", 
                   RowBox[{"Ceiling", "[", 
                    RowBox[{"numpoints", "/", "minpoints"}], "]"}]}], "}"}]}],
                 "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"point", ",", " ", 
                 RowBox[{"points", "[", 
                  RowBox[{"[", 
                   RowBox[{";;", "minpoints"}], "]"}], "]"}]}], "}"}]}], 
              "]"}]}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", "numpoints"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"points", "=", 
         RowBox[{"First", "/@", 
          RowBox[{"GatherBy", "[", 
           RowBox[{"points", ",", " ", "Lifetime"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "stdout", "]"}], ";", 
        RowBox[{"stdout", "=", 
         RowBox[{"PrintTemporary", "[", 
          
          RowBox[{"\"\<Step \>\"", ",", "step", ",", " ", "\"\</\>\"", ",", 
           " ", "steps", ",", " ", "\"\< | \>\"", ",", " ", 
           RowBox[{"Length", "[", "points", "]"}], ",", 
           " ", "\"\< points with minimum loss \>\"", ",", " ", "minloss"}], 
          "]"}]}], ";"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"step", ",", " ", "steps"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"points", "=", 
      RowBox[{"ParallelSortBy", "[", 
       RowBox[{"points", ",", " ", "loss"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"points", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.988475533353641*^9, 3.9884756641812153`*^9}, {
