Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"Code20", "[", "inp_", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"BitShiftLeft", "[", 
        RowBox[{"inp", ",", " ", "2"}], "]"}]}], ",", " ", 
      RowBox[{"b", "=", 
       RowBox[{"BitShiftLeft", "[", 
        RowBox[{"inp", ",", " ", "1"}], "]"}]}], ",", " ", 
      RowBox[{"c", "=", "inp"}], ",", " ", 
      RowBox[{"d", "=", 
       RowBox[{"BitShiftRight", "[", 
        RowBox[{"inp", ",", " ", "1"}], "]"}]}], ",", " ", 
      RowBox[{"e", "=", 
       RowBox[{"BitShiftRight", "[", 
        RowBox[{"inp", ",", " ", "2"}], "]"}]}]}], "}"}], ",", 
    RowBox[{"BitXor", "[", 
     RowBox[{
      RowBox[{"BitOr", "[", 
       RowBox[{"a", ",", " ", "b", ",", " ", "c", ",", "d", ",", "e"}], "]"}],
       ",", " ", 
      RowBox[{"BitXor", "[", 
       RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e"}], "]"}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.98849274945433*^9, 3.9884928347602863`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"551ca0a8-1feb-4213-85cc-b30b0211837d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Lifetime", "[", "inp_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"seen", "=", 
       RowBox[{"CreateDataStructure", "[", 
        RowBox[{"\"\<HashSet\>\"", ",", " ", 
         RowBox[{"{", "0", "}"}]}], "]"}]}], ",", " ", 
      RowBox[{"o", "=", "inp"}], ",", " ", 
      RowBox[{"count", "=", "0"}], ",", " ", 
      RowBox[{"gap", "=", "0"}], ",", " ", 
      RowBox[{"gapsum", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"seen", "[", 
         RowBox[{"\"\<Insert\>\"", ",", "o"}], "]"}], "&&", 
        RowBox[{"count", "<", "10000"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"o", "=", 
         RowBox[{"Code20", "[", "o", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gap", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"gap", ",", " ", 
           RowBox[{"LargestGap", "[", 
            RowBox[{"IntegerDigits", "[", 
             RowBox[{"o", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"count", "==", "10000"}], ",", " ", "0", ",", "count"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Loss", "[", "inp_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"seen", "=", 
       RowBox[{"CreateDataStructure", "[", 
        RowBox[{"\"\<HashSet\>\"", ",", " ", 
         RowBox[{"{", "0", "}"}]}], "]"}]}], ",", " ", 
      RowBox[{"o", "=", "inp"}], ",", " ", 
      RowBox[{"count", "=", "0"}], ",", " ", 
      RowBox[{"gap", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"seen", "[", 
         RowBox[{"\"\<Insert\>\"", ",", " ", "o"}], "]"}], "&&", 
        RowBox[{"count", "<", "10000"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"o", "=", 
         RowBox[{"Code20", "[", "o", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gap", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"gap", ",", " ", 
           RowBox[{"LargestGap", "[", 
            RowBox[{"IntegerDigits", "[", 
             RowBox[{"o", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"count", "==", "10000"}], ",", " ", "0", ",", " ", 
       RowBox[{
        RowBox[{"-", "count"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"gap", "/", "5"}], ")"}], "^", "4"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
