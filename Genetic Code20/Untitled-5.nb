Cell[BoxData[{
 RowBox[{
  RowBox[{"RandomFlip", "[", 
   RowBox[{"inp_", ",", " ", "n_"}], "]"}], ":=", 
  RowBox[{"BitXor", "[", 
   RowBox[{"inp", ",", " ", 
    RowBox[{"BitShiftLeft", "[", 
     RowBox[{"1", ",", " ", 
      RowBox[{"RandomInteger", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"n", "-", "1"}]}], "}"}], "]"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RandomFlips", "[", "k_", "]"}], "[", 
   RowBox[{"inp_", ",", " ", "n_"}], "]"}], ":=", 
  RowBox[{"Nest", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"RandomFlip", "[", 
      RowBox[{"#", ",", " ", "n"}], "]"}], "&"}], ",", " ", "inp", ",", " ", 
    "k"}], "]"}]}]}], "Input",
