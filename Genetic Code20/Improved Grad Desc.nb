      RowBox[{"\"\<Seed\>\"", "->", "Automatic"}], ",", 
      RowBox[{"\"\<History\>\"", "->", "True"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
