Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LossPeriodic", "[", "p_", "]"}], "[", "list_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Min", "[", "list", "]"}], "<", "0"}], "||", 
     RowBox[{
      RowBox[{"Max", "[", "list", "]"}], ">", "1"}]}], ",", " ", "100000", ",",
     " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"periodicitydiff", "=", 
        RowBox[{
         RowBox[{"ArrayPad", "[", 
          RowBox[{"list", ",", " ", 
           RowBox[{"2", "p"}]}], "]"}], "-", 
         RowBox[{"Nest", "[", 
          RowBox[{"Code20Row", ",", " ", 
           RowBox[{"ArrayPad", "[", 
            RowBox[{"list", ",", " ", 
             RowBox[{"2", "p"}]}], "]"}], ",", " ", "p"}], "]"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"periodicitydiff", ".", "periodicitydiff"}], ")"}], "-", 
       RowBox[{"Max", "[", "list", "]"}]}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LossPeriodicBinary", "[", "p_", "]"}], "[", "list_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Min", "[", "list", "]"}], "<", "0"}], "||", 
      RowBox[{
       RowBox[{"Max", "[", "list", "]"}], ">", "1"}]}], ",", " ", "100000", ",",
      " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"periodicitydiff", "=", 
          RowBox[{
           RowBox[{"ArrayPad", "[", 
            RowBox[{"list", ",", " ", 
             RowBox[{"2", "p"}]}], "]"}], "-", 
           RowBox[{"Nest", "[", 
            RowBox[{"Code20Row", ",", " ", 
             RowBox[{"ArrayPad", "[", 
              RowBox[{"list", ",", " ", 
               RowBox[{"2", "p"}]}], "]"}], ",", " ", "p"}], "]"}]}]}], ",", 
         " ", 
         RowBox[{"closenesstobinary", "=", 
          RowBox[{"list", " ", "*", " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", "list"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"periodicitydiff", ".", "periodicitydiff"}], ")"}], "+", 
        RowBox[{"10", 
         RowBox[{"(", 
          RowBox[{"closenesstobinary", ".", "closenesstobinary"}], ")"}]}], "-", 
        RowBox[{"Max", "[", "list", "]"}]}]}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
