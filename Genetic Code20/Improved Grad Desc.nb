Cell[BoxData[{
 RowBox[{
  RowBox[{"StripZeros", "[", "list_", "]"}], ":=", 
  RowBox[{"list", "//.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "x___"}], "}"}], "->", 
      RowBox[{"List", "@", "x"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x___", ",", " ", "0"}], "}"}], "->", 
      RowBox[{"List", "@", "x"}]}]}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExpandZeros", "[", "list_", "]"}], ":=", 
  RowBox[{"list", "//.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a_", "?", "Positive"}], ",", " ", 
        RowBox[{"b_", "?", "Positive"}], ",", " ", "x___"}], "}"}], "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "a", ",", " ", "b", ",", " ", "x"}], "}"}]}], ",",
      " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x___", ",", " ", 
        RowBox[{"a_", "?", "Positive"}], ",", " ", 
        RowBox[{"b_", "?", "Positive"}]}], "}"}], "->", 
