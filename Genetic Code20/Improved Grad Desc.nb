 RowBox[{
  RowBox[{"NOT", "[", "a_", "]"}], ":=", 
  RowBox[{"NAND", "[", 
   RowBox[{"a", ",", " ", "a"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AND", "[", 
   RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{"NOT", "[", 
   RowBox[{"NAND", "[", 
    RowBox[{"a", ",", " ", "b"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OR", "[", 
   RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{"NAND", "[", 
   RowBox[{
    RowBox[{"NOT", "[", "a", "]"}], ",", " ", 
    RowBox[{"NOT", "[", "b", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"XOR", "[", 
   RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{"AND", "[", 
   RowBox[{
    RowBox[{"OR", "[", 
     RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", 
