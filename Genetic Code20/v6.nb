Cell[BoxData[
 RowBox[{
  RowBox[{"Code20InterpRow", "=", 
   RowBox[{"FunctionCompile", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"Typed", "[", 
        RowBox[{"init", ",", " ", 
         RowBox[{"\"\<PackedArray\>\"", "::[", 
          RowBox[{"\"\<MachineReal\>\"", ",", " ", "1"}], "]"}]}], "]"}], ",",
        " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"padded", "=", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0.", ",", " ", "0."}], "}"}], ",", " ", "init", ",", 
             " ", 
             RowBox[{"{", 
              RowBox[{"0.", ",", " ", "0."}], "}"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"sum", "=", 
               RowBox[{"Total", "[", 
                RowBox[{"padded", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ";;", 
                   RowBox[{"i", "+", "4"}]}], "]"}], "]"}], "]"}]}], "}"}], ",",
              " ", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"o", "=", 
                 RowBox[{"Which", "[", 
                  RowBox[{
                   RowBox[{"sum", ">=", "3."}], ",", 
                   RowBox[{"1.", "-", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"sum", "-", "4."}], "]"}]}], ",", " ", 
                   RowBox[{"sum", ">=", "1."}], ",", " ", 
                   RowBox[{"1.", "-", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"sum", "-", "2."}], "]"}]}], ",", "True", ",", 
                   " ", "0."}], "]"}]}], "}"}], ",", " ", 
               RowBox[{
                RowBox[{"0.6", "o"}], "+", 
                RowBox[{"0.4", "o", "*", "o"}]}]}], "]"}]}], "]"}], ",", " ", 
           
           RowBox[{"{", 
            RowBox[{"i", ",", " ", 
             RowBox[{"Length", "[", "init", "]"}]}], "}"}]}], "]"}]}], 
        "]"}]}], "]"}], ",", 
     RowBox[{"CompilerOptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<LLVMOptimization\>\"", "->", 
         RowBox[{"\"\<ClangOptimization\>\"", "[", "3", "]"}]}], ",", 
        RowBox[{"\"\<OptimizationLevel\>\"", "->", "3"}]}], "}"}]}]}], 
    "]"}]}], ";"}]], "Input",
