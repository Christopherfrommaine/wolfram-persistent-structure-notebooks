Cell[BoxData[{
 RowBox[{
  RowBox[{"GrayCode", "=", 
   RowBox[{"ResourceFunction", "[", "\"\<GrayCode\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GrayCodeList", "[", "l_List", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gc", "=", 
      RowBox[{"GrayCode", "[", "l", "]"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"maxlen", "=", 
      RowBox[{"Max", "[", 
       RowBox[{"Length", "/@", "gc"}], "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"PadLeft", "[", 
       RowBox[{"#", ",", " ", "maxlen"}], "]"}], "&"}], "/@", "gc"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.990003444842589*^9, 3.990003567603794*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"bf55ece7-6780-473e-a7e7-a8ef5702487b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"numBits", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gci", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{
           RowBox[{"2", "^", "numBits"}], "-", "1"}]}], "]"}], ",", " ", 
        RowBox[{"GrayCodeList", "[", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{
            RowBox[{"2", "^", "numBits"}], "-", "1"}]}], "]"}], "]"}]}], 
       "}"}], "]"}], ",", " ", 
     RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.990003591235754*^9, 3.9900037071442204`*^9}, {
   3.990003751755516*^9, 3.990003762473302*^9}, {3.990003932814815*^9, 
