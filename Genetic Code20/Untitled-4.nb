Cell["\<\
So the loss is a combination of lifetime and a maximum separation constraint.\
\
\>", "Text",
 CellChangeTimes->{{3.9886677321136427`*^9, 
  3.988667744515314*^9}},ExpressionUUID->"4293bc7b-14a0-4991-9f39-\
b749fdb6e159"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Lifetime", "[", "list_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"seen", "=", 
       RowBox[{"CreateDataStructure", "[", 
        RowBox[{"\"\<HashSet\>\"", ",", " ", 
         RowBox[{"{", "0", "}"}]}], "]"}]}], ",", " ", 
      RowBox[{"o", "=", "list"}], ",", " ", 
      RowBox[{"count", "=", "0"}], ",", " ", 
      RowBox[{"gap", "=", "0"}], ",", " ", 
      RowBox[{"gapsum", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"seen", "[", 
         RowBox[{"\"\<Insert\>\"", ",", " ", 
          RowBox[{"FromDigits", "[", 
           RowBox[{"o", ",", " ", "2"}], "]"}]}], "]"}], "&&", 
        RowBox[{"count", "<", "10000"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"o", "=", 
         RowBox[{"CellularAutomaton", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"20", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}], ",", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"o", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"{", "1", "}"}], "}"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gap", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"gap", ",", " ", 
           RowBox[{"LargestGap", "[", "o", "]"}]}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"count", "==", "10000"}], ",", " ", "0", ",", "count"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Loss", "[", "list_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"seen", "=", 
       RowBox[{"CreateDataStructure", "[", 
        RowBox[{"\"\<HashSet\>\"", ",", " ", 
         RowBox[{"{", "0", "}"}]}], "]"}]}], ",", " ", 
      RowBox[{"o", "=", "list"}], ",", " ", 
      RowBox[{"count", "=", "0"}], ",", " ", 
      RowBox[{"gap", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"seen", "[", 
         RowBox[{"\"\<Insert\>\"", ",", " ", 
          RowBox[{"FromDigits", "[", 
           RowBox[{"o", ",", " ", "2"}], "]"}]}], "]"}], "&&", 
        RowBox[{"count", "<", "10000"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"o", "=", 
         RowBox[{"CellularAutomaton", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"20", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}], ",", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"o", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"{", "1", "}"}], "}"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gap", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"gap", ",", " ", 
           RowBox[{"LargestGap", "[", "o", "]"}]}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"count", "==", "10000"}], ",", " ", 
       RowBox[{"10000", " ", "-", "count", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"gap", "/", "5"}], ")"}], "^", "4"}]}], ",", " ", 
       RowBox[{
        RowBox[{"-", "count"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"gap", "/", "5"}], ")"}], "^", "4"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9884765998049183`*^9, 3.988476622089685*^9}, {
   3.988476664463161*^9, 3.988476669822468*^9}, {3.988476706009234*^9, 
   3.988476814865287*^9}, {3.98847694249549*^9, 3.988476943295005*^9}, {
   3.988477112046773*^9, 3.9884771534516277`*^9}, {3.9884778128710403`*^9, 
   3.9884779326252117`*^9}, 3.9884779689536533`*^9, {3.988478188447994*^9, 
   3.9884781899977913`*^9}, {3.9884782751749153`*^9, 3.98847831267447*^9}, {
   3.988480962758333*^9, 3.988480968766486*^9}, {3.988486103522335*^9, 
   3.988486118331008*^9}, {3.9885760296327553`*^9, 3.988576031056584*^9}, {
   3.9886675713089542`*^9, 3.988667589151991*^9}, 3.988667851097638*^9},
 CellLabel->"In[31]:=",ExpressionUUID->"94991a03-e80d-4cd1-bbde-ea7b120f2a6e"]
