Cell[CellGroupData[{

Cell["Conclusions:", "Subsection",
 CellChangeTimes->{{3.9886679041077414`*^9, 
  3.9886679056145287`*^9}},ExpressionUUID->"47c953aa-26e5-4d40-af66-\
848afd1edbc6"],

Cell["\<\
From what I\[CloseCurlyQuote]ve seen, the genetic algorithm seems to often \
get stuck in local minima. I\[CloseCurlyQuote]ve tried differentiation \
techniques like the GatherBy step in the genetic algorithm, but it doesn\
\[CloseCurlyQuote]t seem to help much. This doesn\[CloseCurlyQuote]t seem \
like a promising approach for finding persistent solutions rather than just \
long-living solutions. When allowing for infinite-lifespan solutions, the \
algorithm seems to converge only on very small infinite solutions, which can \
be just as easily found by random search. This is in contrast to the \
sometimes 60-bit wide persistent solutions that have been found.\
\>", "Text",
 CellChangeTimes->{{3.988667907500079*^9, 
  3.988668184564334*^9}},ExpressionUUID->"bb52d790-b878-4433-8e6c-\
ed72c86d7b7e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NAND", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], ":=", 
   RowBox[{"1", "-", 
    RowBox[{"x", " ", "y"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NOT", "[", "x_", "]"}], ":=", 
  RowBox[{"NAND", "[", 
   RowBox[{"x", ",", " ", "x"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AND", "[", 
   RowBox[{"x_", ",", " ", "y_"}], "]"}], ":=", 
  RowBox[{"NOT", "[", 
   RowBox[{"NAND", "[", 
    RowBox[{"x", ",", " ", "y"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OR", "[", 
   RowBox[{"x_", ",", " ", "y_"}], "]"}], ":=", 
  RowBox[{"NOT", "[", 
   RowBox[{"AND", "[", 
    RowBox[{
     RowBox[{"NOT", "[", "x", "]"}], ",", " ", 
     RowBox[{"NOT", "[", "y", "]"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"XOR", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], ":=", 
   RowBox[{"AND", "[", 
    RowBox[{
     RowBox[{"NOT", "[", 
      RowBox[{"AND", "[", 
       RowBox[{"x", ",", " ", "y"}], "]"}], "]"}], ",", " ", 
     RowBox[{"OR", "[", 
      RowBox[{"x", ",", " ", "y"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Small", " ", "representation", " ", "of", " ", "code20", " ", "if", " ", 
    "the", " ", "neighborhood", " ", "is", " ", 
    RowBox[{"(", 
     RowBox[{
     "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", " ", "e"}], 
     ")"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"code20", "=", 
  RowBox[{"XOR", "[", 
   RowBox[{
    RowBox[{"XOR", "[", 
