Cell[BoxData[
 RowBox[{
  RowBox[{"GeneticOptimize", "[", 
   RowBox[{"loss_", ",", " ", "norig_", ",", " ", 
    RowBox[{"numpoints_", ":", "100"}], ",", " ", 
    RowBox[{"minpoints_", ":", "10"}], ",", " ", 
    RowBox[{"steps_", ":", "100"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"points", "=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"100", ",", "norig"}], "}"}]}], "]"}]}], ",", " ", 
      RowBox[{"stdout", "=", 
       RowBox[{"PrintTemporary", "[", "\"\<\>\"", "]"}]}], ",", "minloss", ",",
       " ", 
      RowBox[{"n", "=", "norig"}]}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"points", "=", 
         RowBox[{"ParallelSortBy", "[", 
          RowBox[{"points", ",", " ", "loss"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minloss", "=", 
         RowBox[{"loss", "[", 
          RowBox[{"points", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"points", "=", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"points", ",", 
            RowBox[{"Join", "@@", 
             RowBox[{"ParallelTable", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"RandomFlip", "[", "point", "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", 
                   RowBox[{"Ceiling", "[", 
                    RowBox[{"numpoints", "/", "minpoints"}], "]"}]}], "}"}]}],
                 "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"point", ",", " ", 
                 RowBox[{"points", "[", 
                  RowBox[{"[", 
                   RowBox[{";;", "minpoints"}], "]"}], "]"}]}], "}"}]}], 
              "]"}]}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", "numpoints"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"points", "=", 
         RowBox[{"First", "/@", 
          RowBox[{"GatherBy", "[", 
           RowBox[{"points", ",", " ", "Lifetime"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomReal", "[", "]"}], ">", "0.95"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"n", "+=", "1"}], ";", "\[IndentingNewLine]", 
           RowBox[{"points", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Append", "[", 
               RowBox[{"point", ",", " ", "0"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"point", ",", " ", "points"}], "}"}]}], "]"}]}]}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomReal", "[", "]"}], ">", "0.95"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"n", "+=", "1"}], ";", "\[IndentingNewLine]", 
           RowBox[{"points", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Prepend", "[", 
               RowBox[{"point", ",", " ", "0"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"point", ",", " ", "points"}], "}"}]}], "]"}]}]}]}], 
         "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"NotebookDelete", "[", "stdout", "]"}], ";", 
        RowBox[{"stdout", "=", 
         RowBox[{"PrintTemporary", "[", 
          
          RowBox[{"\"\<Step \>\"", ",", "step", ",", " ", "\"\</\>\"", ",", 
           " ", "steps", ",", " ", "\"\< | \>\"", ",", " ", 
           RowBox[{"Length", "[", "points", "]"}], ",", 
           " ", "\"\< points with length \>\"", ",", "n", 
           ",", "\"\< and minimum loss \>\"", ",", " ", "minloss"}], "]"}]}], 
        ";"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"step", ",", " ", "steps"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"points", "=", 
      RowBox[{"ParallelSortBy", "[", 
       RowBox[{"points", ",", " ", "loss"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"points", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.988475533353641*^9, 3.9884756641812153`*^9}, {
