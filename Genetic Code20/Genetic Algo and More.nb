Cell[BoxData[{
 RowBox[{
  RowBox[{"RandomFlip", "[", "list_", "]"}], ":=", 
  RowBox[{"BitXor", "[", 
   RowBox[{"list", ",", " ", 
    RowBox[{"UnitVector", "[", 
     RowBox[{
      RowBox[{"Length", "[", "list", "]"}], ",", " ", 
      RowBox[{"RandomInteger", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"Length", "[", "list", "]"}]}], "}"}], "]"}]}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RandomFlips", "[", "n_", "]"}], "[", "list_", "]"}], ":=", 
  RowBox[{"Nest", "[", 
   RowBox[{"RandomFlip", ",", " ", "list", ",", " ", "n"}], "]"}]}]}], "Input",\

 CellChangeTimes->{{3.988475669614223*^9, 3.988475706815907*^9}, {
  3.9884758229407597`*^9, 3.9884758430046377`*^9}, {3.988492437367755*^9, 
