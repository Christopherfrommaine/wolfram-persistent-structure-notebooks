Cell[CellGroupData[{
Cell["Method 1: Genetic Algorithm", "Title",
 CellChangeTimes->{{3.988668270186091*^9, 
  3.988668278086779*^9}},ExpressionUUID->"e2050d37-6e9f-43a2-bb8f-\
