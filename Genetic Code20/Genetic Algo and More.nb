Cell[BoxData[
 RowBox[{
  RowBox[{"ParallelSortBy", "[", 
   RowBox[{"list_", ",", " ", "func_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cache", "=", 
      RowBox[{"Association", "@", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"elem", "->", 
          RowBox[{"func", "[", "elem", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"elem", ",", " ", "list"}], "}"}]}], "]"}]}]}], "}"}], ",", 
    " ", 
    RowBox[{"SortBy", "[", 
     RowBox[{"list", ",", " ", "cache"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9884862460810013`*^9, 3.988486255644966*^9}, {
  3.988486323845487*^9, 3.988486361865942*^9}},
 CellLabel->
  "In[131]:=",ExpressionUUID->"06317aae-26e8-4759-8e28-a1c96c22f8a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RepeatedTiming", "[", 
  RowBox[{"ParallelSortBy", "[", 
   RowBox[{
    RowBox[{"Range", "[", "100", "]"}], ",", " ", 
