Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SingleGradientDescent", "[", 
    RowBox[{"f_", ",", " ", "steps_", ",", " ", "d_", ",", "ogpoint_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"point", "=", "ogpoint"}], ",", 
       RowBox[{"temp", "=", "0.1"}], ",", " ", 
       RowBox[{"prevloss", "=", 
        RowBox[{"f", "[", "ogpoint", "]"}]}], ",", " ", 
       RowBox[{"loss", "=", 
        RowBox[{"f", "[", "ogpoint", "]"}]}], ",", " ", "gradient", ",", " ", 
       "prevpoint"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"prevpoint", "=", "point"}], ";", "\[IndentingNewLine]", 
         RowBox[{"gradient", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"f", "[", 
                RowBox[{"point", "-", 
                 RowBox[{"d", "*", 
                  RowBox[{"UnitVector", "[", 
                   RowBox[{
                    RowBox[{"Length", "[", "point", "]"}], ",", " ", "i"}], 
                   "]"}]}]}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"i", ",", " ", 
                 RowBox[{"Length", "[", "point", "]"}]}], "}"}]}], "]"}], "-",
              "loss"}], ")"}], "/", "d"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"point", "-=", 
          RowBox[{"gradient", "*", "temp"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"prevloss", "=", "loss"}], ";", "\[IndentingNewLine]", 
         RowBox[{"loss", "=", 
          RowBox[{"f", "[", "point", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"prevloss", ">", "loss"}], ",", " ", 
           RowBox[{
            RowBox[{"point", "=", "prevpoint"}], ";", 
            RowBox[{"temp", "*=", "0.5"}], ";"}], ",", 
           RowBox[{"temp", "*=", "1.1"}]}], "]"}], ";"}], 
        "\[IndentingNewLine]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"step", ",", " ", "steps"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "point", "]"}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GradientDescent", "[", 
   RowBox[{"f_", ",", " ", "bounds_", ",", " ", 
    RowBox[{"numpoints_", ":", "1000"}], ",", 
    RowBox[{"steps_", ":", "100"}], ",", " ", 
    RowBox[{"d_", ":", 
     RowBox[{"10", "^", 
      RowBox[{"-", "10"}]}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"points", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"RandomReal", "[", 
           RowBox[{"bound", ",", " ", 
            RowBox[{"10", "*", "numpoints"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"bound", ",", " ", "bounds"}], "}"}]}], "]"}], "]"}]}], ",",
       " ", "threshold"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"threshold", "=", 
      RowBox[{"Min", "[", 
       RowBox[{"f", "/@", 
        RowBox[{"RandomChoice", "[", 
         RowBox[{"points", ",", " ", "10"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"points", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "[", "point", "]"}], "<", "threshold"}], ",", " ", 
          "point", ",", " ", "Nothing"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"point", ",", " ", "points"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"points", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"SingleGradientDescent", "[", 
         RowBox[{"f", ",", " ", "steps", ",", " ", "d", ",", " ", "point"}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"point", ",", " ", "points"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"First", "[", 
      RowBox[{"MinimalBy", "[", 
       RowBox[{"points", ",", " ", "f"}], "]"}], "]"}]}]}], "]"}]}]}], "Input",\

