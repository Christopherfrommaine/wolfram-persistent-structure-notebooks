Cell[BoxData[
 RowBox[{
  RowBox[{"Lifetime", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"seen", "=", 
       RowBox[{"CreateDataStructure", "[", "\"\<HashSet\>\"", "]"}]}], ",", 
      " ", 
      RowBox[{"o", "=", "n"}], ",", " ", 
      RowBox[{"count", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"seen", "[", 
        RowBox[{"\"\<Insert\>\"", ",", " ", "o"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"o", "=", 
         RowBox[{
          RowBox[{"CellularAutomaton", "[", 
           RowBox[{"{", 
            RowBox[{"20", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}], ",", "2"}], "}"}], "]"}], "[", 
          "o", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"AllMatch", "[", 
        RowBox[{"o", ",", " ", "0"}], "]"}], ",", "count", ",", " ", 
       "Infinity"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
