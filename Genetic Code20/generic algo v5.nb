Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "LinearSumInterpolation", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LinearSumInterpolation", "[", "list_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Interpolation", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "[", 
   RowBox[{"Total", "[", "list", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NonlinearSumInterpolation", "[", "list_", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"o", "=", 
      RowBox[{"LinearSumInterpolation", "[", "list", "]"}]}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"0.6", "o"}], "+", 
     RowBox[{"0.4", 
      RowBox[{"o", "^", "2"}]}]}]}], "]"}]}]}], "Input",
