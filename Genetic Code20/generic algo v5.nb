      RowBox[{
       RowBox[{
        RowBox[{"StepCode20Interped", "[", "LinearSumInterpolation", "]"}], "[", 
        RowBox[{"o", "[", 
         RowBox[{"[", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "==", "1"}], ",", " ", 
            RowBox[{"Length", "[", "o", "]"}], ",", 
            RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "o", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"o", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"o", "+", "new"}], ")"}], "/", "2"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", ",", " ", "1000"}], 
  "\[IndentingNewLine]", "]"}]], "Input",
