Cell[BoxData[{
 RowBox[{
  RowBox[{"frames", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"o", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"{", 
      RowBox[{"20", ",", " ", "20"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"o", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "=", 
   RowBox[{"CenterArray", "[", 
    RowBox[{
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", "10"}], "]"}], ",", " ", 
     RowBox[{"Length", "[", 
      RowBox[{"First", "[", "o", "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"first", "=", 
   RowBox[{"o", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"counter", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"frames", ",", " ", 
      RowBox[{"NumericArray", "[", 
       RowBox[{"o", ",", " ", "\"\<Real32\>\""}], "]"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"new", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"StepCode20Interped", "[", "LinearSumInterpolation", "]"}], "[", 
        RowBox[{"o", "[", 
         RowBox[{"[", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "==", "1"}], ",", " ", 
            RowBox[{"Length", "[", "o", "]"}], ",", 
            RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "o", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"o", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"o", "+", "new"}], ")"}], "/", "2"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"o", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "]"}], "<", "0.01"}], "&&", 
       RowBox[{"counter", "<", "6"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"o", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", "first"}], ";", " ", 
       RowBox[{"counter", "++"}]}]}], "]"}], ";"}], " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", ",", "1000"}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
