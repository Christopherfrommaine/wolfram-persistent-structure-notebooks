Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"StepCode20Interped", "[", "interp_", "]"}], "[", "list_", "]"}], ":=", 
  RowBox[{"interp", "/@", 
   RowBox[{"Partition", "[", 
    RowBox[{
     RowBox[{"ArrayPad", "[", 
      RowBox[{"list", ",", "2"}], "]"}], ",", "5", ",", "1"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"StepCode20InterpedPar", "[", "interp_", "]"}], "[", "list_", 
   "]"}], ":=", 
  RowBox[{"ParallelMap", "[", 
   RowBox[{"interp", ",", 
    RowBox[{"Partition", "[", 
     RowBox[{
      RowBox[{"ArrayPad", "[", 
       RowBox[{"list", ",", "2"}], "]"}], ",", "5", ",", "1"}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RunCode20Interped", "[", "interp_", "]"}], "[", 
   RowBox[{"list_", ",", " ", "steps_"}], "]"}], ":=", 
  RowBox[{"NestList", "[", 
   RowBox[{
    RowBox[{"StepCode20Interped", "[", "interp", "]"}], ",", " ", "list", ",",
     " ", "steps"}], "]"}]}], "\[IndentingNewLine]", 
