 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"frames", ",", " ", 
      RowBox[{"NumericArray", "[", 
       RowBox[{"o", ",", " ", "\"\<Real32\>\""}], "]"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"new", "=", 
