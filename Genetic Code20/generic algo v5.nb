Cell[BoxData[{
 RowBox[{"Clear", "[", "LossPeriodic", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LossPeriodic", "[", 
     RowBox[{"interp_", ",", " ", "p_"}], "]"}], "[", "list_", "]"}], ":=", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"carun", "=", 
       RowBox[{
        RowBox[{"RunCode20Interped", "[", "interp", "]"}], "[", 
        RowBox[{"list", ",", " ", "p"}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{"Last", "[", "carun", "]"}], "-", "list"}], "]"}], "-", 
      RowBox[{"Max", "[", "list", "]"}], "-", 
      RowBox[{"0.1", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"carun", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", "list"}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Divisors", "[", "p", "]"}], ",", " ", 
             RowBox[{"{", "p", "}"}]}], "]"}]}], "}"}]}], "]"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LossPeriodic", "[", 
   RowBox[{"LinearSumInterpolation", ",", " ", "2"}], "]"}], "[", 
  RowBox[{"{", 
