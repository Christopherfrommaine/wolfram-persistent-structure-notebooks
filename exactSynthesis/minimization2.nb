}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "Example", "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fmap", "=", 
   RowBox[{"Boole", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"tot", "=", 
