Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SplitOnVariable", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Unprotect", "[", "Xor", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"Xor", ",", " ", "Listable"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Protect", "[", "Xor", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SplitOnVariable", "[", 
    RowBox[{"fmap_List", ",", "k_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Log2", "[", 
         RowBox[{"Length", "[", "fmap", "]"}], "]"}]}], ",", 
       RowBox[{"upper", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"lower", "=", 
        RowBox[{"{", "}"}]}], ",", "bits"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"bits", "=", 
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"i", ",", "2", ",", "n"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"bits", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "==", "0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"upper", ",", 
             RowBox[{"fmap", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"lower", ",", 
             RowBox[{"fmap", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}]}], 
          "\[IndentingNewLine]", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{
           RowBox[{"Length", "[", "fmap", "]"}], "-", "1"}]}], "}"}]}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"upper", ",", "lower"}], "}"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ShannonArbitraryOrdered", "[", 
     RowBox[{"fmap_List", ",", "vars_List"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"ShannonArbitraryOrdered", "[", 
      RowBox[{"fmap", ",", "vars"}], "]"}], "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "n", ",", "candidates", ",", "upper", ",", "lower", ",", "xorVector", 
         ",", "upperExpr", ",", "xorExpr", ",", "remainingVars"}], "}"}], ",", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "vars", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "==", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"First", "[", "fmap", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"candidates", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"upper", ",", "lower"}], "}"}], "=", 
             RowBox[{"SplitOnVariable", "[", 
              RowBox[{"fmap", ",", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"xorVector", "=", 
             RowBox[{"Xor", "[", 
              RowBox[{"upper", ",", "lower"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"remainingVars", "=", 
             RowBox[{"Delete", "[", 
              RowBox[{"vars", ",", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"upperExpr", "=", 
             RowBox[{"ShannonArbitraryOrdered", "[", 
              RowBox[{"upper", ",", "remainingVars"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"xorExpr", "=", 
             RowBox[{"ShannonArbitraryOrdered", "[", 
              RowBox[{"xorVector", ",", "remainingVars"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Xor", "[", 
             RowBox[{"upperExpr", ",", 
              RowBox[{"And", "[", 
               RowBox[{
                RowBox[{"Slot", "[", 
                 RowBox[{"vars", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "]"}], ",", "xorExpr"}], 
               "]"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{"First", "@", 
          RowBox[{"MinimalBy", "[", 
           RowBox[{"candidates", ",", 
            RowBox[{"VertexCount", "@*", "ExpressionTree"}]}], "]"}]}], 
         "]"}]}]}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
