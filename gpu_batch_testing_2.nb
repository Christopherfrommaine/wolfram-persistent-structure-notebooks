Cell[BoxData[
 RowBox[{
  RowBox[{"myFunc2", "[", "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<OpenCLLink`\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Needs", "[", "\"\<CUDALink`\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"CUDAQ", "[", "]"}], ",", " ", 
        RowBox[{"CUDADriverVersion", "[", "]"}], ",", " ", "$CUDADevice", ",",
         " ", "$CUDAInstalledQ", ",", " ", "$CUDACompilerEnvironment", ",", 
        " ", "$CUDALinkExampleDataPath"}], "}"}], ",", "\[IndentingNewLine]", 
      
      RowBox[{"{", 
       RowBox[{
        RowBox[{"OpenCLQ", "[", "]"}], ",", " ", 
        RowBox[{"OpenCLInformation", "[", "]"}], ",", " ", 
        RowBox[{"SystemInformation", "[", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "src", ",", " ", "fun", ",", " ", "width", ",", " ", "height", ",", 
          " ", "global0Id", ",", " ", "global1Id", ",", " ", "res"}], "}"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "src", "=", "\"\<__kernel void myKernel( __global mint * global0Id, \
__global mint * global1Id, mint width, mint height) {\n    int xIndex = \
get_global_id(0);\n    int yIndex = get_global_id(1);\n    int index = xIndex \
+ yIndex*width;\n\tif (xIndex < width && yIndex < height) {\n\t   \
global0Id[index] = get_local_id(0);\n       global1Id[index] = \
get_local_id(1);\n    }\n  }\>\""}], ";", "\[IndentingNewLine]", 
         RowBox[{"fun", "=", 
          RowBox[{"OpenCLFunctionLoad", "[", 
           RowBox[{"src", ",", "\"\<myKernel\>\"", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "_Integer", "}"}], ",", 
              RowBox[{"{", "_Integer", "}"}], ",", "_Integer", ",", 
              "_Integer"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"width", "=", "16"}], ";", "\[IndentingNewLine]", 
         RowBox[{"height", "=", "16"}], ";", "\[IndentingNewLine]", 
         RowBox[{"global0Id", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"{", 
             RowBox[{"width", ",", "height"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"global1Id", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"{", 
             RowBox[{"width", ",", "height"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"res", "=", 
          RowBox[{"fun", "[", 
           RowBox[{
           "global0Id", ",", " ", "global1Id", ",", "width", ",", "height"}], 
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"ArrayPlot", "/@", "res"}]}]}], "\[IndentingNewLine]", "]"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "code", ",", " ", "cudaFun", ",", " ", "listSize", ",", " ", "A", ",",
           " ", "B", ",", " ", "res"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "code", "=", "\"\<\n__global__ void addTwo(mint * in, mint * out, \
mint length) {\n\tint index = threadIdx.x + blockIdx.x*blockDim.x;\n\tif \
(index < length)\n\t\tout[index] = in[index] + 2;\n}\>\""}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"cudaFun", "=", 
          RowBox[{"CUDAFunctionLoad", "[", 
           RowBox[{"code", ",", "\"\<addTwo\>\"", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"_Integer", ",", "_", ",", "\"\<Input\>\""}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"_Integer", ",", "_", ",", "\"\<Output\>\""}], "}"}], ",",
               "_Integer"}], "}"}], ",", "256", ",", 
            RowBox[{"\"\<ShellOutputFunction\>\"", "\[Rule]", "Print"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"listSize", " ", "=", " ", "1000"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"A", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", 
            RowBox[{"{", "listSize", "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"B", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", 
            RowBox[{"{", "listSize", "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"res", "=", 
          RowBox[{"cudaFun", "[", 
           RowBox[{"A", ",", "B", ",", "listSize"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"First", "@", "res"}], ",", "20"}], "]"}]}]}], 
       "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "src", ",", " ", "fun", ",", " ", "width", ",", " ", "height", ",", 
          " ", "global0Id", ",", " ", "global1Id", ",", " ", "res"}], "}"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "src", "=", "\"\<__kernel void myKernel( __global mint * global0Id, \
__global mint * global1Id, mint width, mint height) {\n    int xIndex = \
get_global_id(0);\n    int yIndex = get_global_id(1);\n    int index = xIndex \
+ yIndex*width;\n\tif (xIndex < width && yIndex < height) {\n\t   \
global0Id[index] = get_local_id(0);\n       global1Id[index] = \
get_local_id(1);\n    }\n  }\>\""}], ";", "\[IndentingNewLine]", 
         RowBox[{"fun", "=", 
          RowBox[{"CUDAFunctionLoad", "[", 
           RowBox[{"src", ",", "\"\<myKernel\>\"", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "_Integer", "}"}], ",", 
              RowBox[{"{", "_Integer", "}"}], ",", "_Integer", ",", 
              "_Integer"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"width", "=", "16"}], ";", "\[IndentingNewLine]", 
         RowBox[{"height", "=", "16"}], ";", "\[IndentingNewLine]", 
         RowBox[{"global0Id", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"{", 
             RowBox[{"width", ",", "height"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"global1Id", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"{", 
             RowBox[{"width", ",", "height"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"res", "=", 
          RowBox[{"fun", "[", 
           RowBox[{
           "global0Id", ",", " ", "global1Id", ",", "width", ",", "height"}], 
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"ArrayPlot", "/@", "res"}]}]}], "\[IndentingNewLine]", 
       "]"}]}], "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", 
   ")"}]}]], "Input",
