        "\[IndentingNewLine]", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"o", "=", "n"}], ",", " ", "count", ",", " ", "accum"}], 
           "}"}], ",", "\[IndentingNewLine]", 
