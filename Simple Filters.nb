                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}], ",", " ", 
                   RowBox[{"BitOr", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
                "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"EvenQ", "[", "o", "]"}], "&&", 
              RowBox[{"o", "!=", "0"}]}], ",", " ", 
             RowBox[{"o", "=", 
              RowBox[{"BitShiftRight", "[", "o", "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{"accum", "=", "o"}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"o", "!=", "0"}], "&&", 
              RowBox[{"accum", "!=", "0"}], "&&", 
              RowBox[{"count", "<=", "maxPeriod"}], "&&", 
              RowBox[{
               RowBox[{"BitAnd", "[", 
                RowBox[{"o", ",", " ", 
                 RowBox[{"TypeHint", "[", 
                  RowBox[{
                  "16140901064495857664", ",", 
                   " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], "]"}], "==", 
