Cell[BoxData[
 RowBox[{
  RowBox[{"GenerateFilter1", "[", 
   RowBox[{"steps_Integer", ":", "100"}], "]"}], ":=", "\[IndentingNewLine]", 
  
  RowBox[{"FunctionCompile", "[", 
   RowBox[{
    RowBox[{"Function", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Typed", "[", 
       RowBox[{"n", ",", " ", "\"\<UnsignedInteger64\>\""}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"count", "=", "0"}], ",", " ", 
          RowBox[{"o", "=", "n"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"o", "!=", "0"}], "&&", 
            RowBox[{
             RowBox[{"BitAnd", "[", 
              RowBox[{"o", ",", " ", 
               RowBox[{"TypeHint", "[", 
                RowBox[{
                "17293822569102704640", ",", 
                 " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], "]"}], "==", 
             "0"}], "&&", 
            RowBox[{"count", "<", "steps"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
            RowBox[{"o", "=", 
             RowBox[{"TypeHint", "[", 
              RowBox[{
               RowBox[{"With", "[", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"a", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "3"}], "]"}]}], ",", " ", 
                   RowBox[{"b", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "2"}], "]"}]}], ",", " ", 
                   RowBox[{"c", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "1"}], "]"}]}], ",", " ", 
                   RowBox[{"d", "=", 
                    RowBox[{"BitShiftRight", "[", 
                    RowBox[{"o", ",", " ", "1"}], "]"}]}]}], "}"}], ",", 
                 RowBox[{"BitXor", "[", 
                  RowBox[{
                   RowBox[{"BitXor", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}], ",", " ", 
                   RowBox[{"BitOr", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
                "]"}], ",", " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], 
            ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"o", "!=", "0"}]}]}], "\[IndentingNewLine]", "]"}]}], 
     "\[IndentingNewLine]", "]"}], ",", " ", 
    RowBox[{"CompilerOptions", "->", 
     RowBox[{"{", 
