                    RowBox[{"BitShiftRight", "[", 
                    RowBox[{"o", ",", " ", "1"}], "]"}]}]}], "}"}], ",", 
                 RowBox[{"BitXor", "[", 
                  RowBox[{
                   RowBox[{"BitXor", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}], ",", " ", 
                   RowBox[{"BitOr", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"EvenQ", "[", "o", "]"}], "&&", 
                 RowBox[{"o", "!=", "0"}]}], ",", " ", 
