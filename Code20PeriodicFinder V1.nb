Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"carun", "=", 
    RowBox[{"CellularAutomaton", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"20", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", "2"}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"list", ",", " ", "0"}], "}"}], ",", " ", "100"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"nx", "=", 
        RowBox[{"Length", "[", 
         RowBox[{"carun", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"ny", "=", 
        RowBox[{"Length", "[", "carun", "]"}]}]}], "}"}], ",", 
     RowBox[{"Graph", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"y", ",", " ", "x"}], "}"}], "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"y", "+", "1"}], ",", " ", "dx"}], "}"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", "nx"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"ny", "-", "1"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"dx", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"x", "-", "2"}], ",", " ", "0"}], "]"}], ",", " ", 
            RowBox[{"Min", "[", 
             RowBox[{
              RowBox[{"x", "+", "2"}], ",", " ", "nx"}], "]"}]}], "}"}]}], 
         "]"}], ",", " ", "3"}], "]"}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"deletepoints", "=", 
  RowBox[{"Join", "@@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", "+", "1"}], ",", "#"}], "}"}], "&"}], "/@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Plus", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"SequencePosition", "[", 
             RowBox[{
              RowBox[{"carun", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
               "}"}]}], "]"}], "]"}], "+", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1"}], "}"}]}], ")"}]}], "/", "2"}], 
       ")"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{
        RowBox[{"Length", "[", "carun", "]"}], "-", "1"}]}], "}"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"deletepoints", "=", 
   RowBox[{"CreateDataStructure", "[", 
    RowBox[{"\"\<HashSet\>\"", ",", " ", "deletepoints"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"Graph", "[", 
    RowBox[{"ParallelSelect", "[", 
     RowBox[{
      RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"deletepoints", "[", 
           RowBox[{"\"\<MemberQ\>\"", ",", " ", 
            RowBox[{"First", "[", "#", "]"}]}], "]"}], "||", " ", 
          RowBox[{"deletepoints", "[", 
           RowBox[{"\"\<MemberQ\>\"", ",", " ", 
            RowBox[{"Last", "[", "#", "]"}]}], "]"}]}], ")"}]}], "&"}]}], 
     "]"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "g"}], "Input",
