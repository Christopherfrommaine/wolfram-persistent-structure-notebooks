             ";", "\[IndentingNewLine]", 
             RowBox[{"seen", "=", 
              RowBox[{"CreateDataStructure", "[", "\"\<HashSet\>\"", "]"}]}], 
             ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"Do", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
