                    "64"}], "]"}]}], "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", 
                "\[IndentingNewLine]", 
                RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
                RowBox[{"PrintIf", "[", 
                 RowBox[{"count", ",", "\"\< \>\"", ",", " ", 
                  RowBox[{"count", "<", "maxIters1"}], ",", "\"\< \>\"", ",", 
                  
                  RowBox[{"o", "!=", "0"}], ",", "\"\< \>\"", ",", 
                  RowBox[{"BitAnd", "[", 
