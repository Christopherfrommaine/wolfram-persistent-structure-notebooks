               RowBox[{"Print", "[", "booleanrule", "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"booleanbitrule", "=", 
              RowBox[{"booleanrule", "/.", 
               RowBox[{"Join", "[", 
                RowBox[{
