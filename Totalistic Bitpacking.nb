       "\[IndentingNewLine]", 
       RowBox[{"r", "=", 
        RowBox[{"ra", "[", "\"\<Radius\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"ra", "[", "\"\<Number\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"diameter", "=", 
        RowBox[{
         RowBox[{"2", "r"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"maxsum", "=", 
        RowBox[{"diameter", "*", 
