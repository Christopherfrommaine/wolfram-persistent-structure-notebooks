Cell[BoxData[{
 RowBox[{"Clear", "[", "DecentRunLength", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DecentRunLength", "[", 
   RowBox[{"rule_", ",", " ", "init_", ",", " ", "k_", ",", " ", 
    RowBox[{"default_", ":", "400"}], ",", 
    RowBox[{"dieoutcheck_", ":", "3000"}]}], "]"}], ":=", 
  RowBox[{"With", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", "=", 
      RowBox[{"Length", "[", 
       RowBox[{
        RowBox[{"FindTransientRepeat", "[", 
         RowBox[{
          RowBox[{"StripZeros", "/@", 
           RowBox[{"CellularAutomaton", "[", 
            RowBox[{"rule", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"IntegerDigits", "[", 
                RowBox[{"init", ",", " ", "k"}], "]"}], ",", " ", "0"}], 
              "}"}], ",", " ", "100"}], "]"}]}], ",", " ", "2"}], "]"}], "[", 
        
        RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], ",", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"p", "!=", "0"}], ",", " ", 
      RowBox[{"40", "+", 
       RowBox[{"3", "*", "p"}]}], ",", " ", "\[IndentingNewLine]", 
      RowBox[{"If", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"CellularAutomaton", "[", 
           RowBox[{"rule", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"IntegerDigits", "[", 
               RowBox[{"init", ",", " ", "k"}], "]"}], ",", " ", "0"}], "}"}],
             ",", " ", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"{", "dieoutcheck", "}"}], "}"}], "}"}]}], "]"}], "]"}],
          "==", "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{"5", "+", 
         RowBox[{"Round", "[", 
          RowBox[{"1.2", "*", 
           RowBox[{"Length", "[", "\[IndentingNewLine]", 
            RowBox[{"StripZeros", "[", 
