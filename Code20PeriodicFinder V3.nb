Cell[BoxData[{
 RowBox[{
  RowBox[{"MaxGapLength", "=", 
   RowBox[{"FunctionCompile", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"Typed", "[", 
        RowBox[{"list", ",", " ", 
         RowBox[{"\"\<PackedArray\>\"", "::[", 
          RowBox[{"\"\<MachineInteger\>\"", ",", " ", "1"}], "]"}]}], "]"}], ",", 
       RowBox[{"Module", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"currentlen", "=", "0"}], ",", " ", 
           RowBox[{"maxlen", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"currentlen", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"i", "==", "0"}], ",", " ", 
                RowBox[{"currentlen", "+", "1"}], ",", "0"}], "]"}]}], ";", 
             " ", 
             RowBox[{"maxlen", "=", 
              RowBox[{"Max", "[", 
               RowBox[{"maxlen", ",", " ", "currentlen"}], "]"}]}], ";"}], ",",
             " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", "list"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "maxlen"}]}], "\[IndentingNewLine]", "]"}]}],
       "]"}], ",", " ", 
     RowBox[{"CompilerOptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<LLVMOptimization\>\"", "->", 
         RowBox[{"\"\<ClangOptimization\>\"", "[", "3", "]"}]}], ",", " ", 
        RowBox[{"\"\<AbortHandling\>\"", "->", "False"}], ",", " ", 
        RowBox[{"\"\<OptimizationLevel\>\"", "->", "3"}], ",", 
        RowBox[{"\"\<InvocationMode\>\"", "->", "\"\<Standalone\>\""}]}], 
       "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"RepeatedTiming", "[", 
