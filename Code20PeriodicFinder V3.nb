Cell[BoxData[{
 RowBox[{
  RowBox[{"SplitSeparateSolutions", "[", "carun_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "mask", ",", " ", "mc", ",", " ", "colors", ",", " ", "carunpadded"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"carunpadded", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ArrayPad", "[", 
         RowBox[{"#", ",", " ", "1"}], "]"}], "&"}], "/@", "carun"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mask", "=", 
      RowBox[{
       RowBox[{"carunpadded", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"1", ";;", 
           RowBox[{"-", "3"}]}]}], "]"}], "]"}], "+", 
       RowBox[{"carunpadded", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"2", ";;", 
           RowBox[{"-", "2"}]}]}], "]"}], "]"}], "+", 
       RowBox[{"carunpadded", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"3", ";;", 
           RowBox[{"-", "1"}]}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mc", "=", 
      RowBox[{"Last", "[", 
       RowBox[{"MorphologicalComponents", "[", 
        RowBox[{
         RowBox[{"Image", "[", "mask", "]"}], ",", " ", 
         RowBox[{"CornerNeighbors", "->", "False"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"colors", "=", 
      RowBox[{"Union", "[", "mc", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Unitize", "[", 
            RowBox[{"c", "-", "mc"}], "]"}]}], ")"}], "*", 
         RowBox[{"carun", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "colors"}], "}"}]}], "]"}], "/.", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", "..."}], "}"}], "->", "Nothing"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
