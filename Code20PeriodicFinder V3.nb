Cell[BoxData[
 RowBox[{
  RowBox[{"DetectPeriod", "[", 
   RowBox[{"rule_", ",", " ", "list_", ",", " ", 
    RowBox[{"steps_", ":", "120"}], ",", " ", 
    RowBox[{"maxdepth_", ":", "10"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "carun", ",", " ", "frd", ",", " ", "separatesolutions", ",", " ", 
      "period", ",", " ", "canonical", ",", " ", "shift"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"maxdepth", "<=", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<Possible Glider Gun: \>\"", ",", " ", 
               RowBox[{"FromDigits", "[", 
                RowBox[{"list", ",", " ", 
                 RowBox[{"rule", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Return", "[", 
              RowBox[{"{", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Period\>\"", "->", "0"}], ",", " ", 
                 RowBox[{"\"\<Canonical\>\"", "->", 
                  RowBox[{"FromDigits", "[", 
                   RowBox[{"list", ",", " ", 
                    RowBox[{"rule", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], ",",
                  " ", 
                 RowBox[{"\"\<Shift\>\"", "->", "0"}], ",", " ", 
                 RowBox[{"\"\<IsGliderGun\>\"", "->", "True"}]}], "|>"}], 
               "}"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"carun", "=", 
           RowBox[{"RunCA", "[", 
            RowBox[{"rule", ",", " ", "list", ",", " ", "steps"}], "]"}]}], 
          ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"If", " ", "it", " ", "dies"}], ",", " ", "return"}], " ", 
          "*)"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"carun", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "]"}], "==", "0"}], ",", " ", 
           RowBox[{"Return", "[", 
            RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Detect", " ", "Periodicity"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"frd", "=", 
          RowBox[{"FindRepeatDeterministic", "[", 
           RowBox[{"StripZeros", "/@", "carun"}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "If", " ", "unfinished", " ", "and", " ", "probably", " ", 
           "unseparated"}], ",", " ", 
          RowBox[{"recurse", " ", "with", " ", "more", " ", "steps"}]}], " ", 
         "*)"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "frd", "]"}], "==", "0"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"MaxGapLength", "[", 
               RowBox[{"carun", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], "]"}], ">", "5"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"separatesolutions", "=", 
               RowBox[{"SplitSeparateSolutions", "[", "carun", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Join", "@@", 
               RowBox[{"Table", "[", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"DetectPeriod", "[", 
                  RowBox[{"subsolution", ",", " ", "steps", ",", " ", 
                   RowBox[{"maxdepth", "-", "1"}]}], "]"}], ",", 
                 "\[IndentingNewLine]", " ", 
                 RowBox[{"{", 
                  RowBox[{"subsolution", ",", " ", "separatesolutions"}], 
                  "}"}]}], "\[IndentingNewLine]", "]"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"DetectPeriod", "[", 
              RowBox[{
               RowBox[{"carun", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"2", " ", "*", " ", "steps"}], ",", " ", 
               RowBox[{"maxdepth", " ", "-", " ", "1"}]}], "]"}]}], 
            "\[IndentingNewLine]", "]"}], "]"}]}], "\[IndentingNewLine]", 
         "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Otherwise", ",", " ", 
          RowBox[{
          "run", " ", "again", " ", "for", " ", "pure", " ", 
           "periodicity"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"carun", "=", 
         RowBox[{"RunCA", "[", 
          RowBox[{"rule", ",", " ", 
           RowBox[{"carun", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", "steps"}], "]"}]}], 
        ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"If", " ", 
          RowBox[{"it", "'"}], "s", " ", "multiperiodic"}], ",", " ", 
         RowBox[{"split", " ", "solutions"}]}], " ", "*)"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"separatesolutions", "=", 
        RowBox[{"SplitSeparateSolutions", "[", "carun", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"separatesolutions", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{"separatesolutions", ",", 
          RowBox[{
           RowBox[{"First", "[", 
            RowBox[{"FirstPosition", "[", 
             RowBox[{"#", ",", " ", "1", ",", " ", "0"}], "]"}], "]"}], 
           "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Recurse", " ", "on", " ", "each", " ", "subsolution"}], ",", 
        " ", 
        RowBox[{"if", " ", "they", " ", "exist"}]}], " ", "*)"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "separatesolutions", "]"}], ">", "1"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"Join", "@@", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"DetectPeriod", "[", 
             RowBox[{"subsolution", ",", " ", "steps", ",", " ", 
              RowBox[{"maxdepth", "-", "1"}]}], "]"}], ",", 
            "\[IndentingNewLine]", " ", 
            RowBox[{"{", 
             RowBox[{"subsolution", ",", " ", "separatesolutions"}], "}"}]}], 
