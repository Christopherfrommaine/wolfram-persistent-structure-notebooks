Cell[CellGroupData[{

Cell["Large Solution Search:", "Subsubsection",
 CellChangeTimes->{{3.989328140445866*^9, 
  3.989328147434326*^9}},ExpressionUUID->"f474fa91-02ed-44ff-b98c-\
403b51e271fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Find", " ", "all", " ", "solutions", " ", "with", " ", "periods", " ", 
    "that", " ", 
    RowBox[{"aren", "'"}], "t", " ", "easy", " ", "to", " ", "find"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"numtosearch", "=", "3000000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"initwidth", "=", "500"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"easysolutionperiods", "=", 
     RowBox[{"{", 
      RowBox[{
      "0", ",", " ", "1", ",", " ", "2", ",", " ", "4", ",", " ", "9", ",", 
       " ", "22", ",", " ", "38"}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"include", " ", "9", " ", "and", " ", "22"}], ",", " ", 
     RowBox[{
     "then", " ", "4", " ", "and", " ", "38", " ", "for", " ", "longer", " ", 
      "searches"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"easysolutionperiods", "=", 
     RowBox[{"Dispatch", "[", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "->", "True"}], "&"}], "/@", "easysolutionperiods"}], ",",
         " ", 
        RowBox[{"_", "->", "False"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"found", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"DetectPeriod", "[", "#", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "\"\<Period\>\""}], "]"}], "]"}], ",",
              " ", 
             RowBox[{"elem", "|->", 
              RowBox[{"elem", "/.", "easysolutionperiods"}]}]}], "]"}], ",", 
           "Nothing", ",", "#"}], "]"}], "&"}], "[", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "initwidth"}], 
         "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "numtosearch"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{"ArrayPlot", "[", 
        RowBox[{"RunCode20", "[", 
         RowBox[{"sol", ",", " ", "200"}], "]"}], "]"}], ",", " ", 
       RowBox[{"ClickToCopy", "[", 
        RowBox[{
         RowBox[{"Values", "@", 
          RowBox[{"DetectPeriod", "[", "sol", "]"}]}], ",", " ", "sol"}], 
        "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"sol", ",", " ", 
       RowBox[{"found", "[", 
        RowBox[{"[", 
         RowBox[{";;", 
          RowBox[{"UpTo", "[", "25", "]"}]}], "]"}], "]"}]}], "}"}]}], 
    "]"}]}]}]], "Input",
