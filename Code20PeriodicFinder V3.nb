       "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Return", " ", "single"}], "-", 
       RowBox[{"solution", " ", "period"}]}], " ", "*)"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"period", "=", 
      RowBox[{"Length", "[", "frd", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"canonical", "=", 
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"FromDigits", "[", 
            RowBox[{
             RowBox[{"StripZeros", "[", "#", "]"}], ",", 
             RowBox[{"rule", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "]"}], "&"}], "/@",
           "frd"}], "]"}], ",", " ", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"FromDigits", "[", 
            RowBox[{
             RowBox[{"StripZeros", "[", 
              RowBox[{"Reverse", "[", "#", "]"}], "]"}], ",", 
             RowBox[{"rule", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "]"}], "&"}], "/@",
           "frd"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"carun", "=", 
      RowBox[{"RunCA", "[", 
       RowBox[{"rule", ",", " ", 
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"canonical", ",", 
          RowBox[{"rule", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "]"}], ",", " ", 
        "period"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"shift", "=", 
      RowBox[{"Log2", "[", 
       RowBox[{
        RowBox[{"FromDigits", "[", 
         RowBox[{
          RowBox[{"First", "[", "carun", "]"}], ",", " ", 
          RowBox[{"rule", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "]"}], "/", 
        RowBox[{"FromDigits", "[", 
         RowBox[{
          RowBox[{"Last", "[", "carun", "]"}], ",", " ", 
