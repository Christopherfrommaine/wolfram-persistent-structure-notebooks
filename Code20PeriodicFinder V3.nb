           RowBox[{"[", 
            RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Period\>\"", "->", "period"}], ",", 
         RowBox[{"\"\<Canonical\>\"", "->", "canonical"}], ",", " ", 
