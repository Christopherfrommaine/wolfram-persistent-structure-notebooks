Cell["\<\
But this is only linear. Why?\[LineSeparator]Because there is only one \
food-organism interface, and that\[CloseCurlyQuote]s the only place that \
organisms can reproduce.\
\>", "Text",
 CellChangeTimes->{{3.994172615159646*^9, 3.99417261809719*^9}, 
   3.99423775951194*^9},ExpressionUUID->"d1794495-1ab0-4de2-b137-\
d6fa9aedf813"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"RandomStringSubstitutionSystem", "[", 
   RowBox[{"rules_", ",", " ", "init_", ",", " ", "steps_"}], "]"}], ":=", 
  RowBox[{"NestList", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"StringReplace", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"RandomChoice", "[", "rules", "]"}]}], "]"}], "&"}], ",", " ", 
    "init", ",", " ", "steps"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RandomWeightedStringSubstitutionSystem", "[", 
   RowBox[{"wrules_", ",", " ", "init_", ",", " ", "steps_"}], "]"}], ":=", 
  RowBox[{"NestList", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"StringReplace", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"RandomChoice", "[", 
        RowBox[{"Rule", "@@", 
         RowBox[{"Transpose", "[", "wrules", "]"}]}], "]"}]}], "]"}], "&"}], ",",
     " ", "init", ",", " ", "steps"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.994175038255507*^9, 3.9941750881896763`*^9}, {
  3.994175135277557*^9, 3.994175139276853*^9}, {3.994175173847829*^9, 
