                   RowBox[{"EvenQ", "[", "o", "]"}], ",", " ", 
                   RowBox[{"o", "=", 
                    RowBox[{"BitShiftRight", "[", "o", "]"}]}]}], "]"}], ";", 
                 "\[IndentingNewLine]", 
