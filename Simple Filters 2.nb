Cell[CellGroupData[{

Cell["Filter 2: Detect Known Periodicity", "Section",
 CellChangeTimes->{{3.9896740540248423`*^9, 3.989674061275772*^9}, {
  3.989674706940938*^9, 
  3.989674713139308*^9}},ExpressionUUID->"965a1cb3-822a-4910-873b-\
2f0cc266cbc0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "GenerateMarkWithFilter2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GenerateMarkWithFilter2", "[", 
   RowBox[{
    RowBox[{"periodsToIgnore_List", ":", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "9"}], "}"}]}], ",", " ", 
    RowBox[{"initSteps_", ":", "200"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"maxPeriod", "=", 
      RowBox[{"2", 
       RowBox[{"Max", "[", "periodsToIgnore", "]"}]}]}], "}"}], ",", 
    RowBox[{"FunctionCompile", "[", 
     RowBox[{
      RowBox[{"Function", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Typed", "[", 
           RowBox[{"bv", ",", " ", "\"\<BitVector\>\""}], "]"}], ",", " ", 
          RowBox[{"Typed", "[", 
           RowBox[{"offset", ",", " ", "\"\<MachineInteger\>\""}], "]"}]}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"count", ",", " ", "o", ",", " ", "accum"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"BitVector`BitTest", "[", 
                RowBox[{"bv", ",", " ", "oOrig"}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
                RowBox[{"o", "=", 
                 RowBox[{"Cast", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"2", "*", 
                    RowBox[{"(", 
                    RowBox[{"oOrig", "+", "offset"}], ")"}]}], " ", "+", " ", 
                    "1"}], ",", " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], ";",
                 "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
                RowBox[{"While", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"o", "!=", "0"}], "&&", 
                   RowBox[{"count", "<", "initSteps"}], "&&", 
                   RowBox[{
