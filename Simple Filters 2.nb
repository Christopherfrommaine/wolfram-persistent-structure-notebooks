Cell[BoxData[{
 RowBox[{
  RowBox[{"maximum", "=", "100000000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stepSize", "=", 
    RowBox[{"maximum", "/", "100"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"batches", "=", 
    RowBox[{"Ceiling", "[", 
     RowBox[{"maximum", "/", "stepSize"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"res", "=", 
    RowBox[{"EchoTiming", "@", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "bv", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"bv", "=", 
           RowBox[{"CreateDataStructure", "[", 
            RowBox[{"\"\<BitVector\>\"", ",", " ", "stepSize"}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"bv", "[", "\"\<BitNot\>\"", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"MarkWithFilter1", "[", 
             RowBox[{"bv", ",", " ", "offset"}], "]"}], ",", " ", "offset"}], 
           "}"}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"offset", ",", " ", "0", ",", " ", 
         RowBox[{"maximum", "-", "1"}], ",", " ", "stepSize"}], "}"}]}], 
      "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"efficiency", "=", 
  RowBox[{"1", "-", 
