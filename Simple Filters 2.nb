                   RowBox[{"accum", ",", " ", "o"}], "]"}]}], ";"}]}], 
               "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"o", "==", "0"}], "||", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"accum", "==", "0"}], "&&", 
