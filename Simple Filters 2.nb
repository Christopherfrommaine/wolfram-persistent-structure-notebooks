 RowBox[{
  RowBox[{"Clear", "[", "GenerateMarkWithFilter3", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GenerateMarkWithFilter3", "[", 
   RowBox[{
    RowBox[{"periodsToIgnore_List", ":", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "9"}], "}"}]}], ",", " ", 
    RowBox[{"initSteps_", ":", "200"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"maxPeriod", "=", 
      RowBox[{"2", 
       RowBox[{"Max", "[", "periodsToIgnore", "]"}]}]}], "}"}], ",", 
    RowBox[{"FunctionCompile", "[", 
     RowBox[{
      RowBox[{"Function", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Typed", "[", 
           RowBox[{"bv", ",", " ", "\"\<BitVector\>\""}], "]"}], ",", " ", 
          RowBox[{"Typed", "[", 
           RowBox[{"offset", ",", " ", "\"\<MachineInteger\>\""}], "]"}]}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"count", ",", " ", "o", ",", " ", "accum"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
              RowBox[{"o", "=", 
               RowBox[{"Cast", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"2", "*", 
                   RowBox[{"(", 
                    RowBox[{"oOrig", "+", "offset"}], ")"}]}], " ", "+", " ", 
                  "1"}], ",", " ", "\"\<UnsignedInteger128\>\""}], "]"}]}], ";",
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"o", "!=", "0"}], "&&", 
                 RowBox[{"count", "<", "initSteps"}], "&&", 
                 RowBox[{
                  RowBox[{"BitAnd", "[", 
                   RowBox[{"o", ",", " ", 
                    RowBox[{"TypeHint", "[", 
                    RowBox[{
                    "297747071055821155530452781502797185024", ",", 
                    " ", "\"\<UnsignedInteger128\>\""}], "]"}]}], "]"}], "==",
                   "0"}]}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
