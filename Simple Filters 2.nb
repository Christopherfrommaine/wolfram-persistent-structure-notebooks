Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "GenerateMarkWithFilter1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GenerateMarkWithFilter1", "[", 
   RowBox[{"steps_Integer", ":", "200"}], "]"}], ":=", "\[IndentingNewLine]", 
  
  RowBox[{"FunctionCompile", "[", 
   RowBox[{
    RowBox[{"Function", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Typed", "[", 
         RowBox[{"bv", ",", " ", "\"\<BitVector\>\""}], "]"}], ",", " ", 
        RowBox[{"Typed", "[", 
         RowBox[{"offset", ",", " ", "\"\<MachineInteger\>\""}], "]"}]}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"count", ",", " ", "o"}], "}"}], ",", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"BitVector`BitTest", "[", 
              RowBox[{"bv", ",", " ", "oOrig"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
              RowBox[{"o", "=", 
               RowBox[{"Cast", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"2", "*", 
                   RowBox[{"(", 
                    RowBox[{"oOrig", "+", "offset"}], ")"}]}], " ", "+", " ", 
                  "1"}], ",", " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], ";",
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"o", "!=", "0"}], "&&", 
                 RowBox[{"count", "<", "steps"}], "&&", 
                 RowBox[{
                  RowBox[{"BitAnd", "[", 
                   RowBox[{"o", ",", " ", 
                    RowBox[{"TypeHint", "[", 
                    RowBox[{
                    "16140901064495857664", ",", 
                    " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], "]"}], "==", 
                  "0"}]}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"EvenQ", "[", "o", "]"}], ",", " ", 
                   RowBox[{"o", "=", 
                    RowBox[{"BitShiftRight", "[", "o", "]"}]}]}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"o", "=", 
                  RowBox[{"With", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"a", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "3"}], "]"}]}], ",", " ", 
                    RowBox[{"b", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "2"}], "]"}]}], ",", " ", 
                    RowBox[{"c", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "1"}], "]"}]}], ",", " ", 
                    RowBox[{"d", "=", 
                    RowBox[{"BitShiftRight", "[", 
                    RowBox[{"o", ",", " ", "1"}], "]"}]}]}], "}"}], ",", 
                    RowBox[{"BitXor", "[", 
                    RowBox[{
                    RowBox[{"BitXor", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}], ",", " ", 
                    RowBox[{"BitOr", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
                   "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"o", "==", "0"}], ",", " ", 
                RowBox[{"BitVector`BitInvert", "[", 
                 RowBox[{"bv", ",", " ", "oOrig"}], "]"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"oOrig", ",", "0", ",", " ", 
             RowBox[{
              RowBox[{"bv", "[", "\"\<Length\>\"", "]"}], "-", "1"}]}], 
            "}"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]",
          "bv"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
     "]"}], ",", 
    RowBox[{"CompilerOptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<LLVMOptimization\>\"", "->", 
        RowBox[{"\"\<ClangOptimization\>\"", "[", "3", "]"}]}], ",", 
       RowBox[{"\"\<OptimizationLevel\>\"", "->", "3"}]}], "}"}]}]}], 
   "]"}]}]}], "Input",
