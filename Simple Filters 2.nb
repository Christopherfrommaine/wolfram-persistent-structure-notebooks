                    " ", "\"\<UnsignedInteger128\>\""}], "]"}]}], "]"}], "==",
                   "0"}]}], ",", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
                 RowBox[{"o", "=", 
                  RowBox[{"With", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"a", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "3"}], "]"}]}], ",", " ", 
                    RowBox[{"b", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "2"}], "]"}]}], ",", " ", 
                    RowBox[{"c", "=", 
