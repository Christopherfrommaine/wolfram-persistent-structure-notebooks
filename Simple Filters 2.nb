Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "GenerateMarkWithFilter4", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GenerateMarkWithFilter4", "[", 
   RowBox[{
    RowBox[{"periodsToIgnore_List", ":", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "9"}], "}"}]}], ",", " ", 
    RowBox[{"initSteps_", ":", "200"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"maxPeriod", "=", 
      RowBox[{"2", 
       RowBox[{"Max", "[", "periodsToIgnore", "]"}]}]}], "}"}], ",", 
    RowBox[{"FunctionCompile", "[", 
     RowBox[{
      RowBox[{"Function", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Typed", "[", 
           RowBox[{"bv", ",", " ", "\"\<BitVector\>\""}], "]"}], ",", " ", 
          RowBox[{"Typed", "[", 
           RowBox[{"offset", ",", " ", "\"\<MachineInteger\>\""}], "]"}]}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "count", ",", " ", "o", ",", " ", "accum", ",", " ", "columns", ",",
             " ", "maxgaplength"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"BitVector`BitTest", "[", 
                RowBox[{"bv", ",", " ", "oOrig"}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
                RowBox[{"o", "=", 
                 RowBox[{"Cast", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"2", "*", 
                    RowBox[{"(", 
                    RowBox[{"oOrig", "+", "offset"}], ")"}]}], " ", "+", " ", 
                    "1"}], ",", " ", "\"\<UnsignedInteger128\>\""}], "]"}]}], 
                ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
                RowBox[{"While", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"o", "!=", "0"}], "&&", 
                   RowBox[{"count", "<", "initSteps"}], "&&", 
                   RowBox[{
                    RowBox[{"BitAnd", "[", 
                    RowBox[{"o", ",", " ", 
                    RowBox[{"TypeHint", "[", 
                    RowBox[{
                    "297747071055821155530452781502797185024", ",", 
                    " ", "\"\<UnsignedInteger128\>\""}], "]"}]}], "]"}], "==",
                     "0"}]}], ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"EvenQ", "[", "o", "]"}], ",", " ", 
                    RowBox[{"o", "=", 
                    RowBox[{"BitShiftRight", "[", "o", "]"}]}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"o", "=", 
                    RowBox[{"With", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"a", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "3"}], "]"}]}], ",", " ", 
                    RowBox[{"b", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "2"}], "]"}]}], ",", " ", 
                    RowBox[{"c", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "1"}], "]"}]}], ",", " ", 
                    RowBox[{"d", "=", 
                    RowBox[{"BitShiftRight", "[", 
                    RowBox[{"o", ",", " ", "1"}], "]"}]}]}], "}"}], ",", 
                    RowBox[{"BitXor", "[", 
                    RowBox[{
                    RowBox[{"BitXor", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}], ",", " ", 
                    RowBox[{"BitOr", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
                    "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{"While", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"EvenQ", "[", "o", "]"}], "&&", 
                   RowBox[{"o", "!=", "0"}]}], ",", " ", 
                  RowBox[{"o", "=", 
                   RowBox[{"BitShiftRight", "[", "o", "]"}]}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
                RowBox[{"accum", "=", "o"}], ";", "\[IndentingNewLine]", 
                RowBox[{"columns", "=", "o"}], ";", "\[IndentingNewLine]", 
                RowBox[{"While", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"o", "!=", "0"}], "&&", 
                   RowBox[{"accum", "!=", "0"}], "&&", 
                   RowBox[{"count", "<=", "maxPeriod"}], "&&", 
                   RowBox[{
                    RowBox[{"BitAnd", "[", 
                    RowBox[{"o", ",", " ", 
                    RowBox[{"TypeHint", "[", 
                    RowBox[{
                    "297747071055821155530452781502797185024", ",", 
                    " ", "\"\<UnsignedInteger128\>\""}], "]"}]}], "]"}], "==",
                     "0"}]}], ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"o", "=", 
                    RowBox[{"With", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"a", "=", 
