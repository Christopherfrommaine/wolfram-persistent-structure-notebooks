Notebook[{

Cell[CellGroupData[{
Cell["Goal", "Section",
 CellChangeTimes->{{3.989083796392585*^9, 3.9890838008000097`*^9}, {
  3.989085225213709*^9, 
  3.98908522563553*^9}},ExpressionUUID->"c19ac034-5b8f-4bde-952a-\
ab75bf478b45"],

Cell["\<\
DetectPeriod[start] separates an initial condition into separate solutions. 

For each solution, if it is a glider or periodic, it will return
{canonical representation, period, shift}

If a solution is a glider gun or grows otherwise, it will return
{start state, -1, 0}

If a solution dies, it will return
{0, 0, 0}\
\>", "Text",
 CellChangeTimes->{{3.9890838034080753`*^9, 3.98908383983519*^9}, {
  3.989084886301154*^9, 3.989084890226886*^9}, {3.989084984499354*^9, 
  3.989084989407139*^9}, {3.989085037812498*^9, 
  3.9890852143233*^9}},ExpressionUUID->"12d8d8f2-905a-4dcc-90ad-439fdc2c0fb0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Helpers", "Section",
 CellChangeTimes->{{3.989085229796719*^9, 
  3.989085230645185*^9}},ExpressionUUID->"3dab3593-80db-4ae4-a0b1-\
cf68be58d355"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"StripZeros", "[", "list_List", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"MemberQ", "[", 
      RowBox[{"list", ",", " ", "0"}], "]"}], ",", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", " ", 
         RowBox[{"j", "=", 
          RowBox[{"Length", "[", "list", "]"}]}]}], "}"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"list", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "==", "0"}], ";", " ", 
          RowBox[{"i", "++"}]}], "]"}], ";", "\[IndentingNewLine]", " ", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"list", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "==", "0"}], ";", " ", 
          RowBox[{"j", "--"}]}], "]"}], ";", " ", "\[IndentingNewLine]", 
        RowBox[{"list", "[", 
         RowBox[{"[", 
          RowBox[{"i", ";;", "j"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
      "]"}], ",", "list"}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"First", "[", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", "=", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "100"}], "]"}], "^",
         "4"}], "]"}]}], "}"}], ",", 
    RowBox[{"RepeatedTiming", "[", 
     RowBox[{"StripZeros", "[", "r", "]"}], "]"}]}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9890852418900967`*^9, 3.989085459736813*^9}, {
  3.9890899160418873`*^9, 3.989089920162548*^9}, {3.989090010740673*^9, 
  3.9890900351954412`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"5eb671ab-8171-442d-9f39-0d6b5c089995"],

Cell[BoxData["9.396286010742187`*^-6"], "Output",
 CellChangeTimes->{{3.9890852662327023`*^9, 3.9890853112352657`*^9}, 
   3.9890854027252083`*^9, {3.989085435489674*^9, 3.989085469449822*^9}, 
   3.989089928305393*^9, {3.989090033908338*^9, 3.989090037189209*^9}, 
   3.9890933463325377`*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"d28171e0-92ad-43b9-a200-91c698de60a6"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FindTransientDeterministicRepeats", "[", "list_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"seen", "=", 
        RowBox[{"CreateDataStructure", "[", "\"\<HashTable\>\"", "]"}]}], ",",
        " ", 
       RowBox[{"i", "=", "1"}], ",", " ", "period", ",", " ", "last"}], "}"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"While", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"seen", "[", 
          RowBox[{"\"\<KeyExistsQ\>\"", ",", " ", 
           RowBox[{"list", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", " ", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"seen", "[", 
          RowBox[{"\"\<Insert\>\"", ",", "  ", 
           RowBox[{
            RowBox[{"list", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "->", "i"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", ">", 
            RowBox[{"Length", "[", "list", "]"}]}], ",", " ", 
           RowBox[{"Return", "[", 
            RowBox[{"{", 
             RowBox[{"list", ",", " ", 
              RowBox[{"{", "}"}]}], "}"}], "]"}]}], "]"}]}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"last", "=", 
       RowBox[{"seen", "[", 
        RowBox[{"\"\<Lookup\>\"", ",", " ", 
         RowBox[{"list", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"period", "=", 
       RowBox[{"i", "-", "last", "-", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"list", "[", 
         RowBox[{"[", 
          RowBox[{";;", "last"}], "]"}], "]"}], ",", " ", 
        RowBox[{"list", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"last", "+", "1"}], ";;", 
           RowBox[{"last", "+", "period"}]}], "]"}], "]"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->CompressedData["
