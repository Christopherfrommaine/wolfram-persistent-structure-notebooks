Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GoodRuleCondition", "[", " ", 
      RowBox[{"K_", ",", " ", "R_"}], "]"}], "[", "rule_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"Last", "[", 
         RowBox[{"CellularAutomaton", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rule", ",", " ", "K", ",", " ", "R"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{
               RowBox[{"K", "-", "1"}], ",", "100"}], "]"}], ",", "0"}], 
            "}"}], ",", "100"}], "]"}], "]"}], "]"}], ">", "150"}], ",", 
      "False", ",", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"StripZeros", "[", 
              RowBox[{"CellularAutomaton", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"rule", ",", " ", "K", ",", " ", "R"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"RandomInteger", "[", 
                   RowBox[{
                    RowBox[{"K", "-", "1"}], ",", "100"}], "]"}], ",", "0"}], 
                 "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"{", 
                  RowBox[{"{", "100", "}"}], "}"}], "}"}]}], "]"}], "]"}], 
             "]"}], ",", "10"}], "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Mean", "[", "l", "]"}], "<", "100"}], "&&", 
         RowBox[{
          RowBox[{"Min", "[", "l", "]"}], "\[Equal]", "0"}], "&&", 
         RowBox[{
          RowBox[{"Max", "[", "l", "]"}], "<", "150"}], "&&", 
         RowBox[{
          RowBox[{"Max", "[", "l", "]"}], ">", "0"}]}]}], "]"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RandomGoodRules", "[", 
    RowBox[{"n_", ",", " ", 
     RowBox[{"K_", ":", "2"}], ",", 
     RowBox[{"R_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"ParallelSelect", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rule", "=", 
            RowBox[{
             RowBox[{"rca", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"K", ",", "R"}], "}"}], ",", 
               RowBox[{"\"\<Quiescent\>\"", "\[Rule]", "True"}], ",", 
               RowBox[{"\"\<Type\>\"", "\[Rule]", "\"\<Symmetric\>\""}]}], 
              "]"}], "[", "\"\<RuleNumber\>\"", "]"}]}], "}"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"GoodRuleCondition", "[", "rule", "]"}], ",", "rule", ",",
             "Nothing"}], "]"}]}], "]"}], "&"}], ",", 
       RowBox[{"n", "/", "14"}]}], "]"}], ",", " ", "14"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RandomGoodRules", "[", 
   RowBox[{"n_", ",", " ", 
    RowBox[{"K_", ":", "2"}], ",", " ", 
    RowBox[{"R_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#", ",", " ", "K", ",", " ", "R"}], "}"}], "&"}], "/@", 
   RowBox[{"ParallelSelect", "[", 
    RowBox[{
     RowBox[{"Union", "@", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"rca", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"K", ",", "R"}], "}"}], ",", 
           RowBox[{"\"\<Quiescent\>\"", "\[Rule]", "True"}], ",", 
           RowBox[{"\"\<Type\>\"", "\[Rule]", "\"\<Symmetric\>\""}]}], "]"}], 
         "[", "\"\<RuleNumber\>\"", "]"}], ",", " ", "n"}], "]"}]}], ",", " ", 
     RowBox[{"GoodRuleCondition", "[", 
      RowBox[{"K", ",", " ", "R"}], "]"}]}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.992700812405002*^9, 3.9927009886413927`*^9}, {
