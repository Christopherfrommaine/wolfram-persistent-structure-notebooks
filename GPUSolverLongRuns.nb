Notebook[{
Cell[BoxData[{
 RowBox[{"Clear", "[", "ProgressMap", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f_", ",", " ", "l_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"stdout", "=", 
       RowBox[{"PrintTemporary", "[", "\"\<\>\"", "]"}]}], ",", " ", 
      RowBox[{"len", "=", 
       RowBox[{"Length", "[", "l", "]"}]}], ",", " ", 
      RowBox[{"begin", "=", 
       RowBox[{"TimeObject", "[", "]"}]}], ",", " ", "cur", ",", " ", "avg", ",",
       "eta"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"NotebookDelete", "[", "stdout", "]"}], ";", " ", 
       RowBox[{"cur", "=", 
        RowBox[{"TimeObject", "[", "]"}]}], ";", 
       RowBox[{"avg", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"cur", "-", "begin"}], ")"}], "/", "i"}]}], ";", 
       RowBox[{"eta", "=", 
        RowBox[{"begin", "+", 
         RowBox[{"len", "*", "avg"}]}]}], ";", 
       RowBox[{"stdout", "=", 
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Step \>\"", "<>", 
          RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\</\>\"", "<>", 
          RowBox[{"ToString", "[", "len", "]"}], "<>", "\"\< (\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"N", "[", 
            RowBox[{"100", "*", 
             RowBox[{"i", "/", "len"}]}], "]"}], "]"}], 
          "<>", "\"\<% complete, Avg Time \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"QuantityMagnitude", "[", 
            RowBox[{"avg", ",", "\"\<Seconds\>\""}], "]"}], "]"}], 
          "<>", "\"\< seconds per elem, ETA \>\"", "<>", 
          RowBox[{"DateString", "[", 
           RowBox[{"eta", ",", " ", "\"\<DateTimeShort\>\""}], "]"}], 
          "<>", "\"\<)\>\""}], "]"}]}], ";", " ", 
       RowBox[{"f", "[", 
        RowBox[{"l", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "len"}], "}"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f_", ",", " ", "l_Integer"}], "]"}], ":=", 
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f", ",", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", "l"}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9926969859242363`*^9, 3.992697165510667*^9}, {
   3.992739332098557*^9, 3.992739335508335*^9}, {3.9927394632072697`*^9, 
