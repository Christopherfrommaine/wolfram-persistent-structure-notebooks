  RowBox[{
   RowBox[{
    RowBox[{"And", "[", 
     RowBox[{
      RowBox[{"Not", "[", "a_", "]"}], ",", 
      RowBox[{"Not", "[", "b_", "]"}]}], "]"}], "->", 
    RowBox[{"Not", "[", 
     RowBox[{"Or", "[", 
      RowBox[{"a", ",", "b"}], "]"}], "]"}]}], ",", 
   RowBox[{
    RowBox[{"Or", "[", 
     RowBox[{
      RowBox[{"Not", "[", "a_", "]"}], ",", 
      RowBox[{"Not", "[", "b_", "]"}]}], "]"}], "->", 
    RowBox[{"Not", "[", 
     RowBox[{"And", "[", 
      RowBox[{"a", ",", "b"}], "]"}], "]"}]}], ",", 
   RowBox[{
    RowBox[{"Xor", "[", 
     RowBox[{
      RowBox[{"And", "[", 
       RowBox[{"x1_", ",", "y_"}], "]"}], ",", 
      RowBox[{"And", "[", 
       RowBox[{"x2_", ",", "y_"}], "]"}], ",", "z___"}], "]"}], "->", 
    RowBox[{"And", "[", 
     RowBox[{"y", ",", 
      RowBox[{"Xor", "[", 
       RowBox[{"x1", ",", "x2", ",", "z"}], "]"}]}], "]"}]}]}], 
  "}"}]], "Input",
 CellChangeTimes->{{3.9944157223669558`*^9, 3.994415722366972*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"5943fa66-28a6-4ac2-a179-742151ebae62"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"!", "a_"}], "&&", 
     RowBox[{"!", "b_"}]}], "\[Rule]", 
    RowBox[{"!", 
     RowBox[{"(", 
      RowBox[{"a", "||", "b"}], ")"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"!", "a_"}], "||", 
     RowBox[{"!", "b_"}]}], "\[Rule]", 
    RowBox[{"!", 
     RowBox[{"(", 
      RowBox[{"a", "&&", "b"}], ")"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x1_", "&&", "y_"}], ")"}], "\[Xor]", 
     RowBox[{"(", 
      RowBox[{"x2_", "&&", "y_"}], ")"}], "\[Xor]", "z___"}], "\[Rule]", 
    RowBox[{"y", "&&", 
     RowBox[{"(", 
      RowBox[{"x1", "\[Xor]", "x2", "\[Xor]", "z"}], ")"}]}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.99441588429611*^9, 3.994415933775414*^9},
 CellLabel->"Out[88]=",ExpressionUUID->"319eace7-412a-4117-90b0-762adcca6550"]
}, Open  ]],

