d64fec486e2f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rcr", "=", 
   RowBox[{
   "ResourceFunction", "[", "\"\<RandomCellularAutomatonRule\>\"", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.991253643866187*^9, 3.991253650503407*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"f966aa3b-9632-4c53-b53a-9bd7b599d9e1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"initialConditions", "=", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"1", ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "40"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"r1", "=", 
    RowBox[{"ParallelMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"Unitize", "[", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"Total", "[", 
                  RowBox[{"CellularAutomaton", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"#", ",", " ", "2", ",", " ", "2"}], "}"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"IntegerDigits", "[", 
                    RowBox[{"i", ",", " ", "2"}], "]"}], ",", " ", "0"}], 
                    "}"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{"{", "300", "}"}], "}"}], "}"}]}], "]"}], "]"}], ",",
                  " ", 
                 RowBox[{"{", 
                  RowBox[{
                  "i", ",", " ", "1", ",", " ", "200", ",", " ", "2"}], 
                  "}"}]}], "]"}], "]"}], "]"}], "-", "30"}], ")"}], "^", 
           "2"}], "+", 
          RowBox[{"100", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"Boole", "[", 
                  RowBox[{
                   RowBox[{"Total", "[", 
                    RowBox[{"CellularAutomaton", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"#", ",", " ", "2", ",", " ", "2"}], "}"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"IntegerDigits", "[", 
                    RowBox[{"i", ",", " ", "2"}], "]"}], ",", " ", "0"}], 
                    "}"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{"{", "300", "}"}], "}"}], "}"}]}], "]"}], "]"}], ">",
                    "50"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{
                  "i", ",", " ", "1", ",", " ", "200", ",", " ", "2"}], 
                  "}"}]}], "]"}], "]"}], "-", "1"}], ")"}], "^", "2"}]}]}]}], 
        "}"}], "&"}], ",", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"rcr", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "2"}], "}"}], ",", 
           RowBox[{"\"\<Quiescent\>\"", "->", "True"}], ",", 
           RowBox[{"\"\<Type\>\"", "->", "\"\<Symmetric\>\""}]}], "]"}], "[", 
         
         RowBox[{"[", "\"\<RuleNumber\>\"", "]"}], "]"}], ",", "1000"}], 
       "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"r2", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"TakeLargestBy", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"TakeSmallestBy", "[", 
         RowBox[{"r1", ",", "Last", ",", 
          RowBox[{"UpTo", "[", "800", "]"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"CellularAutomaton", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", "2", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{"1", ",", " ", "1000"}], "]"}], ",", " ", "0"}], "}"}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"{", "200", "}"}], "}"}], "}"}]}], "]"}], "]"}], "&"}], ",",
        " ", "200"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"CellularAutomaton", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", "2", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
            "1", ",", " ", "1", ",", " ", "1", ",", " ", "1", ",", " ", "1"}],
             "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"{", "1", "}"}], "}"}], "}"}]}], "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}], "==", "0"}], "&&", 
       RowBox[{
        RowBox[{
         RowBox[{"CellularAutomaton", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", "2", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
            "0", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "1"}],
             "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"{", "1", "}"}], "}"}], "}"}]}], "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}], "==", "0"}]}], "&"}]}], "]"}]}], 
  "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ParallelTable", "[", 
  RowBox[{
   RowBox[{"ClickToCopy", "[", 
    RowBox[{
     RowBox[{"ArrayPlot", "[", 
      RowBox[{"CellularAutomaton", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "2", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{"1", ",", "1000"}], "]"}], ",", "0"}], "}"}], ",", "100"}],
        "]"}], "]"}], ",", "i"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "r2"}], "}"}]}], "]"}]}], "Input",
