                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Min", "[", "#", "]"}], ",", 
                    RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
                   "separatedFirstRow"}], "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"SimplePeriodicityCode20", "[", 
                    RowBox[{
                    RowBox[{"repeat", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", 
