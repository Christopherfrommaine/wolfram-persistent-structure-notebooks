              RowBox[{"Last", "/@", 
               RowBox[{"Select", "[", 
                RowBox[{"component", ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"First", "[", "#", "]"}], "==", "1"}], "&"}]}], 
                "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"component", ",", " ", "wcc"}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"ranges", "=", 
            RowBox[{"Sort", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Min", "[", "#", "]"}], ",", 
                 RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
              "separatedFirstRow"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"SimplePeriodicityCode20", "[", 
               RowBox[{
                RowBox[{"carun", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", 
                   RowBox[{
                    RowBox[{"range", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ";;", 
                    RowBox[{"range", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], "]"}], ",", 
                " ", "steps"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"range", ",", " ", "ranges"}], "}"}]}], "]"}], "/.", 
            RowBox[{
             RowBox[{"x_", "?", "Negative"}], "->", "Nothing"}]}]}]}], 
         "\[IndentingNewLine]", "]"}]}]}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PeriodicityCode20", "[", 
   RowBox[{"list_", ",", " ", 
    RowBox[{"steps_", ":", "100"}]}], "]"}], ":=", 
  RowBox[{"With", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"carun", "=", 
      RowBox[{"CellularAutomaton", "[", 
