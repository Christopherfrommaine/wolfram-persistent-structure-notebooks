          RowBox[{
           RowBox[{"Length", "[", "repeat", "]"}], "==", "0"}], ",", 
          RowBox[{"ExpandingPeriodicityCode20", "[", 
           RowBox[{
            RowBox[{"Last", "[", "carun", "]"}], ",", " ", 
            RowBox[{"20", " ", "steps"}]}], "]"}], ",", "True", ",", 
          "\[IndentingNewLine]", 
