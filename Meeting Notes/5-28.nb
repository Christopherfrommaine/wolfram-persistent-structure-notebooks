                   RowBox[{"{", 
                    RowBox[{"y", ",", "  ", 
                    RowBox[{
                    RowBox[{"Length", "[", "repeat", "]"}], "-", "1"}]}], 
                    "}"}]}], "]"}], ",", " ", "2"}], "]"}]}], ",", 
              "\[IndentingNewLine]", "g", ",", "\[IndentingNewLine]", "wcc", ",",
               "\[IndentingNewLine]", "ranges", ",", "\[IndentingNewLine]", 
              "separatedFirstRow"}], "\[IndentingNewLine]", "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"g", "=", 
              RowBox[{"Graph", "[", 
               RowBox[{"points", ",", " ", "edges"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"wcc", "=", 
              RowBox[{"WeaklyConnectedComponents", "[", "g", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
