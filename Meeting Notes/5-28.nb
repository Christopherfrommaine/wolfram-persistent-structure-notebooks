      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"repeat", "=", 
          RowBox[{"Last", "[", 
           RowBox[{"FindTransientRepeatBy", "[", 
            RowBox[{"carun", ",", " ", "StripZeros"}], "]"}], "]"}]}], "}"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"Which", "[", 
