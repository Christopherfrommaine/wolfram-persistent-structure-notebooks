               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"separatedFirstRow", "=", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"Last", "/@", 
                    RowBox[{"Select", "[", 
                    RowBox[{"component", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"First", "[", "#", "]"}], "==", "1"}], "&"}]}], 
                    "]"}]}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"component", ",", " ", "wcc"}], "}"}]}], "]"}]}], 
                ";", "\[IndentingNewLine]", 
                RowBox[{"ranges", "=", 
                 RowBox[{"Sort", "[", 
