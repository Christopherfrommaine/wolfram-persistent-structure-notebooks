                RowBox[{
                 RowBox[{"Table", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"repeat", "[", 
                    RowBox[{"[", 
                    RowBox[{"y", ",", " ", "x"}], "]"}], "]"}], "==", "1"}], ",",
                     "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"If", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"1", "<=", 
                    RowBox[{"x", "+", "#"}]}], "&&", 
                    RowBox[{
                    RowBox[{"x", "+", "#"}], "<=", 
                    RowBox[{"Length", "[", 
                    RowBox[{"repeat", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "&&", 
                    RowBox[{
                    RowBox[{"repeat", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"y", "+", "1"}], ",", " ", 
                    RowBox[{"x", "+", "#"}]}], "]"}], "]"}], "==", "1"}]}], ",",
                     "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"y", ",", " ", "x"}], "}"}], "->", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"y", "+", "1"}], ",", " ", 
                    RowBox[{"x", "+", "#"}]}], "}"}]}], ",", " ", 
                    "\[IndentingNewLine]", "Nothing"}], "]"}], "&"}], "/@", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "2"}], ",", " ", 
                    RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "1", ",", 
                    " ", "2"}], "}"}]}], ",", "\[IndentingNewLine]", " ", 
                    RowBox[{"{", "}"}]}], "]"}], "\[IndentingNewLine]", ",", 
