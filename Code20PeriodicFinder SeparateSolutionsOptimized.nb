Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "SplitSeparateSolutionsNEWESTMORE", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SplitSeparateSolutionsNEWESTMORE", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"Typed", "[", 
      RowBox[{"carun", ",", " ", 
       RowBox[{"\"\<PackedArray\>\"", "::[", 
        RowBox[{"\"\<MachineInteger\>\"", ",", " ", "2"}], "]"}]}], "]"}], ",", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"blurred", ",", " ", "mask", ",", " ", 
         RowBox[{"o", "=", 
          RowBox[{"{", "}"}]}], ",", " ", "lastrowcovered", ",", " ", 
         RowBox[{"len", "=", 
          RowBox[{"Length", "[", "carun", "]"}]}], ",", " ", "combined", ",", 
         " ", "iLastRow", ",", " ", "iFullColumns", ",", " ", "lasttot", ",", 
         "notlastmask", ",", " ", "lastmask", ",", " ", "fullcolumns", ",", 
         "carunpadded"}], "}"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"carunpadded", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"{", 
            RowBox[{"len", ",", " ", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"First", "[", "carun", "]"}], "]"}], "+", "3"}]}], 
            "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"carunpadded", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", 
            RowBox[{";;", 
             RowBox[{"-", "4"}]}]}], "]"}], "]"}], "=", "carun"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"blurred", "=", 
         RowBox[{"BitOr", "[", 
          RowBox[{"carun", ",", " ", 
           RowBox[{"carunpadded", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", 
              RowBox[{"2", ";;", 
               RowBox[{"-", "3"}]}]}], "]"}], "]"}], ",", " ", 
           RowBox[{"carunpadded", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", 
              RowBox[{"3", ";;", 
               RowBox[{"-", "2"}]}]}], "]"}], "]"}], ",", " ", 
           RowBox[{"carunpadded", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", 
              RowBox[{"4", ";;", 
               RowBox[{"-", "1"}]}]}], "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"lastrowcovered", "=", 
         RowBox[{"Last", "[", "blurred", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"fullcolumns", "=", 
         RowBox[{"1", "-", 
          RowBox[{"Unitize", "[", 
           RowBox[{"len", "-", 
            RowBox[{"Total", "[", 
             RowBox[{"blurred", ",", " ", "1"}], "]"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"iLastRow", "=", 
         RowBox[{"Length", "[", "lastrowcovered", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"iFullColumns", "=", 
         RowBox[{"Length", "[", "fullcolumns", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"iLastRow", "!=", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"mask", "=", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"len", "+", "2"}], ",", " ", 
                 RowBox[{
                  RowBox[{"Length", "[", "lastrowcovered", "]"}], "+", 
                  "2"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "find", " ", "first", " ", "new", " ", "starting", " ", "cell"}], 
            " ", "*)"}], ";", "\[IndentingNewLine]", 
           RowBox[{"combined", "=", 
            RowBox[{"BitAnd", "[", 
             RowBox[{"lastrowcovered", ",", " ", 
              RowBox[{"blurred", "[", 
               RowBox[{"[", "len", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"iFullColumns", "!=", "0"}], ",", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"iFullColumns", ">", "0"}], "&&", 
                 RowBox[{
                  RowBox[{"fullcolumns", "[", 
                   RowBox[{"[", "iFullColumns", "]"}], "]"}], "==", "0"}]}], ",",
                 " ", 
                RowBox[{"iFullColumns", "--"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"iFullColumns", "==", "0"}], ",", 
                RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"mask", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"2", ";;", 
                   RowBox[{"len", "+", "1"}]}], ",", " ", 
                  RowBox[{"iFullColumns", "+", "1"}]}], "]"}], "]"}], "=", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", " ", "len"}], "]"}]}], ";"}], ",", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"iLastRow", ">", "0"}], "&&", 
                 RowBox[{
                  RowBox[{"combined", "[", 
                   RowBox[{"[", "iLastRow", "]"}], "]"}], "==", "0"}]}], ",", 
                
                RowBox[{"iLastRow", "--"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"iLastRow", "==", "0"}], ",", 
                RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"mask", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"len", "+", "1"}], ",", " ", 
                  RowBox[{"iLastRow", "+", "1"}]}], "]"}], "]"}], "=", "1"}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"lasttot", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{"lasttot", "!=", 
              RowBox[{"(", 
               RowBox[{"lasttot", "=", 
                RowBox[{"Total", "[", 
                 RowBox[{"mask", ",", " ", "2"}], "]"}]}], ")"}]}], ",", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "Mask", " ", "is", " ", "too", " ", "large", " ", "so", " ", 
               "that", " ", "I", " ", "can", " ", "use", " ", "slices", " ", 
               "instead", " ", "of", " ", "padding", " ", "with", " ", "zero",
                " ", "every", " ", "time"}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"mask", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"2", ";;", 
                   RowBox[{"-", "2"}]}], ",", " ", 
                  RowBox[{"2", ";;", 
                   RowBox[{"-", "2"}]}]}], "]"}], "]"}], "=", 
               "\[IndentingNewLine]", 
               RowBox[{"BitAnd", "[", 
                RowBox[{"blurred", ",", " ", 
                 RowBox[{"BitOr", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"mask", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"2", ";;", 
                    RowBox[{"-", "2"}]}], ",", " ", 
                    RowBox[{"2", ";;", 
                    RowBox[{"-", "2"}]}]}], "]"}], "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"mask", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"1", ";;", 
                    RowBox[{"-", "3"}]}], ",", " ", 
                    RowBox[{"2", ";;", 
                    RowBox[{"-", "2"}]}]}], "]"}], "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"mask", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"3", ";;", 
                    RowBox[{"-", "1"}]}], ",", " ", 
                    RowBox[{"2", ";;", 
                    RowBox[{"-", "2"}]}]}], "]"}], "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"mask", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"2", ";;", 
                    RowBox[{"-", "2"}]}], ",", " ", 
                    RowBox[{"1", ";;", 
                    RowBox[{"-", "3"}]}]}], "]"}], "]"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"mask", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"2", ";;", 
                    RowBox[{"-", "2"}]}], ",", " ", 
                    RowBox[{"3", ";;", 
                    RowBox[{"-", "1"}]}]}], "]"}], "]"}]}], 
                  "\[IndentingNewLine]", "]"}]}], "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"lastmask", "=", 
            RowBox[{"mask", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "2"}], ",", " ", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "2"}]}]}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"notlastmask", "=", 
            RowBox[{"1", "-", "lastmask"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"lastrowcovered", "=", 
            RowBox[{"BitAnd", "[", 
