Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "SplitSeparateSolutionsNEWESTMORESEARCHERS", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SplitSeparateSolutionsNEWESTMORESEARCHERS", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"Typed", "[", 
      RowBox[{"carun", ",", " ", 
       RowBox[{"\"\<PackedArray\>\"", "::[", 
        RowBox[{"\"\<MachineInteger\>\"", ",", " ", "2"}], "]"}]}], "]"}], ",", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"blurred", ",", " ", "mask", ",", " ", 
         RowBox[{"o", "=", 
          RowBox[{"{", "}"}]}], ",", " ", "lastrowcovered", ",", " ", 
         RowBox[{"len", "=", 
          RowBox[{"Length", "[", "carun", "]"}]}], ",", " ", "combined", ",", 
         " ", "iLastRow", ",", " ", "iFullColumns", ",", " ", "lasttot", ",", 
         "notlastmask", ",", " ", "lastmask", ",", " ", "fullcolumns", ",", 
         "carunpadded", ",", " ", "searchers"}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"carunpadded", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"{", 
            RowBox[{"len", ",", " ", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"First", "[", "carun", "]"}], "]"}], "+", "3"}]}], 
            "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"carunpadded", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", 
            RowBox[{";;", 
             RowBox[{"-", "4"}]}]}], "]"}], "]"}], "=", "carun"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"blurred", "=", 
         RowBox[{"BitOr", "[", 
          RowBox[{"carun", ",", " ", 
           RowBox[{"carunpadded", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", 
              RowBox[{"2", ";;", 
               RowBox[{"-", "3"}]}]}], "]"}], "]"}], ",", " ", 
           RowBox[{"carunpadded", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", 
              RowBox[{"3", ";;", 
               RowBox[{"-", "2"}]}]}], "]"}], "]"}], ",", " ", 
           RowBox[{"carunpadded", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", 
              RowBox[{"4", ";;", 
               RowBox[{"-", "1"}]}]}], "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"lastrowcovered", "=", 
         RowBox[{"Last", "[", "blurred", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"fullcolumns", "=", 
         RowBox[{"1", "-", 
          RowBox[{"Unitize", "[", 
           RowBox[{"len", "-", 
            RowBox[{"Total", "[", 
             RowBox[{"blurred", ",", " ", "1"}], "]"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"iLastRow", "=", 
         RowBox[{"Length", "[", "lastrowcovered", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"iFullColumns", "=", 
         RowBox[{"Length", "[", "fullcolumns", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"iLastRow", "!=", "0"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"mask", "=", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", " ", 
               RowBox[{"{", 
                RowBox[{"len", ",", " ", 
                 RowBox[{"Length", "[", "lastrowcovered", "]"}]}], "}"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"searchers", "=", 
             RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "find", " ", "first", " ", "new", " ", "starting", " ", "cell"}], 
            " ", "*)"}], ";", "\[IndentingNewLine]", 
           RowBox[{"combined", "=", 
            RowBox[{"BitAnd", "[", 
             RowBox[{"lastrowcovered", ",", " ", 
              RowBox[{"blurred", "[", 
               RowBox[{"[", "len", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"iFullColumns", "!=", "0"}], ",", "\[IndentingNewLine]", 
             
             RowBox[{
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"iFullColumns", ">", "0"}], "&&", 
                 RowBox[{
                  RowBox[{"fullcolumns", "[", 
                   RowBox[{"[", "iFullColumns", "]"}], "]"}], "==", "0"}]}], ",",
                 " ", 
                RowBox[{"iFullColumns", "--"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"iFullColumns", "==", "0"}], ",", 
                RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"searchers", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"y", ",", " ", "iFullColumns"}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"y", ",", " ", "len"}], "}"}]}], "]"}]}]}], ",", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"iLastRow", ">", "0"}], "&&", 
                 RowBox[{
                  RowBox[{"combined", "[", 
                   RowBox[{"[", "iLastRow", "]"}], "]"}], "==", "0"}]}], ",", 
                
                RowBox[{"iLastRow", "--"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"iLastRow", "==", "0"}], ",", 
                RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"searchers", "=", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"len", ",", " ", "iLastRow"}], "}"}], "}"}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "searchers", "]"}], "!=", "0"}], ",", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"ArrayPlot", "[", 
                RowBox[{"mask", ",", " ", 
                 RowBox[{"Mesh", "->", "True"}]}], "]"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"mask", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"searcher", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                    RowBox[{"searcher", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "=", 
                 "1"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"searcher", ",", " ", "searchers"}], "}"}]}], "]"}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"searchers", "=", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"searchers", "+", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
                    RowBox[{"Length", "[", "searchers", "]"}]}], "]"}]}], ",",
                  " ", 
                 RowBox[{"searchers", "+", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
                    RowBox[{"Length", "[", "searchers", "]"}]}], "]"}]}], ",",
                  " ", 
                 RowBox[{"searchers", "+", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], ",", " ", 
                    RowBox[{"Length", "[", "searchers", "]"}]}], "]"}]}], ",",
                  " ", 
                 RowBox[{"searchers", "+", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{"-", "1"}]}], "}"}], ",", " ", 
                    RowBox[{"Length", "[", "searchers", "]"}]}], "]"}]}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"searchers", "=", 
               RowBox[{"Select", "[", 
                RowBox[{"searchers", ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Positive", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "&&", 
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "<=", "len"}], "&&", 
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "<=", 
                    RowBox[{"Length", "[", 
                    RowBox[{"First", "[", "carun", "]"}], "]"}]}], "&&", 
                   RowBox[{"Positive", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "&&", 
                   RowBox[{
                    RowBox[{"blurred", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "==", 
                    "1"}], "&&", 
                   RowBox[{
                    RowBox[{"mask", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "==", 
                    "0"}]}], "&"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]",
             "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"ArrayPlot", "[", 
             RowBox[{"mask", ",", " ", 
              RowBox[{"Mesh", "->", "True"}]}], "]"}], "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"lastmask", "=", 
            RowBox[{"mask", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"notlastmask", "=", 
            RowBox[{"1", "-", "lastmask"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Dims: \>\"", ",", " ", 
             RowBox[{"Dimensions", "@", "carun"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"lastrowcovered", "=", 
            RowBox[{"BitAnd", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"EchoFunction", "[", "Dimensions", "]"}], "@", 
               "lastrowcovered"}], ",", 
              RowBox[{
               RowBox[{"EchoFunction", "[", "Dimensions", "]"}], "@", " ", 
               "notlastmask"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"fullcolumns", "=", 
            RowBox[{"BitAnd", "[", 
             RowBox[{"fullcolumns", ",", "notlastmask"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"o", ",", " ", 
             RowBox[{"BitAnd", "[", 
              RowBox[{
               RowBox[{"carun", "[", 
                RowBox[{"[", "len", "]"}], "]"}], ",", "lastmask"}], "]"}]}], 
            "]"}], ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
         "]"}], ";", "\[IndentingNewLine]", "o"}]}], "\[IndentingNewLine]", 
      "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.989502805676248*^9, 3.989502808885619*^9}, {
