Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "SplitSeparateSolutions2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SplitSeparateSolutions2", "[", 
   RowBox[{"carun_", ",", " ", "rule_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"encounteredNonzero", "=", "False"}], ",", " ", 
      RowBox[{"first", "=", 
       RowBox[{"First", "[", "carun", "]"}]}], ",", " ", "w", ",", 
      "superposition", ",", " ", "left", ",", " ", "right", ",", " ", 
      RowBox[{"result", "=", "None"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"w", "=", 
      RowBox[{"Length", "[", "first", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"encounteredNonzero", "=", 
         RowBox[{"Or", "[", 
          RowBox[{"encounteredNonzero", ",", " ", 
           RowBox[{
            RowBox[{"first", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "!=", "0"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"encounteredNonzero", "&&", 
           RowBox[{
            RowBox[{"first", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "==", "0"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"left", "=", 
            RowBox[{"CellularAutomaton", "[", 
             RowBox[{"rule", ",", " ", 
              RowBox[{"ArrayPad", "[", 
               RowBox[{
                RowBox[{"PadRight", "[", 
                 RowBox[{
                  RowBox[{"first", "[", 
                   RowBox[{"[", 
                    RowBox[{";;", "i"}], "]"}], "]"}], ",", " ", "w"}], "]"}],
                 ",", " ", "2"}], "]"}], ",", " ", 
              RowBox[{
               RowBox[{"Length", "[", "carun", "]"}], "-", "1"}]}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"right", "=", 
            RowBox[{"CellularAutomaton", "[", 
             RowBox[{"rule", ",", 
              RowBox[{"ArrayPad", "[", 
               RowBox[{
                RowBox[{"PadLeft", "[", 
                 RowBox[{
                  RowBox[{"first", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ";;"}], "]"}], "]"}], ",", " ", "w"}], "]"}],
                 ",", " ", "2"}], "]"}], ",", " ", 
              RowBox[{
               RowBox[{"Length", "[", "carun", "]"}], "-", "1"}]}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"ArrayPlot", "[", "left", "]"}], ",", " ", 
               RowBox[{"ArrayPlot", "[", "right", "]"}], ",", " ", 
               RowBox[{"ArrayPlot", "[", 
                RowBox[{"left", "+", "right"}], "]"}], ",", " ", 
               RowBox[{"ArrayPlot", "[", "carun", "]"}]}], "]"}], ";"}], " ", 
            "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"superposition", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"left", "+", "right"}], ")"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", 
               RowBox[{"3", ";;", 
                RowBox[{"-", "3"}]}]}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"superposition", "==", "carun"}], "&&", 
              RowBox[{"!", 
               RowBox[{"AllZeros", "[", 
                RowBox[{"Last", "[", "left", "]"}], "]"}]}], "&&", 
              RowBox[{"!", 
               RowBox[{"AllZeros", "[", 
                RowBox[{"Last", "[", "right", "]"}], "]"}]}]}], ",", " ", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"result", "=", 
               RowBox[{"Join", "[", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"StripZeros", "[", 
                   RowBox[{"Last", "[", "left", "]"}], "]"}], "}"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"SplitSeparateSolutions2", "[", 
                  RowBox[{"right", ",", " ", "rule"}], "]"}]}], 
                "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"Break", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"encounteredNonzero", "=", "False"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "w"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"result", "===", "None"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"StripZeros", "[", 
          RowBox[{"Last", "[", "carun", "]"}], "]"}], "}"}], "/.", 
        RowBox[{
         RowBox[{"{", "}"}], "->", "Nothing"}]}], ",", " ", "result"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
