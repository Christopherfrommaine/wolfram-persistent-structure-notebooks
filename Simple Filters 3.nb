             RowBox[{"IntegerExponent", "[", 
              RowBox[{"o", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}], "&"}], ",",
         " ", "end", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "!=", "0"}], "&&", 
          RowBox[{"seen", "[", 
           RowBox[{"\"\<Insert\>\"", ",", " ", "#"}], "]"}]}], "&"}], ",", 
        "1", ",", "maxSteps"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Last", "[", "carun", "]"}], "==", "0"}], ",", " ", 
