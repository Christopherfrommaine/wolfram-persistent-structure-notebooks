 RowBox[{
  RowBox[{"Clear", "[", "GenerateFiltered", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GenerateFiltered", "[", 
   RowBox[{
    RowBox[{"periodsToIgnore_List", ":", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "4", ",", " ", "5", ",", "9"}], 
      "}"}]}], ",", " ", 
    RowBox[{"initSteps_", ":", "200"}], ",", " ", 
    RowBox[{"maxPeriod_", ":", "200"}]}], "]"}], ":=", 
  RowBox[{"FunctionCompile", "[", 
   RowBox[{
    RowBox[{"Function", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Typed", "[", 
         RowBox[{"min", ",", " ", "\"\<MachineInteger\>\""}], "]"}], ",", " ", 
        RowBox[{"Typed", "[", 
         RowBox[{"max", ",", " ", "\"\<MachineInteger\>\""}], "]"}]}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "count", ",", " ", "o", ",", " ", "accum", ",", " ", "minim", ",", 
          "maxgaplength", ",", " ", 
          RowBox[{"found", "=", 
           RowBox[{"CreateDataStructure", "[", "\"\<HashTable\>\"", "]"}]}]}],
          "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"o", "=", 
             RowBox[{"Cast", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"2", "*", "oOrig"}], " ", "+", " ", "1"}], ",", 
               " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"o", "!=", "0"}], "&&", 
               RowBox[{"count", "<", "initSteps"}], "&&", 
               RowBox[{
                RowBox[{"BitAnd", "[", 
                 RowBox[{"o", ",", " ", 
                  RowBox[{"TypeHint", "[", 
                   RowBox[{
                   "16140901064495857664", ",", 
                    " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], "]"}], "==", 
                "0"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
               RowBox[{"o", "=", 
                RowBox[{"With", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"a", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "3"}], "]"}]}], ",", " ", 
                    RowBox[{"b", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "2"}], "]"}]}], ",", " ", 
                    RowBox[{"c", "=", 
