 RowBox[{
  RowBox[{
   RowBox[{"StripZeros", "=", 
    RowBox[{"FunctionCompile", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"Typed", "[", 
         RowBox[{"list", ",", " ", 
