Cell[CellGroupData[{

Cell["Filter 2", "Section",
 CellChangeTimes->{{3.989683739945101*^9, 
  3.989683740972355*^9}},ExpressionUUID->"308f71f7-bc99-4bc3-b417-\
4b7a68621cfd"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "Filter2", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Filter2", "[", 
    RowBox[{
     RowBox[{"ignoredPeriods_List", ":", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", " ", "2", ",", " ", "4", ",", " ", "5", ",", " ", "9"}], 
       "}"}]}], ",", 
     RowBox[{"maxSteps_Integer", ":", "200"}], ",", 
     RowBox[{"maxPeriod_Integer", ":", "2000"}]}], "]"}], "[", 
   RowBox[{"end_", "->", "init_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "caruninit", ",", " ", "carun", ",", " ", "frd", ",", " ", "canonical", ",",
       " ", 
      RowBox[{"seen", "=", 
       RowBox[{"CreateDataStructure", "[", "\"\<HashSet\>\"", "]"}]}]}], 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"caruninit", "=", 
      RowBox[{"NestWhile", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "=", 
              RowBox[{"BitShiftLeft", "[", 
               RowBox[{"#", ",", " ", "3"}], "]"}]}], ",", " ", 
             RowBox[{"b", "=", 
              RowBox[{"BitShiftLeft", "[", 
               RowBox[{"#", ",", " ", "2"}], "]"}]}], ",", " ", 
             RowBox[{"c", "=", 
              RowBox[{"BitShiftLeft", "[", 
               RowBox[{"#", ",", " ", "1"}], "]"}]}], ",", " ", 
             RowBox[{"d", "=", 
              RowBox[{"BitShiftRight", "[", 
               RowBox[{"#", ",", " ", "1"}], "]"}]}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"o", "=", 
             RowBox[{"BitXor", "[", 
              RowBox[{
               RowBox[{"BitXor", "[", 
                RowBox[{
                "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", " ", 
                 "#"}], "]"}], ",", " ", 
               RowBox[{"BitOr", "[", 
                RowBox[{
                "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", " ", 
                 "#"}], "]"}]}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"BitShiftRight", "[", 
            RowBox[{"o", ",", " ", 
             RowBox[{"IntegerExponent", "[", 
              RowBox[{"o", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}], "&"}], ",",
         " ", "end", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "!=", "0"}], "&&", 
          RowBox[{"seen", "[", 
           RowBox[{"\"\<Insert\>\"", ",", " ", "#"}], "]"}]}], "&"}], ",", 
        "1", ",", "maxSteps"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"caruninit", "==", "0"}], ",", " ", 
       RowBox[{"Return", "[", "Nothing", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"seen", "[", "\"\<DeleteAll\>\"", "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"carun", "=", 
      RowBox[{"NestWhileList", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "=", 
              RowBox[{"BitShiftLeft", "[", 
               RowBox[{"#", ",", " ", "3"}], "]"}]}], ",", " ", 
             RowBox[{"b", "=", 
              RowBox[{"BitShiftLeft", "[", 
               RowBox[{"#", ",", " ", "2"}], "]"}]}], ",", " ", 
             RowBox[{"c", "=", 
              RowBox[{"BitShiftLeft", "[", 
               RowBox[{"#", ",", " ", "1"}], "]"}]}], ",", " ", 
             RowBox[{"d", "=", 
              RowBox[{"BitShiftRight", "[", 
               RowBox[{"#", ",", " ", "1"}], "]"}]}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"o", "=", 
             RowBox[{"BitXor", "[", 
              RowBox[{
               RowBox[{"BitXor", "[", 
                RowBox[{
                "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", " ", 
                 "#"}], "]"}], ",", " ", 
               RowBox[{"BitOr", "[", 
                RowBox[{
                "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", " ", 
                 "#"}], "]"}]}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"BitShiftRight", "[", 
