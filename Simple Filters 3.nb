                    RowBox[{"BitShiftRight", "[", 
                    RowBox[{"o", ",", " ", "1"}], "]"}]}]}], "}"}], ",", 
                  RowBox[{"BitXor", "[", 
                   RowBox[{
                    RowBox[{"BitXor", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}], ",", " ", 
                    RowBox[{"BitOr", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
                 "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"o", "==", "0"}], ",", " ", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"EvenQ", "[", "o", "]"}], ",", " ", 
              RowBox[{"o", "=", 
               RowBox[{"BitShiftRight", "[", "o", "]"}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
            RowBox[{"accum", "=", "o"}], ";", "\[IndentingNewLine]", 
            RowBox[{"minim", "=", "o"}], ";", "\[IndentingNewLine]", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"o", "!=", "0"}], "&&", 
               RowBox[{"accum", "!=", "0"}], "&&", 
               RowBox[{"count", "<=", "maxPeriod"}], "&&", 
               RowBox[{
                RowBox[{"BitAnd", "[", 
                 RowBox[{"o", ",", " ", 
                  RowBox[{"TypeHint", "[", 
                   RowBox[{
                   "16140901064495857664", ",", 
                    " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], "]"}], "==", 
                "0"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
               RowBox[{"o", "=", 
                RowBox[{"With", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"a", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "3"}], "]"}]}], ",", " ", 
                    RowBox[{"b", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "2"}], "]"}]}], ",", " ", 
                    RowBox[{"c", "=", 
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"o", ",", " ", "1"}], "]"}]}], ",", " ", 
                    RowBox[{"d", "=", 
                    RowBox[{"BitShiftRight", "[", 
                    RowBox[{"o", ",", " ", "1"}], "]"}]}]}], "}"}], ",", 
                  RowBox[{"BitXor", "[", 
                   RowBox[{
                    RowBox[{"BitXor", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}], ",", " ", 
                    RowBox[{"BitOr", "[", 
                    RowBox[{
                    "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", 
                    " ", "o"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"While", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"EvenQ", "[", "o", "]"}], "&&", 
                  RowBox[{"o", "!=", "0"}]}], ",", " ", 
                 RowBox[{"o", "=", 
                  RowBox[{"BitShiftRight", "[", "o", "]"}]}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"accum", "=", 
                RowBox[{"BitXor", "[", 
                 RowBox[{"accum", ",", " ", "o"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"minim", "=", 
                RowBox[{"Min", "[", 
                 RowBox[{"minim", ",", " ", "o"}], "]"}]}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"o", "==", "0"}], "||", 
                 RowBox[{"found", "[", 
                  RowBox[{"\"\<KeyExistsQ\>\"", ",", " ", "minim"}], "]"}], "||", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"accum", "==", "0"}], "&&", 
                   RowBox[{"MemberQ", "[", 
                    RowBox[{"periodsToIgnore", ",", " ", 
                    RowBox[{"BitShiftRight", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"count", "+", "1"}], ")"}], ",", "1"}], "]"}]}], 
                    "]"}]}], ")"}]}], ")"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"found", "[", 
               RowBox[{"\"\<Insert\>\"", ",", " ", 
                RowBox[{"minim", "->", 
                 RowBox[{
                  RowBox[{"2", "*", "oOrig"}], "+", "1"}]}]}], "]"}]}], 
             "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
           
           RowBox[{"{", 
            RowBox[{"oOrig", ",", "min", ",", " ", "max"}], "}"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Normal", "[", "found", "]"}]}]}], "\[IndentingNewLine]", 
       "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
    RowBox[{"CompilerOptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<LLVMOptimization\>\"", "->", 
