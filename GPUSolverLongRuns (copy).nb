Cell[BoxData[{
 RowBox[{
  RowBox[{"results", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"results", ",", 
     RowBox[{
      RowBox[{"ListQ", "[", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "]"}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Length", "[", "results", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bestresults", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"results", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "=!=", "$TimedOut"}], "&&", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], ">", "1"}], "&&", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], ">", "32"}]}], "&"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"betterresults", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"bestresults", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], "<", "20"}], "&"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"amazingresults", "=", 
    RowBox[{"ParallelSelect", "[", 
     RowBox[{"results", ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "<", "100"}], "&&", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rule", "=", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", "=", 
            RowBox[{
             RowBox[{"AnalyzeRule", "[", "rule", "]"}], "[", "\"\<Colors\>\"",
              "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"lengths", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"CellularAutomaton", "[", 
                RowBox[{"rule", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"IntegerDigits", "[", 
                    RowBox[{"init", ",", " ", "k"}], "]"}], ",", " ", "0"}], 
                  "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"{", 
                   RowBox[{"{", "200", "}"}], "}"}], "}"}]}], "]"}], "]"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"init", ",", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Mean", "[", "lengths", "]"}], "<", "20"}], "&&", 
           RowBox[{
            RowBox[{"Max", "[", "lengths", "]"}], ">", "100"}]}]}], "]"}]}], 
       "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"resultstodisplay", "=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "amazingresults", "]"}], "!=", "0"}], ",", " ", 
     "amazingresults", ",", " ", 
     RowBox[{
      RowBox[{"Length", "[", "betterresults", "]"}], ">", "10"}], ",", " ", 
     "betterresults", ",", " ", 
     RowBox[{
      RowBox[{"Length", "[", "bestresults", "]"}], ">", "10"}], ",", " ", 
