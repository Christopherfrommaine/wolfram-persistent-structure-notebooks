Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MinimalBooleanForm", "[", "bf_", "]"}], ":=", 
   RowBox[{
    RowBox[{"MinimalBooleanForm", "[", "bf", "]"}], "=", 
    RowBox[{"First", "[", 
     RowBox[{"MinimalBy", "[", "\n", 
      RowBox[{
       RowBox[{"ParallelMap", "[", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{"TimeConstrained", "[", 
