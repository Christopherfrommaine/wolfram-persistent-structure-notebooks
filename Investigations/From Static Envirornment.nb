Cell[CellGroupData[{

Cell["\<\
Research Question: How many mutations are necessary for life to emerge?\
\>", "Section",
 CellChangeTimes->{{3.995378192493287*^9, 3.995378192588559*^9}, 
   3.9954532258379087`*^9},ExpressionUUID->"fb9cca09-58c5-4d74-ab1c-\
186fe23b65ab"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "PointMutateChoiceSym", "]"}], "\n", 
 RowBox[{
  RowBox[{"PointMutateChoiceSym", "[", 
   RowBox[{"rule_", ",", 
    RowBox[{"n_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ar", "=", 
       RowBox[{"AnalyzeRule", "[", "rule", "]"}]}], ",", "k", ",", "r", ",", 
      "rn", ",", "o", ",", "out", ",", "m", ",", "mirrorPos", ",", 
      "canonicals", ",", "chosen"}], "}"}], ",", 
    RowBox[{
     RowBox[{"k", "=", 
      RowBox[{"ar", "[", "\"\<Colors\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"ar", "[", "\"\<Radius\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rn", "=", 
      RowBox[{"ar", "[", "\"\<Number\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"k", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "r"}], "+", "1"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"o", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{"rn", ",", "k", ",", "m"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mirrorPos", "[", "i_", "]"}], ":=", 
      RowBox[{"m", "-", 
       RowBox[{"FromDigits", "[", 
        RowBox[{
         RowBox[{"Reverse", "[", 
          RowBox[{"IntegerDigits", "[", 
           RowBox[{
            RowBox[{"m", "-", "i"}], ",", "k", ",", 
            RowBox[{
             RowBox[{"2", " ", "r"}], "+", "1"}]}], "]"}], "]"}], ",", "k"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"canonicals", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"m", "-", "1"}], "]"}], ",", 
        RowBox[{
         RowBox[{"#", "<=", 
          RowBox[{"mirrorPos", "[", "#", "]"}]}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"chosen", "=", 
      RowBox[{"RandomChoice", "[", 
       RowBox[{"canonicals", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"val", "=", 
            RowBox[{"RandomInteger", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"k", "-", "1"}]}], "}"}], "]"}]}], ",", 
           RowBox[{"mir", "=", 
            RowBox[{"mirrorPos", "[", "i", "]"}]}]}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"o", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "=", "val"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"o", "[", 
            RowBox[{"[", "mir", "]"}], "]"}], "=", "val"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "chosen"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"out", "=", 
      RowBox[{"FromDigits", "[", 
       RowBox[{"o", ",", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"out", ",", "k", ",", "r"}], "}"}]}]}], "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9953785026505623`*^9, 3.995378508934564*^9}, {
  3.995378557235767*^9, 3.9953785578159113`*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"7193158b-9541-4965-9d82-c0efb6ad9283"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "SymmetricRuleQ", "]"}], "\n", 
 RowBox[{
  RowBox[{"SymmetricRuleQ", "[", 
   RowBox[{"n_", ",", "k_", ",", "r_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", "o", ",", "mirrorPos"}], "}"}], ",", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{"k", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "r"}], "+", "1"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"o", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{"n", ",", "k", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"mirrorPos", "[", "i_", "]"}], ":=", 
      RowBox[{"m", "-", 
       RowBox[{"FromDigits", "[", 
        RowBox[{
         RowBox[{"Reverse", "[", 
          RowBox[{"IntegerDigits", "[", 
           RowBox[{
            RowBox[{"m", "-", "i"}], ",", "k", ",", 
            RowBox[{
             RowBox[{"2", " ", "r"}], "+", "1"}]}], "]"}], "]"}], ",", "k"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Range", "[", "m", "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"o", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "==", 
         RowBox[{"o", "[", 
          RowBox[{"[", 
           RowBox[{"mirrorPos", "[", "#", "]"}], "]"}], "]"}]}], "&"}]}], 
      "]"}]}]}], "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.995392757956903*^9, 3.9953927664592333`*^9}, 
   3.9953951304512*^9},
 CellLabel->"In[45]:=",ExpressionUUID->"ed0d385e-8e99-44ec-b889-2514eaaa60c0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"k", "=", "2"}], ";", 
  RowBox[{"r", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"identityRule", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"FromDigits", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"Reverse", "@", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"k", "-", "1"}]}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"2", "r"}], "+", "1"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", 
         RowBox[{"r", "+", "1"}]}], "]"}], "]"}], ",", " ", "k"}], "]"}], ",",
     " ", "k", ",", " ", "r"}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RulePlot", "[", 
   RowBox[{"CellularAutomaton", "[", "identityRule", "]"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxmut", "=", 
   RowBox[{"2", "*", 
    RowBox[{"(", 
     RowBox[{"k", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "r"}], "+", "1"}], ")"}]}], ")"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Generate", " ", "many", " ", "mutations"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rules", "=", 
    RowBox[{"Union", "[", 
     RowBox[{"Join", "@@", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Union", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"PointMutateChoiceSym", "[", 
            RowBox[{"identityRule", ",", " ", "mutations"}], "]"}], ",", " ", 
           "10000"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"mutations", ",", " ", "0", ",", " ", "maxmut"}], "}"}]}], 
       "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  
  RowBox[{"(*", " ", 
   RowBox[{"Group", " ", "by", " ", "mutation", " ", "distance"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rules", "=", 
    RowBox[{
     RowBox[{"Values", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", "}"}], "&"}], ",", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", "maxmut"}], "]"}]}], "]"}], ",", 
        RowBox[{"GroupBy", "[", 
