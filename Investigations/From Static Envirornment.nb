 RowBox[{"Clear", "[", "Try", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Try", "[", 
    RowBox[{"f_", ",", " ", "elems_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"o", "=", "$Failed"}], ",", " ", 
       RowBox[{"i", "=", "1"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"o", "=", 
            RowBox[{"f", "[", 
             RowBox[{"elems", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ")"}], "===", 
          "$Failed"}], "&&", 
         RowBox[{"i", "<", 
          RowBox[{"Length", "[", "elems", "]"}]}]}], ",", " ", 
