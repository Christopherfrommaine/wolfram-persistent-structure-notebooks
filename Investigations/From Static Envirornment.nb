Cell[BoxData[{
 RowBox[{"Clear", "[", "DiversityMap", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DiversityMap", "[", 
   RowBox[{"rules_", ",", " ", 
    RowBox[{"steps_", ":", "1000"}], ",", " ", 
    RowBox[{"k_", ":", "2"}], ",", " ", 
    RowBox[{"len_", ":", "8"}]}], "]"}], ":=", 
  RowBox[{"ReverseSort", "[", 
   RowBox[{"Association", "[", 
    RowBox[{"ParallelMap", "[", " ", 
     RowBox[{
      RowBox[{"rule", "|->", 
       RowBox[{"rule", "->", 
        RowBox[{"Length", "[", 
         RowBox[{"Union", "[", 
          RowBox[{"Join", "@@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Union", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"FromDigits", "[", 
                 RowBox[{"#", ",", " ", "k"}], "]"}], "&"}], "/@", 
               RowBox[{"Union", "@", 
                RowBox[{"Partition", "[", 
                 RowBox[{"row", ",", " ", "len", ",", " ", "1"}], "]"}]}]}], 
              "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"row", ",", " ", 
               RowBox[{"Rest", "@", 
                RowBox[{"RunCA", "[", 
                 RowBox[{"rule", ",", " ", 
                  RowBox[{"RandomInteger", "[", 
                   RowBox[{"k", "^", "50"}], "]"}], ",", " ", "steps"}], 
                 "]"}]}]}], "}"}]}], "]"}]}], "]"}], "]"}]}]}], ",", " ", 
      "rules"}], "]"}], "]"}], "]"}]}]}], "Input",
 InitializationCell->True,
