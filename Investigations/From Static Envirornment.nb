Cell[BoxData[{
 RowBox[{
  RowBox[{"somerules", "=", 
   RowBox[{"Catenate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", 
       RowBox[{"[", 
        RowBox[{";;", 
         RowBox[{"UpTo", "[", "10", "]"}]}], "]"}], "]"}], "&"}], "/@", 
     "rules"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t4", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"o", "=", 
         RowBox[{"SelfReplicatesStrict", "[", "rule", "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"o", "===", "None"}], ",", " ", "Nothing", ",", " ", 
         RowBox[{"{", 
          RowBox[{"rule", ",", " ", "o"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"rule", ",", " ", "somerules"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
