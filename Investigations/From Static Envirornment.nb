Cell[CellGroupData[{

Cell["Density of Nonzero Necessary for Life", "Section",
 CellChangeTimes->{{3.995453630720999*^9, 
  3.995453652164815*^9}},ExpressionUUID->"8f2cf834-5b64-444f-8165-\
753548c1207e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"segments", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "32"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rules", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", " ", "2", ",", " ", "2"}], "}"}], "&"}], "/@", 
      RowBox[{"Union", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"FromDigits", "[", 
          RowBox[{
           RowBox[{"RandomSample", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Boole", "[", 
               RowBox[{"i", "<=", "threshold"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"i", ",", " ", "32"}], "}"}]}], "]"}], "]"}], ",", " ",
            "2"}], "]"}], ",", " ", "30"}], "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"threshold", ",", " ", "segments"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9954570326639357`*^9, 3.995457169247387*^9}, {
  3.995457205761306*^9, 3.995457242924786*^9}, {3.995457312321966*^9, 
  3.995457325457478*^9}, {3.995457810521635*^9, 3.9954578105769978`*^9}, {
  3.995457862916567*^9, 3.995457893952548*^9}},
 CellLabel->
  "In[525]:=",ExpressionUUID->"e0fbb1b9-7062-42e0-8fbf-61949912a3b4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"t1", "=", 
  RowBox[{"ProgressMap", "[", 
   RowBox[{
    RowBox[{"i", "|->", 
     RowBox[{"Mean", "@", 
      RowBox[{"N", "@", 
       RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"TimeConstrained", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Boole", "[", "\[IndentingNewLine]", 
            RowBox[{
            "ThereExistsInitWhichDoesntGrowInfinitelyOrDie", "[", "rule", 
             "]"}], "\[IndentingNewLine]", "]"}], ",", "5", ",", " ", 
           "Nothing"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"rule", ",", 
           RowBox[{"rules", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}]}], ",", " ", 
    
    RowBox[{"Range", "[", 
     RowBox[{"Length", "[", "rules", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"t2", "=", 
  RowBox[{"ProgressMap", "[", 
   RowBox[{
    RowBox[{"i", "|->", 
     RowBox[{"Mean", "@", 
      RowBox[{"N", "@", 
       RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"TimeConstrained", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Boole", "[", 
            RowBox[{"ThereExistsInitWhichGrowsInfinitely", "[", "rule", "]"}],
             "\[IndentingNewLine]", "]"}], ",", "5", ",", " ", "Nothing"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"rule", ",", 
           RowBox[{"rules", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}]}], ",", " ", 
    
    RowBox[{"Range", "[", 
     RowBox[{"Length", "[", "rules", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"t3", "=", 
  RowBox[{"ProgressMap", "[", 
   RowBox[{
    RowBox[{"i", "|->", 
     RowBox[{"Mean", "@", 
      RowBox[{"N", "@", 
       RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"TimeConstrained", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Boole", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
             "ThereExistsInitWhichDoesntGrowInfinitelyOrDie", "[", "rule", 
              "]"}], "&&", 
             RowBox[{
             "ThereExistsInitWhichGrowsInfinitely", "[", "rule", "]"}]}], 
            "\[IndentingNewLine]", "]"}], ",", "5", ",", " ", "Nothing"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"rule", ",", 
           RowBox[{"rules", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}]}], ",", " ", 
    
    RowBox[{"Range", "[", 
     RowBox[{"Length", "[", "rules", "]"}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.995457185704689*^9, 3.995457203095045*^9}, {
