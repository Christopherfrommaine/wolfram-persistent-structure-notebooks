Cell[BoxData[{
 RowBox[{"Clear", "[", "ThereExistsInitWhichDoesntGrowInfinitelyOrDie", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ThereExistsInitWhichDoesntGrowInfinitelyOrDie", "[", 
   RowBox[{"rule_", ",", " ", 
    RowBox[{"numChecks_", ":", "50"}]}], "]"}], ":=", 
  RowBox[{"AnyTrue", "[", 
   RowBox[{
    RowBox[{"Range", "[", "numChecks", "]"}], ",", 
    RowBox[{"seed", "|->", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "seed", "]"}], ";", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{"l", "=", 
           RowBox[{"Length", "[", 
            RowBox[{"StripZeros", "[", "\[IndentingNewLine]", 
             RowBox[{"RunCA", "[", 
              RowBox[{"rule", ",", " ", 
               RowBox[{"RandomInteger", "[", 
                RowBox[{"k", "^", "50"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"{", "100", "}"}], "}"}], "}"}]}], "]"}], 
             "\[IndentingNewLine]", "]"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", ">", "0"}], "&&", 
          RowBox[{"l", "<=", "100"}]}]}], "\[IndentingNewLine]", "]"}]}], 
      ")"}]}]}], "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.995378929756271*^9, 3.995378951840837*^9}, {
   3.9954493512094603`*^9, 3.9954493726255493`*^9}, 3.995452453895838*^9},
 CellLabel->"In[47]:=",ExpressionUUID->"feb5ad94-4867-486c-94e0-e5e79e997011"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "ThereExistsInitWhichGrowsInfinitely", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ThereExistsInitWhichGrowsInfinitely", "[", 
    RowBox[{"rule_", ",", " ", 
     RowBox[{"tries_", ":", "50"}]}], "]"}], ":=", 
   RowBox[{"AnyTrue", "[", 
    RowBox[{
     RowBox[{"RandomInteger", "[", 
      RowBox[{
       RowBox[{"k", "^", "20"}], ",", " ", "tries"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"AnyTrue", "[", 
       RowBox[{
        RowBox[{"DetectPeriod", "[", 
         RowBox[{"rule", ",", " ", "#"}], "]"}], ",", " ", 
        RowBox[{"#IsGliderGun", "&"}]}], "]"}], "&"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", "ThereExistsInitWhichGrowsInfinitelyGPU", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ThereExistsInitWhichGrowsInfinitelyGPU", "[", 
   RowBox[{"rule_", ",", " ", 
    RowBox[{"max_", ":", "100000"}]}], "]"}], ":=", 
  RowBox[{"AnyTrue", "[", 
   RowBox[{
    RowBox[{"GPUStructureSearch", "[", 
     RowBox[{"rule", ",", " ", "0", ",", " ", "max"}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"AnyTrue", "[", 
      RowBox[{
       RowBox[{"DetectPeriod", "[", 
        RowBox[{"rule", ",", " ", "#"}], "]"}], ",", " ", 
       RowBox[{"#IsGliderGun", "&"}]}], "]"}], "&"}]}], "]"}]}]}], "Input",
