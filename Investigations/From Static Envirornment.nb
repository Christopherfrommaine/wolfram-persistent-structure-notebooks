    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IsPersistent", "[", "init", "]"}], "==", "1"}], ")"}], "&&", 
     RowBox[{"IsItself", "[", "init", "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FrequencyOf", "[", 
    RowBox[{"func_", ",", " ", "min_", ",", " ", "max_", ",", " ", "n_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"Total", "[", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{"func", ",", " ", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"min", ",", " ", "max"}], "}"}], ",", " ", "n"}], "]"}]}], 
       "]"}], "]"}], "]"}], "/", "n"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"res", "=", 
    RowBox[{"ProgressMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "^", "#"}], ",", " ", 
         RowBox[{"FrequencyOf", "[", 
          RowBox[{"IsBoth", ",", " ", 
           RowBox[{"2", "^", "#"}], ",", " ", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"#", "+", "1"}], ")"}]}], ",", " ", "10000"}], "]"}]}], 
        "}"}], "&"}], ",", " ", 
      RowBox[{"Range", "[", "100", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLogLinearPlot", "[", 
  RowBox[{"res", ",", " ", 
   RowBox[{"Joined", "->", "True"}], ",", "  ", 
   RowBox[{"Filling", "->", "Axis"}]}], "]"}]}], "Input",
