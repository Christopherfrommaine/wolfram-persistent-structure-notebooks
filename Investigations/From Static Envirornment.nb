Cell[BoxData[
 RowBox[{
  RowBox[{"InitSelfReplicatesNonSerpenski", "[", 
   RowBox[{"rule_", ",", " ", "init_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"carun", "=", 
      RowBox[{"RunCA", "[", 
       RowBox[{"rule", ",", " ", "init", ",", " ", "500"}], "]"}]}], "}"}], ",", 
    RowBox[{"AnyTrue", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"2", ",", " ", "10"}], "]"}], ",", 
      RowBox[{"i", "|->", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"BitXor", "[", 
           RowBox[{
            RowBox[{"carun", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", 
               RowBox[{";;", 
                RowBox[{"-", "i"}]}]}], "]"}], "]"}], ",", " ", 
            RowBox[{"carun", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", 
               RowBox[{"i", ";;"}]}], "]"}], "]"}]}], "]"}], ",", " ", "2"}], 
         "]"}], "<", 
        RowBox[{"0.01", "*", 
         RowBox[{"Times", "@@", 
          RowBox[{"Dimensions", "[", "carun", "]"}]}]}]}]}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9956336901834106`*^9, 3.995633734467784*^9}, {
  3.99563405023411*^9, 3.995634097936249*^9}, {3.99563413352216*^9, 
  3.995634228152965*^9}, {3.99563437862748*^9, 3.995634380110353*^9}, {
