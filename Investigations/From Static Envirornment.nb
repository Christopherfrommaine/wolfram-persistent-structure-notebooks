Cell[BoxData[
 RowBox[{
  RowBox[{"SelfReplicatesNonSerpenski", "[", "rule_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Try", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"InitSelfReplicatesNonSerpenski", "[", 
         RowBox[{"rule", ",", "#1"}], "]"}], ",", "#1", ",", "$Failed"}], 
       "]"}], "&"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", "100", ",", "2"}], "]"}]}], "]"}], "/.", " ", 
   RowBox[{"$Failed", "->", "None"}]}]}]], "Input",
