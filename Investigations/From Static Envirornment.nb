             RowBox[{"BooleanConvert", "[", 
              RowBox[{"bf", ",", "\"\<CNF\>\""}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], ",", "\n", 
         RowBox[{"{", "\n", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"BooleanMinimize", "[", 
