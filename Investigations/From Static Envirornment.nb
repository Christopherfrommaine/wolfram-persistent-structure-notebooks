Cell[BoxData[
 RowBox[{
  RowBox[{"thing", "[", 
   RowBox[{"rule_", ",", " ", "init_"}], "]"}], ":=", 
  RowBox[{"SelectFirst", "[", 
   RowBox[{
    RowBox[{"RunCA", "[", 
     RowBox[{"rule", ",", " ", "init", ",", " ", "100"}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"row", "|->", 
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"StripZeros", "[", "row", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sequence", "@@", "init"}], ",", " ", 
           RowBox[{"Repeated", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"{", 
              RowBox[{"8", ",", " ", "Infinity"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Sequence", "@@", "init"}]}], "}"}]}], "]"}]}], ")"}], 
     "->", "\"\<Index\>\""}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.99563501249012*^9, 3.995635014676371*^9}, {
