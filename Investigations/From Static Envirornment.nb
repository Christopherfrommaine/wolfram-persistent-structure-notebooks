 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GoodRuleCondition", "[", " ", 
      RowBox[{"K_", ",", " ", "R_"}], "]"}], "[", "rule_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"Last", "[", 
         RowBox[{"CellularAutomaton", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rule", ",", " ", "K", ",", " ", "R"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RandomInteger", "[", 
              RowBox[{
               RowBox[{"K", "-", "1"}], ",", "100"}], "]"}], ",", "0"}], 
            "}"}], ",", "100"}], "]"}], "]"}], "]"}], ">", "150"}], ",", 
      "False", ",", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"StripZeros", "[", 
                RowBox[{"CellularAutomaton", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"rule", ",", "K", ",", " ", "R"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{
                    RowBox[{"K", "-", "1"}], ",", "100"}], "]"}], ",", "0"}], 
                   "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"{", "100", "}"}], "}"}], "}"}]}], "]"}], "]"}], 
               "]"}], ",", "10"}], "]"}], ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"StripZeros", "[", 
                RowBox[{"CellularAutomaton", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"rule", ",", " ", "K", ",", " ", "R"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{
                    RowBox[{"K", "-", "1"}], ",", "20"}], "]"}], ",", "0"}], 
                   "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"{", "100", "}"}], "}"}], "}"}]}], "]"}], "]"}], 
               "]"}], ",", "10"}], "]"}]}], "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Mean", "[", "l", "]"}], "<", "100"}], "&&", 
         RowBox[{
          RowBox[{"Min", "[", "l", "]"}], "\[Equal]", "0"}], "&&", 
         RowBox[{
          RowBox[{"Max", "[", "l", "]"}], ">", "0"}]}]}], "]"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GoodTotalisticRuleCondition", "[", " ", 
      RowBox[{"K_", ",", " ", "R_"}], "]"}], "[", "rule_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
