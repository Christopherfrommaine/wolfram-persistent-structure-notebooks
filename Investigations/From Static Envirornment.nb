Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"k", "=", "4"}], ";", 
  RowBox[{"r", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"identityRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FromDigits", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"Reverse", "@", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"k", "-", "1"}]}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"2", "r"}], "+", "1"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"r", "+", "1"}]}], "]"}], "]"}], ",", " ", "k"}], "]"}], ",",
      " ", "k", ",", " ", "r"}], "}"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxmut", "=", 
   RowBox[{"2", "*", 
    RowBox[{"(", 
     RowBox[{"k", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "r"}], "+", "1"}], ")"}]}], ")"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Generate", " ", "many", " ", "mutations"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rules", "=", 
    RowBox[{"Union", "[", 
     RowBox[{"Join", "@@", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Union", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"PointMutateChoiceSym", "[", 
            RowBox[{"identityRule", ",", " ", "mutations"}], "]"}], ",", " ", 
           "100"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"mutations", ",", " ", "0", ",", " ", "maxmut"}], "}"}]}], 
       "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  
  RowBox[{"(*", " ", 
   RowBox[{"Group", " ", "by", " ", "mutation", " ", "distance"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rules", "=", 
    RowBox[{
     RowBox[{"Values", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", "}"}], "&"}], ",", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", "maxmut"}], "]"}]}], "]"}], ",", 
        RowBox[{"GroupBy", "[", 
         RowBox[{"rules", ",", " ", 
          RowBox[{
           RowBox[{"HammingDistance", "[", 
            RowBox[{
             RowBox[{"IntegerDigits", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", "k", ",", " ", 
               RowBox[{"k", "^", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"2", "r"}], "+", "1"}], ")"}]}]}], "]"}], ",", " ", 
             
             RowBox[{"IntegerDigits", "[", 
              RowBox[{
               RowBox[{"identityRule", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", "k", ",", " ", 
               RowBox[{"k", "^", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"2", "r"}], "+", "1"}], ")"}]}]}], "]"}]}], "]"}], 
           "&"}]}], "]"}]}], "]"}], "]"}], "//.", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x__", ",", " ", 
        RowBox[{"{", "}"}]}], "}"}], "->", 
      RowBox[{"{", "x", "}"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "rules", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "/@", "rules"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", 
  RowBox[{"Join", "@@", "rules"}], "]"}]}], "Input",
