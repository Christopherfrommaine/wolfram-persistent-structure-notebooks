Cell[BoxData[{
 RowBox[{"Clear", "[", "ProgressMap", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f_", ",", " ", "l_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"stdout", "=", 
       RowBox[{"PrintTemporary", "[", "\"\<\>\"", "]"}]}], ",", " ", 
      RowBox[{"len", "=", 
       RowBox[{"Length", "[", "l", "]"}]}], ",", " ", 
      RowBox[{"begin", "=", 
       RowBox[{"TimeObject", "[", "]"}]}], ",", " ", "cur", ",", " ", "avg", ",",
       "eta", ",", " ", "tmp"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"tmp", "=", 
        RowBox[{"f", "[", 
         RowBox[{"l", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"NotebookDelete", "[", "stdout", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cur", "=", 
        RowBox[{"TimeObject", "[", "]"}]}], ";", 
       RowBox[{"avg", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"cur", "-", "begin"}], ")"}], "/", "i"}]}], ";", 
       RowBox[{"eta", "=", 
        RowBox[{"begin", "+", 
         RowBox[{"len", "*", "avg"}]}]}], ";", 
       RowBox[{"stdout", "=", 
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"\"\<Step \>\"", "<>", 
          RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\</\>\"", "<>", 
          RowBox[{"ToString", "[", "len", "]"}], "<>", "\"\< (\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"N", "[", 
            RowBox[{"100", "*", 
             RowBox[{"i", "/", "len"}]}], "]"}], "]"}], 
          "<>", "\"\<% complete, Avg Time \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"QuantityMagnitude", "[", 
            RowBox[{"avg", ",", "\"\<Seconds\>\""}], "]"}], "]"}], 
          "<>", "\"\< seconds per elem, ETA \>\"", "<>", 
          RowBox[{"DateString", "[", 
           RowBox[{"eta", ",", " ", "\"\<DateTimeShort\>\""}], "]"}], 
          "<>", "\"\<)\>\""}], "]"}]}], ";", " ", "\[IndentingNewLine]", 
       "tmp"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "len"}], "}"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f_", ",", " ", "l_Integer"}], "]"}], ":=", 
  RowBox[{"ProgressMap", "[", 
   RowBox[{"f", ",", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", "l"}], "]"}]}], "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.994503318339373*^9, 3.994503399824003*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"1a53c51b-a3ef-4ca4-a658-62abc2f9ecc1"]
