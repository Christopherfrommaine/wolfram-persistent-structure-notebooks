Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"FullStructureSearchRaw", ",", " ", "FullStructureSearch"}], "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FullStructureSearchRaw", "[", 
    RowBox[{"rules_", ",", " ", 
     RowBox[{"min_", ":", "0"}], ",", " ", 
     RowBox[{"max_", ":", "1000000"}], ",", " ", 
     RowBox[{"timeout_", ":", "1000"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ress", ",", "nontrivial"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"FixInteresting", "[", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Prep", " ", "memoization", " ", "in", " ", "a", " ", "parallel", " ", 
        "manner"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{"AnalyzeRule", ",", " ", "rules"}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"ress", "=", 
       RowBox[{"ProgressMap", "[", 
        RowBox[{
         RowBox[{"rule", "|->", 
          RowBox[{"{", 
           RowBox[{"rule", ",", " ", 
            RowBox[{"GPUStructureSearch", "[", 
             RowBox[{
             "rule", ",", " ", "min", ",", " ", "max", ",", " ", "timeout"}], 
             "]"}]}], "}"}]}], ",", " ", "rules"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ress", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"ress", ",", " ", 
         RowBox[{"ListQ", "@*", "Last"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"Length", "[", "ress", "]"}], 
        ",", "\"\< rules searched with results: \>\"", ",", 
        RowBox[{"Iconize", "[", "ress", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"nontrivial", "=", 
       RowBox[{"ParallelSelect", "[", 
        RowBox[{"ress", ",", " ", "NonTrivialMetricRaw"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "nontrivial", "]"}], "<", "10"}], ",", " ", 
        RowBox[{"nontrivial", "=", "ress"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"Length", "[", "nontrivial", "]"}], ",", 
        " ", "\"\< nontrivial results: \>\"", ",", " ", 
        RowBox[{"Iconize", "[", "nontrivial", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
