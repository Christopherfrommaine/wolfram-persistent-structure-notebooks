 RowBox[{"Clear", "[", "ThereExistsInitWhichDoesntGrowInfinitelyOrDie", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ThereExistsInitWhichDoesntGrowInfinitelyOrDie", "[", 
   RowBox[{"rule_", ",", " ", 
    RowBox[{"numChecks_", ":", "100"}]}], "]"}], ":=", 
  RowBox[{"AnyTrue", "[", 
   RowBox[{
    RowBox[{"Range", "[", "numChecks", "]"}], ",", 
    RowBox[{"seed", "|->", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "seed", "]"}], ";", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{"l", "=", 
           RowBox[{"Length", "[", 
            RowBox[{"StripZeros", "[", "\[IndentingNewLine]", 
             RowBox[{"RunCA", "[", 
              RowBox[{"rule", ",", " ", 
               RowBox[{"RandomInteger", "[", 
                RowBox[{"k", "^", "40"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"{", "50", "}"}], "}"}], "}"}]}], "]"}], 
             "\[IndentingNewLine]", "]"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"l", ">", "0"}], "&&", 
          RowBox[{"l", "<", "40"}]}]}], "\[IndentingNewLine]", "]"}]}], 
      ")"}]}]}], "]"}]}]}], "Input",
