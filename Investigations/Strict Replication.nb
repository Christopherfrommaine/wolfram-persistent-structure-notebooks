                    RowBox[{"K", "-", "1"}], ",", "100"}], "]"}], ",", "0"}], 
                   "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"{", "100", "}"}], "}"}], "}"}]}], "]"}], "]"}], 
               "]"}], ",", "10"}], "]"}], ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"StripZeros", "[", 
                RowBox[{"CellularAutomaton", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"rule", ",", " ", "K", ",", " ", "R"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{
                    RowBox[{"K", "-", "1"}], ",", "20"}], "]"}], ",", "0"}], 
                   "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"{", "100", "}"}], "}"}], "}"}]}], "]"}], "]"}], 
               "]"}], ",", "10"}], "]"}]}], "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Mean", "[", "l", "]"}], "<", "100"}], "&&", 
         RowBox[{
          RowBox[{"Min", "[", "l", "]"}], "\[Equal]", "0"}], "&&", 
         RowBox[{
          RowBox[{"Max", "[", "l", "]"}], ">", "0"}]}]}], "]"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
