Cell[BoxData[{
 RowBox[{"Clear", "[", "DecentRunLength", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DecentRunLength", "[", 
    RowBox[{"res_", ",", " ", "default_"}], "]"}], ":=", 
   RowBox[{"Round", "@", 
    RowBox[{"Min", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"KeyExistsQ", "[", 
         RowBox[{"res", ",", " ", "\"\<Period\>\""}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"2.2", "*", " ", 
          RowBox[{"res", "[", "\"\<Period\>\"", "]"}]}], "+", "30"}], ",", 
        " ", "default"}], "]"}], ",", " ", "500"}], "]"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "DecentRunLengthRaw", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DecentRunLengthRaw", "[", 
   RowBox[{"rule_", ",", " ", "res_", ",", " ", "default_"}], "]"}], ":=", 
  RowBox[{"Round", "@", 
   RowBox[{"Min", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", "=", 
         RowBox[{
          RowBox[{"AnalyzeRule", "[", "rule", "]"}], "[", "\"\<Colors\>\"", 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"FindRepeatDeterministicByStripZeros", "[", 
           RowBox[{"CellularAutomaton", "[", 
            RowBox[{"rule", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"IntegerDigits", "[", 
                RowBox[{"res", ",", " ", "k"}], "]"}], ",", " ", "0"}], "}"}],
              ",", " ", "default"}], "]"}], "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"p", "!=", "0"}], ",", " ", 
         RowBox[{
          RowBox[{"2.2", "*", "p"}], "+", "30"}], ",", " ", "default"}], 
        "]"}]}], "]"}], ",", " ", "500"}], "]"}]}]}]}], "Input",
