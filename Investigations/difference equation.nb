Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "9"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FromRules", "[", "rules_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"o", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "^", "n"}], ",", " ", 
           RowBox[{"2", "^", "n"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"o", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"1", "+", 
             RowBox[{
              RowBox[{"rule", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
            RowBox[{"1", "+", 
             RowBox[{
              RowBox[{"rule", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], "]"}], "=", 
         RowBox[{"rule", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"rule", ",", " ", "rules"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "o"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rules", "=", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"HilbertCurve", "[", "n", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "->", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"UniqueColor", "@", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"Reverse", "[", "#", "]"}]}], "]"}], "&"}], "[", 
           RowBox[{
            RowBox[{
             RowBox[{"FromDigits", "[", 
              RowBox[{"#", ",", " ", "3"}], "]"}], "&"}], "/@", 
            RowBox[{"FindRepeatDeterministicByStripZeros", "[", 
             RowBox[{"RunCA", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1329", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", "1"}], "}"}],
                ",", " ", "i", ",", " ", "100"}], "]"}], "]"}]}], "]"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "1", ",", 
          RowBox[{"2", "*", 
           RowBox[{"4", "^", "n"}]}], ",", " ", "2"}], "}"}]}], "]"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ArrayPlot", "[", 
  RowBox[{
   RowBox[{"FromRules", "[", "rules", "]"}], ",", " ", 
   RowBox[{"Frame", "->", "False"}]}], "]"}]}], "Input",
