Cell[BoxData[
 RowBox[{
  RowBox[{"SplitSeparateSolutions", "[", "carun_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bits", ",", " ", "mc", ",", " ", "numcolors"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bits", "=", 
      RowBox[{
       RowBox[{"carun", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"1", ";;", 
           RowBox[{"-", "4"}]}]}], "]"}], "]"}], "+", 
       RowBox[{"carun", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"2", ";;", 
           RowBox[{"-", "3"}]}]}], "]"}], "]"}], "+", 
       RowBox[{"carun", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"3", ";;", 
           RowBox[{"-", "2"}]}]}], "]"}], "]"}], "+", 
       RowBox[{"carun", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"4", ";;", 
           RowBox[{"-", "1"}]}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mc", "=", 
      RowBox[{"MorphologicalComponents", "[", 
       RowBox[{
        RowBox[{"Image", "[", "bits", "]"}], ",", " ", 
        RowBox[{"CornerNeighbors", "->", "False"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"numcolors", "=", 
      RowBox[{"Max", "[", "mc", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Unitize", "[", 
           RowBox[{"c", "-", "mc"}], "]"}]}], ")"}], "*", 
        RowBox[{"carun", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", 
           RowBox[{";;", 
            RowBox[{"-", "4"}]}]}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "numcolors"}], "}"}]}], "]"}]}]}], 
