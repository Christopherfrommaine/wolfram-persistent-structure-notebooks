          RowBox[{
           RowBox[{"a", "[", "False", "]"}], "->", 
           RowBox[{"a", "[", "0", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"a", "[", "True", "]"}], "->", 
           RowBox[{"a", "[", "1", "]"}]}]}], "}"}]}], "]"}]}], "}"}], ",", 
    " ", 
