  RowBox[{"TestExpression", "[", 
   RowBox[{"expr_", ",", " ", "n_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"newexpr", "=", 
