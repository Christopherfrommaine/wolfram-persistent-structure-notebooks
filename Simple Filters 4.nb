                 RowBox[{"Filter2", "[", 
                  RowBox[{
                   RowBox[{"BitShiftRight", "[", 
                    RowBox[{"o", ",", " ", 
                    RowBox[{"IntegerExponent", "[", 
                    RowBox[{"o", ",", " ", "2"}], "]"}]}], "]"}], "->", 
                   "init"}], "]"}]}], "]"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"o", "=", 
                 RowBox[{"FromDigits", "[", 
                  RowBox[{
                   RowBox[{"ilastcarun", "[", 
                    RowBox[{"[", 
                    RowBox[{"pos", ";;"}], "]"}], "]"}], ",", " ", "2"}], 
                  "]"}]}], "}"}], ",", "  ", 
               RowBox[{"If", "[", 
