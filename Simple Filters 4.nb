            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"Values", "[", "res2", "]"}]}], "}"}]}], "]"}]}], "]"}],
         ",", " ", 
        RowBox[{"#Canonical", "&"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Prepend", "[", 
  RowBox[{
   RowBox[{"Length", "/@", 
    RowBox[{"{", 
     RowBox[{"res1", ",", " ", "res2", ",", " ", "res3"}], "}"}]}], ",", " ", 
   
   RowBox[{"maximumIndex", "-", "minimumIndex"}]}], "]"}]}], "Input",
