Cell[BoxData[{
 RowBox[{"Clear", "[", "GenerateFilter2", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GenerateFilter2", "[", 
    RowBox[{
     RowBox[{"maxSteps_Integer", ":", "100"}], ",", 
     RowBox[{"maxPeriod_Integer", ":", "1000"}]}], "]"}], "[", 
   RowBox[{"end_", "->", "init_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "caruninit", ",", " ", "carun", ",", " ", "frd", ",", " ", "canonical", ",",
       " ", "seen", ",", " ", "ilastcarun"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"seen", "=", 
      RowBox[{"CreateDataStructure", "[", "\"\<HashSet\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"caruninit", "=", 
      RowBox[{"NestWhile", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"o", "=", 
             RowBox[{"BitShiftRight", "[", 
              RowBox[{"#", ",", " ", 
               RowBox[{"IntegerExponent", "[", 
                RowBox[{"#", ",", " ", "2"}], "]"}]}], "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "=", 
              RowBox[{"BitShiftLeft", "[", 
               RowBox[{"o", ",", " ", "3"}], "]"}]}], ",", " ", 
             RowBox[{"b", "=", 
              RowBox[{"BitShiftLeft", "[", 
               RowBox[{"o", ",", " ", "2"}], "]"}]}], ",", " ", 
             RowBox[{"c", "=", 
              RowBox[{"BitShiftLeft", "[", 
               RowBox[{"o", ",", " ", "1"}], "]"}]}], ",", " ", 
             RowBox[{"d", "=", 
              RowBox[{"BitShiftRight", "[", 
               RowBox[{"o", ",", " ", "1"}], "]"}]}]}], "}"}], ",", 
           "\[IndentingNewLine]", " ", 
           RowBox[{"BitXor", "[", 
            RowBox[{
             RowBox[{"BitXor", "[", 
              RowBox[{
              "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", " ", 
               "o"}], "]"}], ",", " ", 
             RowBox[{"BitOr", "[", 
              RowBox[{
              "a", ",", " ", "b", ",", " ", "c", ",", " ", "d", ",", " ", 
               "o"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", "]"}], "&"}], ",",
         "\[IndentingNewLine]", " ", "end", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "!=", "0"}], "&&", 
          RowBox[{"seen", "[", 
           RowBox[{"\"\<Insert\>\"", ",", " ", "#"}], "]"}]}], "&"}], ",", 
        "1", ",", "maxSteps"}], "\[IndentingNewLine]", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"caruninit", "==", "0"}], ",", " ", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"ilastcarun", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{"caruninit", ",", " ", "2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MaxGapLength", "[", "ilastcarun", "]"}], ">", "10"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"pos", "=", 
           RowBox[{"MaxGapLengthPosition", "[", "ilastcarun", "]"}]}], "}"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"Join", "@@", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"o", "=", 
                 RowBox[{"FromDigits", "[", 
                  RowBox[{
                   RowBox[{"ilastcarun", "[", 
                    RowBox[{"[", 
