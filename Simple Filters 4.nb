      RowBox[{"n", ",", " ", "2"}], "]"}], ",", " ", "args"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DetectPeriodSub", "[", 
   RowBox[{"list_", ",", " ", "steps_", ",", " ", "maxdepth_"}], "]"}], ":=", 
  
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "carun", ",", " ", "frd", ",", " ", "separatesolutions", ",", " ", 
      "period", ",", " ", "canonical", ",", " ", "shift"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"maxdepth", "<", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", "\"\<Something Went Wrong.\>\"", "]"}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"carun", "=", 
           RowBox[{"RunCode20", "[", 
            RowBox[{"list", ",", " ", "steps"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"If", " ", "it", " ", "dies"}], ",", " ", "return"}], " ", 
          "*)"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"AllZeros", "[", 
            RowBox[{"carun", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"Return", "[", 
            RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Detect", " ", "Periodicity"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"frd", "=", 
          RowBox[{
          "FindRepeatDeterministicByStripZeros", "[", "carun", "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"maxdepth", "<=", "0"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "frd", "]"}], "==", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Return", "[", 
              RowBox[{"{", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Period\>\"", "->", "0"}], ",", " ", 
                 RowBox[{"\"\<IsGliderGun\>\"", "->", "True"}]}], "|>"}], 
               "}"}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Return", "[", 
               RowBox[{"{", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Period\>\"", "->", 
                   RowBox[{"Length", "[", "frd", "]"}]}], ",", 
                  RowBox[{"\"\<Canonical\>\"", "->", 
                   RowBox[{"Last", "[", "frd", "]"}]}], ",", " ", 
                  RowBox[{"\"\<IsUnfinished\>\"", "->", "True"}]}], "|>"}], 
                "}"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], "]"}], 
         ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "If", " ", "unfinished", " ", "and", " ", "probably", " ", 
           "unseparated"}], ",", " ", 
          RowBox[{"recurse", " ", "with", " ", "more", " ", "steps"}]}], " ", 
         "*)"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "frd", "]"}], "==", "0"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"MaxGapLength", "[", 
               RowBox[{"carun", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], "]"}], ">", "5"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"separatesolutions", "=", 
               RowBox[{"SplitSeparateSolutions", "[", "carun", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Join", "@@", 
               RowBox[{"Table", "[", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"DetectPeriod", "[", 
                  RowBox[{"subsolution", ",", " ", "steps", ",", " ", 
                   RowBox[{"maxdepth", "-", "1"}]}], "]"}], ",", 
                 "\[IndentingNewLine]", " ", 
                 RowBox[{"{", 
                  RowBox[{"subsolution", ",", " ", "separatesolutions"}], 
                  "}"}]}], "\[IndentingNewLine]", "]"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"DetectPeriod", "[", 
              RowBox[{
               RowBox[{"carun", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"2", " ", "*", " ", "steps"}], ",", " ", 
               RowBox[{"maxdepth", " ", "-", " ", "1"}]}], "]"}]}], 
            "\[IndentingNewLine]", "]"}], "]"}]}], "\[IndentingNewLine]", 
         "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Otherwise", ",", " ", 
          RowBox[{
          "run", " ", "again", " ", "for", " ", "pure", " ", 
           "periodicity"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"carun", "=", 
         RowBox[{"RunCode20", "[", 
          RowBox[{
           RowBox[{"carun", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", "steps"}], "]"}]}], 
        ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"If", " ", 
          RowBox[{"it", "'"}], "s", " ", "multiperiodic"}], ",", " ", 
         RowBox[{"split", " ", "solutions"}]}], " ", "*)"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"separatesolutions", "=", 
        RowBox[{"SplitSeparateSolutions", "[", 
         RowBox[{"carun", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Length", "[", "frd", "]"}]}], ";;"}], "]"}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"separatesolutions", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{"separatesolutions", ",", 
          RowBox[{
           RowBox[{"First", "[", 
            RowBox[{"FirstPosition", "[", 
             RowBox[{"#", ",", " ", "1", ",", " ", "0"}], "]"}], "]"}], 
           "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Recurse", " ", "on", " ", "each", " ", "subsolution"}], ",", 
        " ", 
        RowBox[{"if", " ", "they", " ", "exist"}]}], " ", "*)"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "separatesolutions", "]"}], ">", "1"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"Join", "@@", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"DetectPeriod", "[", 
             RowBox[{"subsolution", ",", " ", "steps", ",", " ", 
              RowBox[{"maxdepth", "-", "1"}]}], "]"}], ",", 
            "\[IndentingNewLine]", " ", 
            RowBox[{"{", 
             RowBox[{"subsolution", ",", " ", "separatesolutions"}], "}"}]}], 
           "\[IndentingNewLine]", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
       "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Return", " ", "single"}], "-", 
       RowBox[{"solution", " ", "period"}]}], " ", "*)"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"period", "=", 
      RowBox[{"Length", "[", "frd", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"canonical", "=", 
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"FromDigits", "[", 
            RowBox[{
             RowBox[{"StripZeros", "[", "#", "]"}], ",", "2"}], "]"}], "&"}], 
          "/@", "frd"}], "]"}], ",", " ", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"FromDigits", "[", 
            RowBox[{
             RowBox[{"StripZeros", "[", 
              RowBox[{"Reverse", "[", "#", "]"}], "]"}], ",", "2"}], "]"}], 
           "&"}], "/@", "frd"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"carun", "=", 
      RowBox[{"RunCode20", "[", 
       RowBox[{
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"canonical", ",", " ", "2"}], "]"}], ",", " ", "period"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"shift", "=", 
      RowBox[{"Log2", "[", 
       RowBox[{
        RowBox[{"FromDigits", "[", 
         RowBox[{
          RowBox[{"First", "[", "carun", "]"}], ",", " ", "2"}], "]"}], "/", 
        RowBox[{"FromDigits", "[", 
         RowBox[{
          RowBox[{"Last", "[", "carun", "]"}], ",", " ", "2"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Period\>\"", "->", "period"}], ",", 
         RowBox[{"\"\<Canonical\>\"", "->", "canonical"}], ",", " ", 
         RowBox[{"\"\<Shift\>\"", "->", "shift"}]}], "|>"}], "}"}], "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
