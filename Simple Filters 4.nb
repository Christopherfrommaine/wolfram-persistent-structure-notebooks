        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"o", "=", 
            RowBox[{"Cast", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"2", "*", "oOrig"}], " ", "+", " ", "1"}], ",", 
              " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"count", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{"While", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"o", "!=", "0"}], "&&", 
              RowBox[{"count", "<", "200"}], "&&", 
              RowBox[{
               RowBox[{"BitAnd", "[", 
                RowBox[{"o", ",", " ", 
                 RowBox[{"TypeHint", "[", 
                  RowBox[{
                  "16140901064495857664", ",", 
                   " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], "]"}], "==", 
