Cell[BoxData[{
 RowBox[{
  RowBox[{"CompressAssociation", "[", "a_", "]"}], ":=", 
  RowBox[{"NumericArray", "[", 
   RowBox[{
    RowBox[{"List", "@@@", 
     RowBox[{"Normal", "[", "a", "]"}]}], ",", 
    " ", "\"\<UnsignedInteger64\>\""}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"UncompressAssociation", "[", "a_", "]"}], ":=", 
  RowBox[{"Association", "[", 
   RowBox[{"Rule", "@@@", 
    RowBox[{"Normal", "[", "a", "]"}]}], "]"}]}]}], "Input",
