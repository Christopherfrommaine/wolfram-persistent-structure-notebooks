Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DetectPeriod", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DetectPeriod", "[", 
    RowBox[{"list_List", ",", " ", 
     RowBox[{"steps_", ":", "200"}], ",", " ", 
     RowBox[{"maxdepth_", ":", "20"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Canonical\>\"", "->", 
          RowBox[{"FromDigits", "[", 
           RowBox[{"list", ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{"\"\<Original\>\"", "->", 
          RowBox[{"FromDigits", "[", 
           RowBox[{"list", ",", " ", "2"}], "]"}]}]}], "|>"}], ",", " ", 
       "#"}], "]"}], "&"}], "/@", 
    RowBox[{"DetectPeriodSub", "[", 
