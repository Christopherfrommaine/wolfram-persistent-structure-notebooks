              RowBox[{"BitShiftLeft", "[", 
               RowBox[{"o", ",", " ", "1"}], "]"}]}], ",", " ", 
             RowBox[{"d", "=", 
              RowBox[{"BitShiftRight", "[", 
               RowBox[{"o", ",", " ", "1"}], "]"}]}]}], "}"}], ",", " ", 
           RowBox[{"BitXor", "[", 
            RowBox[{
             RowBox[{"BitXor", "[", 
