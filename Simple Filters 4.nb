Cell[BoxData[{
 RowBox[{
  RowBox[{"minimum", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maximum", "=", "1000000"}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Largest", " ", "Initial", " ", "Condition", " ", "to", " ", "be", " ", 
    "Checked"}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minimumIndex", "=", 
   RowBox[{"Floor", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"minimum", "-", "1"}], ")"}], "/", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maximumIndex", "=", 
    RowBox[{"Ceiling", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"maximum", "+", "1"}], ")"}], "/", "2"}], "]"}]}], ";"}], " ", 
  
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Divide", " ", "by", " ", "2"}], ",", " ", 
    RowBox[{"because", " ", "only", " ", "odd", " ", "numbers"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stepSize", "=", 
    RowBox[{"Ceiling", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"maximumIndex", "-", "minimumIndex"}], ")"}], "/", "100"}], 
     "]"}]}], ";"}], " ", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"batches", "=", 
    RowBox[{"Ceiling", "[", 
