Cell[BoxData[
 RowBox[{
  RowBox[{"GetFinishedJobs", "[", "batch_", "]"}], ":=", 
  RowBox[{"Catenate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Catenate", "[", 
      RowBox[{
       RowBox[{"#", "[", "\"\<EvaluationData\>\"", "]"}], 
       "[", "\"\<Result\>\"", "]"}], "]"}], "&"}], "/@", 
    RowBox[{"Values", "[", 
     RowBox[{"Pick", "[", 
      RowBox[{
       RowBox[{"batch", "[", "\"\<ChildJobObjects\>\"", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Equal", "[", 
          RowBox[{"\"\<Succeeded\>\"", ",", " ", "#"}], "]"}], "&"}], "/@", 
        RowBox[{"Values", "[", 
         RowBox[{"batch", "[", "\"\<ChildJobStatuses\>\"", "]"}], "]"}]}]}], 
      "]"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9900229859181137`*^9, 3.990022998087667*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"5747d4d8-365d-4be4-af32-5db6f931af70"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"minimum", "=", "222000000000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maximum", "=", "223000000000"}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Largest", " ", "Initial", " ", "Condition", " ", "to", " ", "be", " ", 
    "Checked"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numBatches", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"numPar", "=", "16"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minimumIndex", "=", 
   RowBox[{"Floor", "[", 
    RowBox[{"minimum", "/", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maximumIndex", "=", 
    RowBox[{"Ceiling", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"maximum", "-", "1"}], ")"}], "/", "2"}], "]"}]}], ";"}], " ", 
  
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Divide", " ", "by", " ", "2"}], ",", " ", 
    RowBox[{"because", " ", "only", " ", "odd", " ", "numbers"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"batchStep", "=", 
   RowBox[{"Ceiling", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"maximumIndex", "-", "minimumIndex"}], ")"}], "/", 
     "numBatches"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"parStep", "=", 
    RowBox[{"Ceiling", "[", 
     RowBox[{"batchStep", "/", "numPar"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"code20cloud", " ", "=", " ", 
    RowBox[{"CloudPut", "[", 
     RowBox[{"Nothing", ",", "\"\<christophercode20results\>\""}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BatchFunction", "[", "batchIndex_Integer", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"batchOffset", "=", 
       RowBox[{"minimumIndex", "+", 
        RowBox[{"batchIndex", "*", "batchStep"}]}]}], ",", " ", "res1batch", ",",
       "res2batch", ",", "res3batch"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"res1batch", "=", 
      RowBox[{"Join", "@@", 
       RowBox[{"Reverse", "[", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"Filter1", "[", 
           RowBox[{"offset", ",", " ", 
            RowBox[{"offset", "+", "parStep", "-", "1"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"offset", ",", " ", "batchOffset", ",", " ", 
            RowBox[{"batchOffset", "+", "batchStep", "-", "1"}], ",", " ", 
            "parStep"}], "}"}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res2batch", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Association", "[", 
        RowBox[{"ReverseSort", "[", 
         RowBox[{"Join", "@@", 
          RowBox[{"ParallelMap", "[", 
           RowBox[{"Filter2", ",", 
            RowBox[{"Normal", "[", "res1batch", "]"}]}], "]"}]}], "]"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"res3batch", "=", 
      RowBox[{"SortBy", "[", 
       RowBox[{
        RowBox[{"DedupSame", "[", 
         RowBox[{"Join", "@@", 
          RowBox[{"ParallelTable", "[", 
           RowBox[{
            RowBox[{"Union", "[", 
             RowBox[{"DetectPeriod", "[", "i", "]"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{"Values", "[", "res2batch", "]"}]}], "}"}]}], "]"}]}], 
         "]"}], ",", " ", 
        RowBox[{"#Canonical", "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Complement", "[", 
         RowBox[{"res3batch", ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "151", ",", "187", ",", "189", ",", "635", ",", "15903", ",", 
            "125231", ",", "595703", ",", "610999", ",", "14871103", ",", 
            "22503642597", ",", "222678959859", ",", "10469510870511", ",", 
            "360759087837221", ",", "2197520782601119", ",", 
            "11221488970893447375", ",", "142082121178470981231", ",", 
            "2810468130557941198319"}], "}"}]}], "]"}], "!=", "0"}], ",", " ", 
       RowBox[{"SendMail", "[", 
        RowBox[{
         RowBox[{"{", 
          
          RowBox[{"\"\<wlmailtest@wolfram.com\>\"", ",", 
           " ", "\"\<christopherfrommaine@gmail.com\>\""}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Possible new code20 solution?\>\"", ",", " ", 
           RowBox[{"ToString", "[", "res3batch", "]"}]}], "}"}]}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"PutAppend", "[", 
      RowBox[{"res3batch", ",", " ", "code20cloud"}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "res3batch"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
