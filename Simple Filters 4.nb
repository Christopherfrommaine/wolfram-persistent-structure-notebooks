Cell[BoxData[{
 RowBox[{"Clear", "[", "PseudoRemoteBatchMapSubmit", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PseudoRemoteBatchMapSubmit", "[", 
   RowBox[{"f_", ",", " ", "list_", ",", " ", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "RemoteBatchMapSubmit", "]"}]}]}], "]"}], 
  ":=", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<EvaluationResults\>\"", "->", 
     RowBox[{"Map", "[", 
      RowBox[{"f", ",", " ", "list"}], "]"}]}], ",", " ", 
    RowBox[{"\"\<JobStatus\>\"", "->", "\"\<Succeeded\>\""}], ",", " ", 
    RowBox[{"\"\<DynamicStatusVisualization\>\"", "->", "\"\<N/A\>\""}]}], 
   "|>"}]}]}], "Input",
 CellChangeTimes->{{3.9900155468786507`*^9, 3.990015604641464*^9}, {
