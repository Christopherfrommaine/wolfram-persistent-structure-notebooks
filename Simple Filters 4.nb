      RowBox[{"(", 
       RowBox[{"maximumIndex", "-", "minimumIndex"}], ")"}], "/", 
      "stepSize"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"res1", "=", 
     RowBox[{"EchoTiming", "[", 
      RowBox[{"Join", "@@", 
       RowBox[{"Reverse", "[", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"Filter1", "[", 
           RowBox[{"offset", ",", " ", 
            RowBox[{"offset", "+", "stepSize", "-", "1"}]}], "]"}], ",", " ", 
          
          RowBox[{"{", 
           RowBox[{"offset", ",", " ", "minimumIndex", ",", " ", 
            RowBox[{"maximumIndex", "-", "1"}], ",", " ", "stepSize"}], 
           "}"}]}], "]"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"res2", "=", 
     RowBox[{"EchoTiming", "[", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Association", "[", 
        RowBox[{"ReverseSort", "[", 
         RowBox[{"Join", "@@", 
          RowBox[{"ParallelMap", "[", 
           RowBox[{"Filter2", ",", 
            RowBox[{"Normal", "[", "res1", "]"}]}], "]"}]}], "]"}], "]"}], 
       "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"res3", "=", 
     RowBox[{"EchoTiming", "[", 
      RowBox[{"SortBy", "[", 
       RowBox[{
        RowBox[{"DedupSame", "[", 
         RowBox[{"Join", "@@", 
          RowBox[{"ParallelTable", "[", 
           RowBox[{
            RowBox[{"Union", "[", 
