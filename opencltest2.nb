    RowBox[{"\"\<\n__kernel void doubleVec(__global ulong * in,  ulong \
length) {\n    int index = get_global_id(0);\n\n\tif (index < length)\n\t  \
in[index] = 2*in[index];\n  }\>\"", ",", " ", "\"\<doubleVec\>\"", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "_Integer", "}"}], ",", "_Integer"}], "}"}], ",", "256"}],
     "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vec", "=", 
    RowBox[{"Range", "[", "20", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"doubleFun", "[", 
  RowBox[{"vec", ",", "20"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9907892818854523`*^9, 3.990789300670639*^9}},
 CellLabel->"In[22]:=",
 CellID->1151299483,ExpressionUUID->"b081a13c-4e5c-44fe-be58-e8ca4c7494f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "src", "=", "\"\<__kernel void myKernel( __global mint * global0Id, \
__global mint * global1Id, mint width, mint height) {\n    int xIndex = \
get_global_id(0);\n    int yIndex = get_global_id(1);\n    int index = xIndex \
+ yIndex*width;\n\tif (xIndex < width && yIndex < height) {\n\t   \
global0Id[index] = get_local_id(0);\n       global1Id[index] = \
get_local_id(1);\n    }\n  }\>\""}], ";"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->195947038,ExpressionUUID->"bfb26272-4609-4041-bdc1-36b601e50717"],

