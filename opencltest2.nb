Cell[BoxData[
 RowBox[{"filter51", "=", 
  RowBox[{"OpenCLFunctionLoad", "[", 
   RowBox[{"\"\<\n#define STEPS1 100\n#define STEPS2 150\n#define STEPS3 100\n\
#define STEPS4 50\n\n#define TOPMOSTBITSMASK 0xE000000000000000\n\nint \
pos_gap_length_greater_than_four(ulong n) {\n    if (n == 0) {return 0;}\n\n  \
  ulong col = (~n) & (~0UL >> clz(n));  // mask off leading zeros of n\n\n    \
col = (col) & (col << 1) & (col << 2) & (col << 3);\n\n    return ctz(col);\n\
}\n\n__kernel void search_matches(__global ulong *matches,\n                  \
           __global uint *match_count,\n                             const \
ulong max_matches)\n{\n    ulong gid = get_global_id(0);\n\n    ulong n = \
gid;\n\n    ulong o = (n << 1) | 1;\n    ulong oOrig = o;\n    \n    int \
count = 0;\n    while (o >= oOrig && count < STEPS1 && o != 0 && (o & \
TOPMOSTBITSMASK) == 0) {\n        count++;\n\n        ulong a = o << 3;\n     \
   ulong b = o << 2;\n        ulong c = o << 1;\n        ulong d = o >> 1;\n  \
      o = (a | b | c | d | o) ^ (a ^ b ^ c ^ d ^ o);\n\n        o = o >> (((o \
& 0xF) == 0) << 2);\n    }\n\n    o = o >> ctz(o);\n\n    if (o < oOrig) \
{return;}\n\n    count = 0;\n    ulong accum = o;\n    ulong minim = o;\n    \
ulong collected = o;\n    while (minim >= oOrig && count < STEPS2 && o != 0 \
&& accum != 0 && (o & TOPMOSTBITSMASK) == 0) {\n        count++;\n\n        \
ulong a = o << 3;\n        ulong b = o << 2;\n        ulong c = o << 1;\n     \
   ulong d = o >> 1;\n        o = (a | b | c | d | o) ^ (a ^ b ^ c ^ d ^ o);\n\
\n        o = o >> ctz(o);\n        accum = accum ^ o;\n        minim = \
min(minim, o);\n        collected = collected | o;\n    }\n\n    if (o == 0 \
|| minim < oOrig) {return;}\n\n    int gap_pos = \
pos_gap_length_greater_than_four(collected);\n    if (accum == 0 && gap_pos \
== 64) {\n        ulong idx = atomic_inc(match_count);\n        if (idx < \
max_matches) {\n            matches[idx] = oOrig;\n        }\n        return;\
\n    }\n\n    if ((o & TOPMOSTBITSMASK) == 0 && gap_pos == 64) {\n        // \
last run was unfinished\n\n        count = 0;\n        accum = o;\n        \
collected = o;\n        while (minim >= oOrig && count < STEPS3 && o != 0 && \
accum != 0 && (o & TOPMOSTBITSMASK) == 0) {\n            count++;\n\n         \
   ulong a = o << 3;\n            ulong b = o << 2;\n            ulong c = o \
<< 1;\n            ulong d = o >> 1;\n            o = (a | b | c | d | o) ^ \
(a ^ b ^ c ^ d ^ o);\n\n            o = o >> ctz(o);\n            accum = \
accum ^ o;\n            minim = min(minim, o);\n            collected = \
collected | o;\n        }\n\n        if (o == 0 || minim < oOrig) {return;}\n\
\n        gap_pos = pos_gap_length_greater_than_four(collected);\n        if \
(accum == 0 && gap_pos == 64) {\n            ulong idx = \
atomic_inc(match_count);\n            if (idx < max_matches) {\n              \
  matches[idx] = oOrig;\n            }\n            return;\n        }\n    }\
\n\n    // 128-bit faffing about\n    gap_pos = \
pos_gap_length_greater_than_four(collected);\n\n    if (gap_pos == 64) {\n    \
    ulong idx = atomic_inc(match_count);\n        if (idx < max_matches) {\n  \
          matches[idx] = oOrig;\n        }\n        return;\n    }\n\n    // \
Split Solution\n    ulong o1 = o & (~0UL >> (64 - gap_pos));\n    ulong o2 = \
o >> gap_pos;\n\n    o1 = o1 >> ctz(o1);\n    count = 0;\n    accum = o1;\n   \
 minim = o1;\n    while (minim >= oOrig && count < STEPS4 && o1 != 0 && accum \
!= 0 && (o1 & TOPMOSTBITSMASK) == 0) {\n        count++;\n\n        ulong a = \
o1 << 3;\n        ulong b = o1 << 2;\n        ulong c = o1 << 1;\n        \
ulong d = o1 >> 1;\n        o1 = (a | b | c | d | o1) ^ (a ^ b ^ c ^ d ^ o1);\
\n\n        o1 = o1 >> ctz(o1);\n        accum = accum ^ o1;\n        minim = \
min(minim, o1);\n    }\n\n    if (o1 != 0 && minim >= oOrig) {\n        ulong \
idx = atomic_inc(match_count);\n        if (idx < max_matches) {\n            \
matches[idx] = oOrig;\n        }\n    }\n\n    o2 = o2 >> ctz(o2);\n    count \
= 0;\n    accum = o2;\n    minim = o2;\n    while (minim >= oOrig && count < \
STEPS4 && o2 != 0 && accum != 0 && (o2 & TOPMOSTBITSMASK) == 0) {\n        \
count++;\n\n        ulong a = o2 << 3;\n        ulong b = o2 << 2;\n        \
ulong c = o2 << 1;\n        ulong d = o2 >> 1;\n        o2 = (a | b | c | d | \
o2) ^ (a ^ b ^ c ^ d ^ o2);\n\n        o2 = o2 >> ctz(o2);\n        accum = \
accum ^ o2;\n        minim = min(minim, o2);\n    }\n\n    if (o2 != 0 && \
minim >= oOrig) {\n        ulong idx = atomic_inc(match_count);\n        if \
(idx < max_matches) {\n            matches[idx] = oOrig;\n        }\n    }\n\n\
    return;\n}\>\"", ",", " ", "\"\<search_matches\>\"", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "_Integer", "}"}], ",", "_Integer", ",", " ", "_Integer"}],
      "}"}], ",", "256", ",", " ", 
    RowBox[{"\"\<ShellOutputFunction\>\"", "->", "Print"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9907895320686617`*^9, 3.990789572246459*^9}, {
   3.990789615785981*^9, 3.990789617554699*^9}, 3.990790476676757*^9, {
   3.990791593947577*^9, 
   3.9907916110873003`*^9}},ExpressionUUID->"3d3a26da-1ad5-48eb-aeb3-\
2a5ec422fd1c"],

Cell[BoxData[
 RowBox[{"OpenCLFunctionInformation", "[", "filter51", "]"}]], "Input",
 CellChangeTimes->{{3.990789827847983*^9, 
  3.990789830187716*^9}},ExpressionUUID->"e44a63ca-28ce-4daa-a62c-\
f63b70511aaf"],

