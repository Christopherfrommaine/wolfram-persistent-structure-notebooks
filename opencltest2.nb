      RowBox[{"{", "_Integer", "}"}], ",", 
      RowBox[{"{", "_Integer", "}"}], ",", "_Integer", ",", "_Integer"}], 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}]], "Input",
