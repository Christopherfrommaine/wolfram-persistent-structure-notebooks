 RowBox[{
  RowBox[{"max", "=", "100000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxMatches", "=", 
   RowBox[{"Round", "[", 
    RowBox[{"0.001", " ", "*", " ", "max"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"output", "=", 
  RowBox[{"ConstantArray", "[", 
   RowBox[{"0", ",", " ", "maxMatches"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"matchCount", "=", "0"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"res", "=", 
    RowBox[{"filter51", "[", 
     RowBox[{"output", ",", " ", "matchCount", ",", " ", "maxMatches"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"matchCount", " ", ">", " ", "maxMatches"}], ",", " ", 
   RowBox[{"Print", "[", "\"\<OUTPUT BUFFER NOT BIG ENOUGH\>\"", "]"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.990789701288006*^9, 3.990789771705165*^9}, {
  3.9907898832503777`*^9, 3.990789886000318*^9}, {3.9907899568120193`*^9, 
  3.990790002961885*^9}},ExpressionUUID->"e493e450-98c9-4731-a9eb-\
761d0d6230e0"],

